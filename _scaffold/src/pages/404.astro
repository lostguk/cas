---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Страница не найдена — 404"
  description="Запрашиваемая страница не найдена. Вернитесь на главную."
  noindex={true}
>
  <section class="py-20 lg:py-32">
    <div class="max-w-lg mx-auto px-4 sm:px-6 text-center">
      <div class="text-8xl font-extrabold text-{{COLOR_ACCENT}}-400/20 mb-4">404</div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white mb-4">Страница не найдена</h1>
      <p class="text-slate-400 mb-8">
        К сожалению, запрашиваемая страница не существует или была перемещена.
      </p>
      <a href="/" class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-gradient-to-r from-{{COLOR_ACCENT}}-500 to-{{COLOR_ACCENT}}-600 text-white font-semibold rounded-xl transition-all duration-300">
        Вернуться на главную
      </a>
    </div>
  </section>
</BaseLayout>
