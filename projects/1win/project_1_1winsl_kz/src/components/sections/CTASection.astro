---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = '#';
---

<section class="py-12 lg:py-16">
  <div class="max-w-2xl mx-auto px-4 sm:px-6">
    <div class="text-center p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-violet-50 to-rose-50 border border-violet-100">
      <h2 class="text-xl sm:text-2xl font-heading font-bold text-cream-900 mb-3">Готовы начать?</h2>
      <p class="text-cream-600 mb-6">1Win ждёт — проверьте сами, подходит ли вам эта площадка.</p>
      <CTAButton href={affiliateLink} size="lg" external>Не откладывайте</CTAButton>
    </div>
  </div>
</section>
