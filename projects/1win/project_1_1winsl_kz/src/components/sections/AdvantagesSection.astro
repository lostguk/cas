---
import SectionHeading from '../ui/SectionHeading.astro';

const cards = [
  {
    title: 'Линия и коэффициенты',
    plus: '35+ видов спорта, маржа 3-5%',
    minus: 'На КПЛ роспись беднее, чем на АПЛ',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><circle cx="12" cy="12" r="10"/><path d="m8 12 3 3 5-5"/></svg>',
  },
  {
    title: 'Оплата в тенге',
    plus: 'Kaspi, Halyk, Jusan — без конвертации',
    minus: 'Kaspi иногда отклоняет платежи',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/></svg>',
  },
  {
    title: 'Мобильное приложение',
    plus: 'APK ~40 МБ, работает стабильно',
    minus: 'Нет в Google Play, обновлять вручную',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><rect x="7" y="2" width="10" height="20" rx="2"/><path d="M12 18h.01"/></svg>',
  },
  {
    title: 'Казино и слоты',
    plus: '12 000+ игр, Pragmatic Play, Spribe, 1Win Games',
    minus: 'Вейджер ×50 — жёстко',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>',
  },
  {
    title: 'Бонусы',
    plus: 'До 500% + 70 фриспинов',
    minus: 'Условия отыгрыша непростые',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>',
  },
  {
    title: 'Поддержка',
    plus: 'Чат 24/7 на русском',
    minus: 'Отвечают шаблонно, нужно настаивать',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  },
];
---

<section class="py-12 lg:py-16 bg-cream-100/50">
  <div class="max-w-2xl mx-auto px-4 sm:px-6">
    <SectionHeading>Честная оценка: плюсы и минусы</SectionHeading>

    <div class="space-y-4">
      {cards.map((card) => (
        <div class="bg-white rounded-lg p-5 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-10 rounded-full bg-violet-50 text-violet-500 flex items-center justify-center shrink-0">
              <Fragment set:html={card.icon} />
            </span>
            <h3 class="font-semibold text-cream-900">{card.title}</h3>
          </div>
          <p class="text-sm text-green-700 mb-1">+ {card.plus}</p>
          <p class="text-sm text-red-600">− {card.minus}</p>
        </div>
      ))}
    </div>
  </div>
</section>
