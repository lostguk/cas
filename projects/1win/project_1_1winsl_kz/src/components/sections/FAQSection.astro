---
import SectionHeading from '../ui/SectionHeading.astro';

const faqs = [
  {
    q: 'Что делать если не приходит SMS при регистрации?',
    a: 'У меня такое было с Beeline KZ — SMS пришло только минут через 10. Попробуй запросить повторно, а если не помогает — регистрируйся через email или соцсети. Кстати через тг тоже можно.',
  },
  {
    q: 'Сколько реально ждать вывод на Kaspi?',
    a: 'По моему опыту — от 2 часов до суток. Один раз было 4 часа ровно, другой раз ждал до следующего утра. Может от суммы зависит, точно не скажу. На крипту быстрее.',
  },
  {
    q: 'Безопасно ли скачивать APK?',
    a: 'Если качаешь с официального сайта через зеркало — да, нормально. Просто не качай с левых сайтов и форумов. У меня стоит уже полгода, никаких проблем.',
  },
  {
    q: 'Блокирует ли Kcell сайт?',
    a: 'Да, Kcell и Beeline периодически блочат. Кто пользовался Kcell — тот поймёт. Через приложение заходишь без проблем, или через зеркало. VPN тоже вариант, но с прилжением проще.',
  },
  {
    q: 'Есть ли бонус за установку приложения?',
    a: 'Отдельного бонуса нет, но привитственный пакет работает и через апк. То есть регистрируешься в приложении, пополняешь — и получаешь те же до 500%.',
  },
  {
    q: 'Можно ли ставить с двух устройств одновременно?',
    a: 'Можно, аккаунт один — заходи откуда хочешь. Я с телефона и ноутбука одновременно сижу, проблем нет.',
  },
  {
    q: 'Можно ли установить лимит на ставки?',
    a: 'Да, в ЛК есть настройки ответственной игры. Можно поставить дневной, недельный или месячный лимит. Я себе поставил — ну чтобы не увлекаться (да, я проверял).',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="py-12 lg:py-16 bg-cream-100/50">
  <div class="max-w-2xl mx-auto px-4 sm:px-6">
    <SectionHeading>FAQ — отвечаю на вопросы</SectionHeading>

    <div class="space-y-3">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-lg shadow-sm">
          <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-cream-900 font-medium">
            <span>{faq.q}</span>
            <svg class="w-5 h-5 text-cream-400 shrink-0 ml-3 group-open:rotate-180 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="px-5 pb-4 text-sm text-cream-600 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
