---
interface Props {
  publishDate: string;
  updateDate: string;
}

const { publishDate, updateDate } = Astro.props;

const months = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
];

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
};
---

<div class="flex flex-wrap items-center gap-3 text-sm text-cream-400 border-b border-cream-200 pb-6 mb-8 max-w-2xl mx-auto px-4 sm:px-6">
  <span
    class="w-9 h-9 rounded-full bg-violet-100 flex items-center justify-center text-violet-600 font-bold text-xs shrink-0"
    aria-hidden="true"
  >
    СК
  </span>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <a href="/about" class="text-violet-600 hover:text-violet-700 font-medium transition-colors">Серик Калиев</a>
    <span class="text-cream-300">·</span>
    <time datetime={publishDate}>{formatDate(publishDate)}</time>
    <span class="text-cream-300">·</span>
    <time datetime={updateDate}>обн. {formatDate(updateDate)}</time>
  </div>
</div>
