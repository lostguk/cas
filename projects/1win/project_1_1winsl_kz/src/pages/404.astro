---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/ui/CTAButton.astro';
---

<BaseLayout
  title="Страница не найдена"
  description="404 — такой страницы нет на 1winsl.kz."
  noindex={true}
>
  <section class="py-20 px-4 text-center">
    <p class="text-6xl font-heading font-bold text-violet-300 mb-4">404</p>
    <h1 class="text-2xl font-heading font-bold text-cream-900 mb-3">Такой страницы нет</h1>
    <p class="text-cream-500 max-w-md mx-auto mb-8">
      Проверь ссылку или вернись на главную — там всё на месте.
    </p>
    <CTAButton href="/" size="lg">На главную</CTAButton>
  </section>
</BaseLayout>
