---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';

const affiliateLink = '#';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как зарегистрироваться на 1Win',
  step: [
    { '@type': 'HowToStep', position: 1, name: 'Открыть сайт', text: 'Зайти на 1Win через рабочее зеркало или приложение' },
    { '@type': 'HowToStep', position: 2, name: 'Выбрать способ', text: 'По телефону, email или через соцсеть' },
    { '@type': 'HowToStep', position: 3, name: 'Заполнить данные', text: 'Ввести данные, выбрать валюту RUB' },
    { '@type': 'HowToStep', position: 4, name: 'Подтвердить', text: 'Ввести код из SMS или подтвердить email' },
  ],
};

const methods = [
  { title: 'По телефону', text: 'Номер + SMS-код. Самый быстрый способ — 30 секунд.' },
  { title: 'По email', text: 'Почта + пароль. Подтверждение по ссылке в письме.' },
  { title: 'Через соцсети', text: 'ВК, Telegram, Google. Один клик и ты в системе.' },
  { title: 'В один клик', text: 'Без данных — система генерирует логин и пароль. Сохрани их.' },
];
---

<BaseLayout
  title="Регистрация 1Win: 4 способа + бонус на первый депозит"
  description="Регистрация 1Win за 2 минуты — пошагово. Аккаунт в рублях, бонус на старте, верификация через СНИЛС."
  schema={schema}
  publishDate="2026-02-10"
  updateDate="2026-04-02"
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Регистрация' }]} />
  <ArticleMeta publishDate="2026-02-10" updateDate="2026-04-02" />

  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white uppercase tracking-tight mb-4">Как зарегистрироваться на 1Win</h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto">Четыре способа создать аккаунт. Счёт в рублях, бонус до 500% на первые четыре депозита.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <CTAButton href={affiliateLink} size="lg" external>Зарегистрироваться с бонусом</CTAButton>
        </div>
      </div>

      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-white uppercase tracking-wide mb-4">Пошаговая регистрация</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {[
              { num: '1', title: 'Откройте сайт', text: 'Через зеркало или приложение — основной домен может блокироваться МТС и Мегафоном.' },
              { num: '2', title: 'Нажмите «Регистрация»', text: 'Кнопка в правом верхнем углу. Выберите способ: телефон, email, соцсеть или один клик.' },
              { num: '3', title: 'Заполните форму', text: 'Укажите данные и обязательно выберите рубли (RUB) как валюту счёта.' },
              { num: '4', title: 'Подтвердите', text: 'SMS-код или ссылка на почту. Если SMS не пришло — перезапросите через минуту.' },
            ].map((s) => (
              <Card>
                <div class="text-3xl font-extrabold text-coral-400/20 mb-1">{s.num}</div>
                <h3 class="font-bold text-white uppercase mb-1">{s.title}</h3>
                <p class="text-sm text-slate-400">{s.text}</p>
              </Card>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-white uppercase tracking-wide mb-4">Способы регистрации</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {methods.map((m) => (
              <Card>
                <h3 class="font-bold text-white uppercase mb-1">{m.title}</h3>
                <p class="text-sm text-slate-400">{m.text}</p>
              </Card>
            ))}
          </div>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-white uppercase tracking-wide mb-3">Бонус при регистрации</h2>
          <p class="text-slate-300">Новым игрокам — до 500% на первые четыре депозита. Подробности и условия отыгрыша — на <a href="/podarki" class="text-coral-400 hover:underline">странице бонусов</a>. Минимальный депозит 100 ₽ через Сбербанк или Тинькофф.</p>
        </div>

        <div>
          <h2 class="text-2xl font-bold text-white uppercase tracking-wide mb-3">Верификация</h2>
          <p class="text-slate-300">Для вывода крупных сумм попросят СНИЛС + паспорт + селфи. Обычно проверка занимает пару дней, иногда быстрее. Без верифкации мелкие суммы можно выводить свободно.</p>
          <p class="text-slate-400 text-sm mt-2">Кстати на <a href="/about" class="text-coral-400 hover:underline">странице о проекте</a> мы рассказываем как именно тестируем платформу.</p>
        </div>
      </div>

      <div class="mt-16 text-center p-8 rounded-lg bg-gradient-to-br from-coral-500/10 via-abyss-800 to-teal-500/5 border border-coral-500/10">
        <h2 class="text-xl font-bold text-white uppercase mb-3">Готовы начать?</h2>
        <p class="text-slate-300 mb-6">Регистрация занимает меньше двух минут.</p>
        <CTAButton href={affiliateLink} size="lg" external>Открыть аккаунт за 2 минуты</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
