---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'bg-abyss-800 border-l-4 border-coral-500 rounded-lg p-5 lg:p-6',
    hover && 'hover:scale-[1.02] hover:shadow-xl transition-transform duration-200',
    className,
  ]}
>
  <slot />
</div>
