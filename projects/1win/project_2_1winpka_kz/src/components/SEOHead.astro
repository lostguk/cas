---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schema?: object;
}

const siteUrl = 'https://1winpka.kz';
const siteName = '1winpka.kz';

const {
  title,
  description,
  canonical,
  ogImage = '/favicon.svg',
  noindex = false,
  type = 'website',
  schema,
} = Astro.props;

const canonicalUrl = canonical ?? Astro.url.href;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const schemaArray = schema
  ? Array.isArray(schema)
    ? schema
    : [schema]
  : [];

const schemaJson = schemaArray.length ? JSON.stringify(schemaArray.length === 1 ? schemaArray[0] : schemaArray) : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#1a0533" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
)}
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={new URL(ogImage, siteUrl).href} />
<meta property="og:locale" content="ru_KZ" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(ogImage, siteUrl).href} />
<meta name="geo.region" content="KZ" />
<meta name="geo.placename" content="Kazakhstan" />
<meta http-equiv="content-language" content="ru" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
  />
</noscript>
{schemaJson && (
  <script type="application/ld+json" set:html={schemaJson} />
)}
