---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = '#';
const stats = [
  { value: '35+', label: 'видов спорта' },
  { value: '500 ₸', label: 'мин. депозит' },
  { value: '100%', label: 'на первый депозит' },
];
---

<section class="relative overflow-hidden py-16 sm:py-20 lg:py-28">
  <div class="absolute inset-0 bg-gradient-to-br from-void-800 via-void-950 to-void-900"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_70%_50%,var(--color-glow-500)_0%,transparent_60%)] opacity-[0.08]"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-glow-500/10 border border-glow-500/20 text-glow-400 text-sm font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-glow-400 animate-pulse"></span>
          600+ live-событий
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white leading-[1.1] mb-6">
          1Win Казахстан — казино + ставки для игроков из KZ
        </h1>
        <p class="text-lg text-slate-300 mb-8 max-w-xl">Аналитический обзор платформы 1Win: 35+ видов спорта, 12 000+ игр, счёт в тенге. Рейтинги, сравнение условий и факты.</p>
        <div class="flex flex-col sm:flex-row gap-4">
          <CTAButton href={affiliateLink} size="lg" external>Получить фрибет на первый депозит</CTAButton>
          <CTAButton href="/dostup" variant="secondary" size="lg">Ставить на КПЛ</CTAButton>
        </div>
      </div>
      <div class="hidden lg:block">
        <div class="relative">
          <div class="w-full aspect-square rounded-3xl bg-gradient-to-br from-glow-500/10 via-void-800 to-flash-500/10 border border-white/5 flex items-center justify-center">
            <div class="grid grid-cols-1 gap-5 w-full max-w-xs">
              {stats.map((s) => (
                <div class="bg-white/[0.04] rounded-xl p-4 border border-white/[0.06] text-center backdrop-blur-sm">
                  <div class="text-2xl font-bold text-glow-400">{s.value}</div>
                  <div class="text-sm text-slate-400 mt-1">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
          <div class="absolute -top-4 -right-4 w-24 h-24 bg-glow-500/10 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-flash-500/10 rounded-full blur-2xl"></div>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-3 gap-6 mt-14 pt-10 border-t border-white/5 lg:hidden">
      {stats.map((s) => (
        <div class="text-center">
          <div class="text-xl font-bold text-glow-400">{s.value}</div>
          <div class="text-xs text-slate-400 mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
