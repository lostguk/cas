---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const sports = [
  {
    title: 'Футбол',
    text: 'КПЛ — до 120 рынков на матчи «Астана» — «Кайрат». АПЛ и Ла Лига — маржа 3-4%.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01z"/></svg>',
  },
  {
    title: 'Киберспорт',
    text: 'Dota 2, CS2, Valorant — линия на уровне. Матчи The International закрыты на 150+ рынков.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875S10.5 3.089 10.5 4.125c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .369-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.96.401v0a.656.656 0 0 0 .658-.663 48.422 48.422 0 0 0-.37-5.36c-1.886.342-3.81.574-5.766.689a.578.578 0 0 1-.61-.58v0Z"/></svg>',
  },
  {
    title: 'Теннис',
    text: 'ATP, WTA, ITF — прематч и лайв. По геймам и сетам роспись есть, маржа 4-5%.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20"/><path d="M12 2a14.5 14.5 0 0 1 0 20"/><path d="M2 12h20"/></svg>',
  },
  {
    title: 'Баскетбол',
    text: 'НБА, Евролига + локальные чемпионаты. Тоталы, форы, четверти — всё на месте.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14"/><path d="M19.07 4.93L4.93 19.07"/></svg>',
  },
];
---

<section class="relative py-16 lg:py-20 overflow-hidden bg-void-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Ставки на спорт: что есть на 1Win</SectionHeading>

    <p class="text-slate-300 text-center max-w-2xl mx-auto mb-10">По данным платформы — 600+ live-событий ежедневно. Маржа на топ-события колеблется от 3% до 5%, что находится на среднерыночном уровне для букемкеров KZ-сегмента.</p>

    <div class="grid sm:grid-cols-2 gap-6">
      {sports.map((sport) => (
        <Card>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-xl bg-glow-500/10 flex items-center justify-center text-glow-400 shrink-0">
              <div class="w-6 h-6" set:html={sport.icon} />
            </div>
            <div>
              <h3 class="font-semibold text-white mb-1">{sport.title}</h3>
              <p class="text-sm text-slate-300">{sport.text}</p>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </div>
</section>
