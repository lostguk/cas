---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/ui/CTAButton.astro';
---

<BaseLayout
  title="404 — страница не найдена"
  description="Запрашиваемая страница не существует."
  noindex={true}
>
  <section class="py-20 lg:py-32">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="text-8xl font-extrabold text-glow-500/20 mb-6">404</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">Страница не найдена</h1>
      <p class="text-lg text-slate-400 mb-8">Возможно, страница была перемещена или удалена.</p>
      <CTAButton href="/" variant="primary" size="lg">Вернуться на главную</CTAButton>
    </div>
  </section>
</BaseLayout>
