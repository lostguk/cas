---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import OverviewSection from '../components/sections/OverviewSection.astro';
import AdvantagesSection from '../components/sections/AdvantagesSection.astro';
import SportsSection from '../components/sections/SportsSection.astro';
import SlotsSection from '../components/sections/SlotsSection.astro';
import BonusSection from '../components/sections/BonusSection.astro';
import PaymentsSection from '../components/sections/PaymentsSection.astro';
import LiveSection from '../components/sections/LiveSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';

const siteUrl = 'https://1winpka.kz';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '1winpka.kz',
  url: siteUrl,
  description: 'Аналитический обзор платформы 1Win для игроков из Казахстана.',
  inLanguage: 'ru-KZ',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="1Win Казахстан — ставки на спорт и казино КЗ 2026"
  description="Обзор 1Win для Казахстан: ставки на КПЛ, казино, бонус до 220 000 ₸. Пополнение через Kaspi в тенге."
  schema={websiteSchema}
>
  <HeroSection />
  <OverviewSection />
  <AdvantagesSection />
  <SportsSection />
  <SlotsSection />
  <BonusSection />
  <PaymentsSection />
  <LiveSection />
  <FAQSection />
  <CTASection />
</BaseLayout>
