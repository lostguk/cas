---
import SectionHeading from '../ui/SectionHeading.astro';

const faq = [
  {
    q: 'Как зарегистрироваться через Telegram?',
    a: 'Mostbet поддерживает авторизацию через Telegram: достаточно привязать аккаунт в настройках профиля. Процесс занимает пару минут — бот запрашивает подтверждение и привязывает номер.',
  },
  {
    q: 'Почему отклонили вывод на карту?',
    a: 'Основные причины — незавершённая верификация, несовпадение имени владельца карты и аккаунта, или невыполненные условия отыгрыша бонуса. Проверяйте статус KYC в личном кабинете и обращайтесь в поддержку с указанием номера транзакции.',
  },
  {
    q: 'Нужен ли VPN для приложения?',
    a: 'Зависит от вашего провайдера и текущих ограничений. Приложение работает через собственные серверы, но в некоторых сетях может потребоваться VPN. Мы рекомендуем проверять доступность перед крупными ставками.',
  },
  {
    q: 'Сохраняется ли баланс при входе через зеркало?',
    a: 'Да, баланс и история ставок привязаны к аккаунту, а не к домену. При входе через зеркало все данные сохраняются. Проверяйте подлинность зеркала — HTTPS и совпадение интерфейса после авторизации.',
  },
  {
    q: 'Есть ли фрибет без депозита?',
    a: 'Периодически Mostbet проводит акции с фрибетами для новых клиентов. Условия меняются — актуальные предложения проверяйте в разделе «Акции» личного кабинета или на нашей странице бонусов.',
  },
  {
    q: 'Что такое Cash Out и как им пользоваться?',
    a: 'Cash Out позволяет досрочно рассчитать ставку до окончания события. Сумма выплаты зависит от текущих коэффициентов. Кнопка появляется в купоне, если функция доступна для данного события.',
  },
  {
    q: 'Есть ли демо-режим без регистрации?',
    a: 'Часть слотов доступна в демо-режиме без авторизации — зависит от провайдера и региона. Для live-казино и ставок на спорт требуется регистрация и пополнение счёта.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>❓ Вопросы о Mostbet</SectionHeading>
    <div class="max-w-3xl mx-auto space-y-3">
      {
        faq.map((item) => (
          <details class="group rounded-lg border border-deep-600 bg-deep-700/50 open:border-main-500/30 open:shadow-lg open:shadow-main-500/5 transition-all">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-semibold text-white">
              <span>{item.q}</span>
              <svg
                class="w-5 h-5 shrink-0 text-main-500 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-slate-400 leading-relaxed border-t border-deep-600 pt-3">{item.a}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
