---
import Card from '../ui/Card.astro'
import SectionHeading from '../ui/SectionHeading.astro'

const cards = [
  {
    title: 'Футбол',
    text: 'РПЛ — до 150 рынков на топ-матчи Зенита, Спартака и ЦСКА. Маржа 3–5% на ведущие лиги, live-ставки с потоковым видео.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>',
  },
  {
    title: 'Баскетбол',
    text: 'НБА, Евролига и Единая лига ВТБ. Широкая роспись на тоталы и форы, коэффициенты обновляются в режиме реального времени.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M4.93 4.93l14.14 14.14M12 2v20M2 12h20"/></svg>',
  },
  {
    title: 'Киберспорт',
    text: 'CS2, Dota 2, League of Legends — более 200 событий ежедневно. Коэффициенты реагируют быстро на изменения патчей и метагейма.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
  },
  {
    title: 'Теннис',
    text: 'ATP, WTA и турниры Grand Slam. Ставки на каждый гейм, сет и общий исход. Маржа на топ-матчи — от 4%.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M18 4a12 12 0 0 0-12 16"/><path d="M6 4a12 12 0 0 0 12 16"/></svg>',
  },
];
---

<section class="py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center mb-14">
      <div>
        <SectionHeading align="left">⚽ Ставки на спорт</SectionHeading>
        <p class="text-slate-300 leading-relaxed">
          Мы предлагаем 40+ видов спорта с широкой росписью. Маржа 3–5% на топ-события, более 800 live-матчей ежедневно. Вывод выигрыша на Сбербанк, Тинькофф и другие российские банки.
        </p>
      </div>
      <div class="overflow-hidden rounded-lg">
        <img
          src="/images/sport.jpg"
          alt="Спортивная линия Mostbet"
          width="1200"
          height="676"
          loading="lazy"
          decoding="async"
          class="w-full h-auto aspect-video object-cover"
        />
      </div>
    </div>
    <div class="grid sm:grid-cols-2 gap-6">
      {
        cards.map((c) => (
          <Card>
            <div class="w-12 h-12 rounded-lg bg-main-500/15 text-main-400 flex items-center justify-center mb-4" set:html={c.icon} />
            <h3 class="text-lg font-bold text-white mb-2">{c.title}</h3>
            <p class="text-sm text-slate-400 leading-relaxed">{c.text}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
