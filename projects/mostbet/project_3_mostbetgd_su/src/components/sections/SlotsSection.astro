---
import Card from '../ui/Card.astro'
import CTAButton from '../ui/CTAButton.astro'
import SectionHeading from '../ui/SectionHeading.astro'

const affiliateLink = '#';

const slots = [
  {
    href: '/big-bass-splash',
    provider: 'Pragmatic Play',
    name: 'Big Bass Splash',
    rtp: '96.71%',
    win: '×2 100',
    image: '/images/bbs.jpg',
    desc: 'Рыболовная тематика с увлекательными бонусными раундами. Высокая волатильность обеспечивает динамичный геймплей и крупные выигрыши для терпеливых игроков.',
  },
  {
    href: '/reactoonz-2',
    provider: "Play'n GO",
    name: 'Reactoonz 2',
    rtp: '96.20%',
    win: '×5 083',
    image: '/images/reactoonz-2.jpg',
    desc: 'Каскадные механики на сетке 7×7 с забавными персонажами. Улучшенная версия оригинала: новые фичи, электрический Wild и максимальный потенциал до ×5 083.',
  },
  {
    href: '/slots-i-igry',
    provider: 'Разные',
    name: 'Каталог казино',
    rtp: 'зависит от слота',
    win: '—',
    image: '/images/catalog.jpg',
    desc: 'Более 8 000 игр от Pragmatic Play, NetEnt, Evolution и других провайдеров. Фильтрация по провайдеру, волатильности и RTP — для удобного выбора.',
  },
];
---

<section class="py-20 lg:py-28 relative">
  <div class="absolute inset-0 -skew-y-2 bg-deep-900/60 -z-10" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>🎰 Слоты Mostbet — наш выбор</SectionHeading>
    <p class="text-center text-slate-400 max-w-2xl mx-auto mb-12 -mt-4">
      RTP — долгосрочный ориентир провайдера. Мы подобрали слоты с лучшим балансом отдачи и динамики.
    </p>
    <div class="grid md:grid-cols-3 gap-8">
      {
        slots.map((s) => (
          <Card class="flex flex-col">
            <a href={s.href} class="block mb-4 overflow-hidden rounded-lg">
              <img
                src={s.image}
                alt={`Слот ${s.name}`}
                width="1200"
                height="750"
                loading="lazy"
                decoding="async"
                class="w-full h-auto aspect-[16/10] object-cover transition-transform duration-300 hover:scale-[1.03]"
              />
            </a>
            <p class="text-xs font-semibold text-main-400 uppercase tracking-wider mb-1">{s.provider}</p>
            <h3 class="text-xl font-bold text-white mb-2">{s.name}</h3>
            <p class="text-sm text-slate-400 leading-relaxed flex-1 mb-4">{s.desc}</p>
            <div class="flex flex-wrap gap-3 text-xs text-slate-500 mb-4">
              <span class="px-2 py-1 rounded-md bg-deep-800">RTP {s.rtp}</span>
              <span class="px-2 py-1 rounded-md bg-deep-800">Макс. {s.win}</span>
            </div>
            <CTAButton href={s.href} variant="outline" size="sm" class="w-full sm:w-auto">
              Подробнее
            </CTAButton>
          </Card>
        ))
      }
    </div>
    <div class="text-center mt-10">
      <CTAButton href={affiliateLink} size="lg" external>Открыть казино</CTAButton>
    </div>
  </div>
</section>
