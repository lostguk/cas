---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/ui/CTAButton.astro';
---

<BaseLayout
  title="Страница не найдена"
  description="Запрошенный адрес отсутствует на mostbetgd.su."
  canonical="https://mostbetgd.su/404"
  noindex={true}
>
  <section class="py-24 lg:py-32 text-center px-4">
    <p class="text-main-500 font-extrabold text-6xl mb-4">404</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white uppercase tracking-tight mb-4">Страница не найдена</h1>
    <p class="text-slate-400 max-w-md mx-auto mb-8">
      Проверьте адрес или вернитесь на главную. Структура сайта может обновляться.
    </p>
    <CTAButton href="/" size="lg">На главную</CTAButton>
  </section>
</BaseLayout>
