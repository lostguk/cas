---
import SectionHeading from '../ui/SectionHeading.astro';

const faq = [
  {
    q: 'Как восстановить забытый пароль?',
    a: 'Чтобы сбросить пароль, нажмите «Забыли пароль?» на странице входа. Система отправит код на привязанный телефон или email. После ввода кода нужно задать новый пароль. Если доступ к номеру утрачен — обратитесь в поддержку через чат.',
  },
  {
    q: 'Можно ли пополнить счёт через СБП?',
    a: 'Да, Система быстрых платежей поддерживается. Для пополнения выберите СБП в разделе кассы, укажите сумму от 100 ₽ и подтвердите перевод в приложении банка. Зачисление занимает от 1 до 5 минут.',
  },
  {
    q: 'Есть ли версия для iPhone?',
    a: 'Мобильная версия для iOS доступна через Safari — добавьте сайт на главный экран. Отдельное приложение периодически появляется в App Store, но его доступность зависит от региона. Веб-версия функционально не уступает нативному приложению.',
  },
  {
    q: 'Блокируют ли провайдеры доступ к Mostbet?',
    a: 'Некоторые российские провайдеры ограничивают доступ к букмекерским сайтам. В таком случае можно использовать актуальное зеркало, которое предоставляет служба поддержки, либо мобильное приложение — оно работает напрямую.',
  },
  {
    q: 'Какой вейджер на казино-бонус?',
    a: 'Для казино-бонуса вейджер составляет ×60. Это означает, что сумму бонуса нужно прокрутить 60 раз в слотах, прежде чем вывод станет доступен. Для спортивного бонуса вейджер — ×5 экспрессами с коэффициентом от 1.40.',
  },
  {
    q: 'Как работают live-ставки?',
    a: 'Live-ставки принимаются во время матча. Коэффициенты обновляются в реальном времени и зависят от хода игры. Чтобы сделать live-ставку, перейдите в раздел «Live» в линии, выберите событие и добавьте исход в купон.',
  },
  {
    q: 'Есть ли live-казино с дилерами?',
    a: 'Да, раздел live-казино включает столы с реальными дилерами от Evolution, Ezugi и других провайдеров. Доступны рулетка, блэкджек, баккара и игровые шоу. Минимальная ставка за столом зависит от конкретной игры.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="py-12 lg:py-16 bg-warm-100/50">
  <div class="max-w-2xl mx-auto px-4 sm:px-6">
    <SectionHeading>Частые вопросы</SectionHeading>
    <div class="space-y-6">
      {
        faq.map((item, i) => (
          <div class="border-b border-warm-200 pb-6 last:border-0">
            <h3 class="font-serif text-lg font-semibold text-warm-900 mb-2">
              <span class="text-accent-500 mr-2">{i + 1}.</span>{item.q}
            </h3>
            <p class="text-sm text-warm-500 leading-relaxed">{item.a}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
