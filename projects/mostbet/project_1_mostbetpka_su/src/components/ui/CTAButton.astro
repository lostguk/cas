---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center font-medium transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500';

const variants: Record<string, string> = {
  primary: 'bg-warm-800 text-white rounded-full hover:bg-warm-900',
  secondary: 'text-warm-600 underline underline-offset-4 hover:text-accent-600',
  outline: 'border border-warm-300 text-warm-700 rounded-full hover:border-warm-400 hover:text-warm-900',
};

const sizes: Record<string, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-3.5 text-base',
};

const cls = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

<a
  href={href}
  class={cls}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
</a>
