---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/ui/CTAButton.astro';

const title = 'Страница не найдена — 404';
const description = 'Запрашиваемая страница не найдена на mostbetdh.su.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="py-20 lg:py-32">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <div class="text-8xl font-extrabold text-emerald-500/20 mb-6">404</div>
      <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4">Страница не найдена</h1>
      <p class="text-slate-400 mb-8">
        Запрашиваемая страница не существует или была перемещена. Воспользуйтесь навигацией для перехода к нужному разделу.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <CTAButton href="/" size="lg">На главную</CTAButton>
        <CTAButton href="/about" variant="outline" size="lg">О портале</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
