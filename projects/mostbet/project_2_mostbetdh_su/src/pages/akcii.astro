---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';

const affiliateLink = '#';
const title = 'Mostbet Бонусы — приветственный пакет для РУ | 2026';
const description =
  'Бонусы Mostbet для Россия: до 32 500 ₽ на спорт, 150 фриспинов на казино. Условия отыгрыша.';
const canonical = 'https://mostbetdh.su/akcii';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'ru',
};

const bonuses = [
  { type: 'Спортивный бонус', value: '100% до 32 500 ₽', wager: '×5 на экспрессы', time: '30 дней', score: '3.8' },
  { type: 'Казино-бонус', value: '250 фриспинов', wager: '×60 на слоты', time: '72 часа', score: '3.5' },
  { type: 'Фрибет', value: 'Бесплатная ставка', wager: 'Однократно', time: 'По условиям', score: '4.0' },
  { type: 'Экспресс-бонус', value: '+40% к выигрышу', wager: 'От 4 событий', time: 'Постоянно', score: '4.2' },
  { type: 'Кешбэк', value: 'До 10%', wager: 'По обороту за неделю', time: 'Еженедельно', score: '3.9' },
];

const steps = [
  { n: '01', text: 'Зарегистрируйтесь и пополните счёт на минимальную сумму (от 100 ₽).' },
  { n: '02', text: 'Бонус зачислится автоматически — проверьте баланс в личном кабинете.' },
  { n: '03', text: 'Для спортивного бонуса: ставьте экспрессы от 3 событий, кэф каждого от 1.40.' },
  { n: '04', text: 'Для казино-бонуса: фриспины активируются в указанных слотах в течение 72 часов.' },
  { n: '05', text: 'Выполните условия вейджера в отведённый срок (30 дней спорт / 72 часа казино).' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  publishDate="2026-02-01"
  updateDate="2026-03-30"
  type="article"
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Акции' }]} />
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">
          Бонусы Mostbet — рейтинг предложений для РУ
        </h1>
        <p class="text-lg text-slate-400 max-w-2xl mx-auto">
          Сравнительный анализ бонусных программ: суммы, условия вейджера, сроки. Оценки на основе открытых данных.
        </p>
        <CTAButton href={affiliateLink} size="lg" variant="cta" external class="mt-8">Проверить акции</CTAButton>
      </div>

      <h2 class="text-2xl font-bold text-white mb-6">Сравнительная таблица бонусов</h2>
      <div class="overflow-x-auto rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm mb-14">
        <table class="min-w-full text-sm text-left">
          <thead class="border-b border-white/[0.06]">
            <tr>
              <th class="px-5 py-4 text-slate-300 font-semibold">Тип</th>
              <th class="px-5 py-4 text-slate-300 font-semibold">Сумма</th>
              <th class="px-5 py-4 text-slate-300 font-semibold">Вейджер</th>
              <th class="px-5 py-4 text-slate-300 font-semibold">Срок</th>
              <th class="px-5 py-4 text-secondary-400 font-semibold text-center">Оценка</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.04]">
            {
              bonuses.map((b) => (
                <tr class="hover:bg-white/[0.02] transition-colors">
                  <td class="px-5 py-3 text-white font-medium">{b.type}</td>
                  <td class="px-5 py-3 text-emerald-400">{b.value}</td>
                  <td class="px-5 py-3 text-slate-400">{b.wager}</td>
                  <td class="px-5 py-3 text-slate-400">{b.time}</td>
                  <td class="px-5 py-3 text-center">
                    <span class="text-secondary-400 font-bold">{b.score}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="text-2xl font-bold text-white mb-6">Как отыграть бонус: пошагово</h2>
      <div class="space-y-4 mb-14">
        {
          steps.map((s) => (
            <div class="flex gap-4 items-start rounded-xl bg-white/[0.03] border border-white/[0.06] p-4">
              <span class="text-lg font-extrabold text-emerald-500 shrink-0">{s.n}</span>
              <p class="text-slate-300">{s.text}</p>
            </div>
          ))
        }
      </div>

      <h2 class="text-2xl font-bold text-white mb-4">Другие акции</h2>
      <div class="text-slate-300 space-y-4 mb-10">
        <p>
          Экспресс-бонус +40% — при выигрыше экспресса от 4 событий. Кешбэк до 10% — еженедельный возврат по обороту. По данным сравнительного анализа, экспресс-бонус получает оценку 4.2/5 за прозрачность условий. Рекомендуем протестировать на слотах <a href="/sugar-rush" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2">Sugar Rush</a> и <a href="/fruit-party" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2">Fruit Party</a>.
        </p>
      </div>

      <h2 class="text-2xl font-bold text-white mb-4">Аналитическое заключение</h2>
      <div class="text-slate-300 space-y-4 mb-10">
        <p>
          По совокупности параметров, бонусная программа Mostbet оценивается на 3.8/5. Приветственный пакет привлекателен по сумме, но условия вейджера (×60 на казино) — выше средних по рынку. Для спортивных пользователей условия благоприятнее (×5). Подробнее о методологии — на странице <a href="/about" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2">о портале</a>. Информация о <a href="/onlajn-kazino" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2">казино</a> поможет выбрать слоты для отыгрыша.
        </p>
      </div>

      <div class="rounded-xl border border-emerald-500/20 bg-white/[0.02] p-4 text-sm text-slate-400 backdrop-blur-sm">
        <strong class="text-slate-200">По данным из открытых источников.</strong> Условия бонусов меняются. Сверяйте актуальные правила в аккаунте перед активацией.
      </div>
    </div>
  </section>
</BaseLayout>
