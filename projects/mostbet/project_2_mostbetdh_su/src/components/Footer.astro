          <span class="text-slate-700">·</span>
          <a href="/akcii" class="text-sm text-slate-500 hover:text-emerald-400 transition-colors">Акции</a>
          <span class="text-slate-700">·</span>
          <a href="/sugar-rush" class="text-sm text-slate-500 hover:text-emerald-400 transition-colors">Sugar Rush</a>
          <span class="text-slate-700">·</span>
          <a href="/fruit-party" class="text-sm text-slate-500 hover:text-emerald-400 transition-colors">Fruit Party</a>
