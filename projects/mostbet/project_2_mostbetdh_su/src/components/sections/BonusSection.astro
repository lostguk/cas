---
import SectionHeading from '../ui/SectionHeading.astro';
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = '#';

const bonuses = [
  {
    type: 'Спортивный бонус',
    value: '100% до 32 500 ₽',
    condition: 'Вейджер ×5 на экспрессы от 3 событий, кэф от 1.40, 30 дней',
    score: '3.8',
  },
  {
    type: 'Казино-бонус',
    value: '250 фриспинов',
    condition: 'Вейджер ×60, привязка к конкретным слотам, 72 часа на активацию',
    score: '3.5',
  },
  {
    type: 'Фрибет',
    value: 'Бесплатная ставка',
    condition: 'При выполнении условий первого депозита, однократное использование',
    score: '4.0',
  },
];
---

<section class="py-16 lg:py-20 bg-base-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Бонусная программа: рейтинг предложений</SectionHeading>
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      {
        bonuses.map((b) => (
          <div class="relative rounded-2xl p-6 bg-white/[0.03] border border-white/[0.06] backdrop-blur-sm before:absolute before:left-0 before:top-4 before:bottom-4 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-emerald-500 before:to-secondary-400">
            <div class="flex items-center justify-between mb-3">
              <span class="text-sm font-medium text-emerald-400">{b.type}</span>
              <span class="text-xs font-bold text-secondary-400 bg-secondary-400/10 px-2 py-1 rounded-full">{b.score}/5</span>
            </div>
            <div class="text-xl font-bold text-white mb-2">{b.value}</div>
            <p class="text-sm text-slate-400 leading-relaxed">{b.condition}</p>
          </div>
        ))
      }
    </div>
    <div class="rounded-xl border border-emerald-500/20 bg-white/[0.02] p-4 text-sm text-slate-400 mb-8 backdrop-blur-sm">
      <strong class="text-slate-200">Аналитическая справка.</strong> Условия отыгрыша сравнительно жёсткие. По данным рейтинга, <a href="/akcii" class="text-emerald-400 hover:text-emerald-300 underline underline-offset-2">подробный разбор условий</a> поможет оценить реальную выгоду.
    </div>
    <div class="text-center">
      <CTAButton href={affiliateLink} size="lg" variant="cta" external>Сравнить условия бонусов</CTAButton>
    </div>
  </div>
</section>
