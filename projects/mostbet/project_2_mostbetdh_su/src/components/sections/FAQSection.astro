---
import SectionHeading from '../ui/SectionHeading.astro';

const faq = [
  {
    n: '01',
    q: 'Как восстановить забытый пароль?',
    a: 'На странице входа нажмите «Забыли пароль» и укажите email или телефон. По данным поддержки, SMS приходит в течение 2 минут. Если код не поступил — проверьте спам-фильтр и корректность номера.',
  },
  {
    n: '02',
    q: 'Почему отклонили вывод на карту?',
    a: 'Согласно правилам оператора, наиболее частые причины: незавершённая верификация, несовпадение имени на карте и в аккаунте, активный бонус с невыполненным вейджером. Рекомендуется проверить статус в личном кабинете.',
  },
  {
    n: '03',
    q: 'Приложение тормозит — что делать?',
    a: 'По данным тестирования, основные шаги: очистить кэш приложения, проверить объём свободной памяти (минимум 500 МБ), обновить до последней версии APK. На устройствах с Android 7 и ниже возможны проблемы совместимости.',
  },
  {
    n: '04',
    q: 'Как настроить DNS на Android?',
    a: 'Настройки → Сеть → Частный DNS → ввести dns.google или 1dot1dot1dot1.cloudflare-dns.com. Перезагрузите устройство. Это один из способов доступа при ограничениях провайдера.',
  },
  {
    n: '05',
    q: 'Какой вейджер на казино-бонус?',
    a: 'По условиям действующей программы — ×60 для казино-бонуса и ×5 для спортивного. Срок отыгрыша — 30 дней. Исходя из сравнительного анализа, это выше среднего по рынку.',
  },
  {
    n: '06',
    q: 'Как ставить экспрессы?',
    a: 'В купоне выберите 3+ события, тип ставки переключите на «Экспресс». Минимальный кэф каждого события — 1.40 для отыгрыша бонуса. Система рассчитывает общий коэффициент автоматически.',
  },
  {
    n: '07',
    q: 'Что такое Aviator и как играть?',
    a: 'Aviator — краш-игра от Spribe с генератором случайных чисел. Множитель растёт от ×1, игрок выводит ставку до краша. По статистике провайдера, средний RTP 97%. Высокий риск — ставьте в рамках бюджета.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="py-16 lg:py-20 bg-base-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Частые вопросы: справочник</SectionHeading>
    <div class="max-w-3xl mx-auto space-y-4">
      {
        faq.map((item) => (
          <div class="rounded-2xl border border-white/[0.06] bg-white/[0.02] backdrop-blur-sm overflow-hidden">
            <div class="px-6 py-5">
              <div class="flex items-start gap-4">
                <span class="text-xl font-extrabold text-emerald-500/40 shrink-0">{item.n}</span>
                <div>
                  <h3 class="text-white font-semibold mb-2">{item.q}</h3>
                  <p class="text-sm text-slate-400 leading-relaxed">{item.a}</p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
