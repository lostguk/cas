---
interface Props {
  tag?: 'h2' | 'h3';
  align?: 'left' | 'center';
  class?: string;
}

const { tag: Tag = 'h2', align = 'center', class: className = '' } = Astro.props;
---

<div class:list={['mb-10', align === 'center' && 'text-center', className]}>
  <Tag
    class:list={[
      'text-2xl sm:text-3xl lg:text-4xl font-bold text-white leading-tight',
      align === 'center' && 'mx-auto max-w-3xl',
    ]}
  >
    <slot />
  </Tag>
  <div
    class:list={[
      'mt-3 text-slate-400 max-w-2xl text-base sm:text-lg',
      align === 'center' && 'mx-auto',
      align === 'left' && 'max-w-3xl',
    ]}
  >
    <slot name="subtitle" />
  </div>
</div>
