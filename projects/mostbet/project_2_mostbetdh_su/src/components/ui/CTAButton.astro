---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'cta';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props;

const base =
  'inline-flex items-center justify-center font-semibold rounded-xl transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500';

const variants: Record<string, string> = {
  primary:
    'bg-gradient-to-r from-emerald-500 to-emerald-600 text-white shadow-lg shadow-emerald-500/25 hover:from-emerald-600 hover:to-emerald-700 hover:shadow-emerald-500/40',
  secondary:
    'bg-white/[0.06] text-slate-200 border border-white/[0.1] hover:bg-white/[0.1] backdrop-blur-sm',
  outline:
    'border-2 border-emerald-500/50 text-emerald-400 bg-transparent hover:bg-emerald-500/10 hover:border-emerald-500/70',
  cta:
    'bg-gradient-to-r from-emerald-500 to-yellow-500 text-white shadow-lg shadow-emerald-500/30 hover:from-emerald-600 hover:to-yellow-600 hover:shadow-emerald-500/50',
};

const sizes: Record<string, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm sm:text-base',
  lg: 'px-8 py-4 text-base',
};

const cls = [base, variants[variant], sizes[size], className].filter(Boolean).join(' ');
---

<a
  href={href}
  class={cls}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <slot />
</a>
