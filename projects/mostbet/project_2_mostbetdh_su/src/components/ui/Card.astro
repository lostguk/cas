---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'relative rounded-2xl p-6 lg:p-8 bg-white/[0.03] border border-white/[0.06] backdrop-blur-sm',
    'before:absolute before:left-0 before:top-4 before:bottom-4 before:w-[3px] before:rounded-full before:bg-gradient-to-b before:from-emerald-500 before:to-emerald-700',
    hover && 'hover:bg-white/[0.05] hover:border-emerald-500/20 transition-all duration-300',
    className,
  ]}
>
  <slot />
</div>
