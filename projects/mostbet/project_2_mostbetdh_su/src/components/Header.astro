---
import CTAButton from './ui/CTAButton.astro';

const affiliateLink = '#';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/sozdat-akkaunt', label: 'Регистрация' },
  { href: '/prilozhenie', label: 'Приложение' },
  { href: '/onlajn-kazino', label: 'Казино' },
  { href: '/akcii', label: 'Акции' },
  { href: '/about', label: 'О портале' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-base-950/80 backdrop-blur-xl border-b border-white/[0.06]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16 2L4 16l6 0-3 14 21-18H17l3-12z" fill="#10b981" opacity="0.15"/>
          <path d="M16 4L6 16h5l-2 12 17-14H16l2-10z" stroke="#10b981" stroke-width="1.5" stroke-linejoin="round" fill="none"/>
        </svg>
        <span class="font-bold text-white text-lg tracking-tight">Most<span class="text-emerald-400">bet</span></span>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Основное меню">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-emerald-400 bg-emerald-500/10'
                  : 'text-slate-400 hover:text-white hover:bg-white/[0.05]',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <CTAButton href={affiliateLink} size="sm" external class="hidden sm:inline-flex">Перейти на сайт</CTAButton>
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden p-2 rounded-lg text-slate-400 hover:bg-white/[0.05]"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Открыть меню"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-white/[0.06] py-4">
      <nav class="flex flex-col gap-1" aria-label="Мобильное меню">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2.5 rounded-lg text-sm font-medium',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-emerald-400 bg-emerald-500/10'
                  : 'text-slate-300 hover:bg-white/[0.05]',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <CTAButton href={affiliateLink} size="md" external class="mt-2 w-full">Перейти на платформу</CTAButton>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const open = !!(menu && !menu.classList.contains('hidden'));
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
