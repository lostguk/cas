    <div class="mb-6">
      <p class="inline-flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-widest text-coral-400">
        <span class="inline-block w-6 h-px bg-coral-500/60"></span>
        Сводная таблица
      </p>
