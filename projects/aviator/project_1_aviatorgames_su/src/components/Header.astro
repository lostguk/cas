---
const affiliateLink = '#';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/kak-igrat', label: 'Как играть' },
  { href: '/strategii', label: 'Стратегии' },
  { href: '/demo', label: 'Демо' },
  { href: '/signaly', label: 'Сигналы' },
  { href: '/skachat', label: 'Скачать' },
  { href: '/bonus', label: 'Бонус' },
];

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="fixed top-0 left-0 right-0 z-50 bg-abyss-900/95 backdrop-blur-md border-b border-coral-500/15">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <a href="/" class="flex items-center gap-2.5 group" aria-label="aviatorgames.su — на главную">
        <img
          src="/images/aviator-logo.png"
          alt="aviatorgames.su — логотип"
          width="40"
          height="40"
          class="w-10 h-10 rounded-lg shadow-md shadow-coral-500/20"
          loading="eager"
          decoding="async"
        />
        <span class="font-extrabold text-base lg:text-lg text-white tracking-tight">
          aviator<span class="text-coral-400">games</span>
        </span>
      </a>

      <nav class="hidden xl:flex items-center gap-1" aria-label="Основная навигация">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-semibold transition-colors duration-200',
              isActive(link.href)
                ? 'text-coral-400 bg-coral-500/10'
                : 'text-slate-300 hover:text-white hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="hidden sm:inline-flex items-center px-4 lg:px-5 py-2 lg:py-2.5 rounded-lg text-xs lg:text-sm font-bold uppercase tracking-wider bg-gradient-to-r from-coral-500 to-coral-600 text-white shadow-lg shadow-coral-500/25 hover:shadow-coral-500/40 transition-shadow duration-200"
        >
          Играть в Aviator
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="xl:hidden p-2 text-white"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Меню"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden xl:hidden border-t border-white/10 py-4">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3 rounded-lg text-sm font-semibold',
              isActive(link.href)
                ? 'text-coral-400 bg-coral-500/10'
                : 'text-slate-200 hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="mt-2 text-center px-5 py-3 rounded-lg text-sm font-bold uppercase tracking-wider bg-gradient-to-r from-coral-500 to-coral-600 text-white"
        >
          Играть в Aviator
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const open = menu && !menu.classList.contains('hidden');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
