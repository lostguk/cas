---
interface Props {
  class?: string;
  highlight?: boolean;
}
const { class: className = '', highlight = false } = Astro.props;
---

<div
  class:list={[
    'rounded-2xl p-6 lg:p-8 transition-all duration-300',
    highlight
      ? 'bg-gradient-to-br from-coral-500/10 via-abyss-800 to-coral-600/5 border border-coral-500/30'
      : 'bg-abyss-800/60 border border-white/[0.06] hover:border-coral-500/25',
    className,
  ]}
>
  <slot />
</div>
