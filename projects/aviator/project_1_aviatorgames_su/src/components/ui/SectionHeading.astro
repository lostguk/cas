---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  level?: 'h2' | 'h3';
  align?: 'left' | 'center';
}
const { eyebrow, title, subtitle, level = 'h2', align = 'left' } = Astro.props;
const Tag = level;
---

<div class:list={['mb-6', align === 'center' && 'text-center']}>
  {eyebrow && (
    <p class="inline-flex items-center gap-2 mb-3 text-xs font-bold uppercase tracking-widest text-coral-400">
      <span class="inline-block w-6 h-px bg-coral-500/60"></span>
      {eyebrow}
    </p>
  )}
  <Tag
    class:list={[
      level === 'h2' ? 'text-3xl lg:text-4xl' : 'text-2xl lg:text-3xl',
      'font-bold text-white leading-tight tracking-tight',
    ]}
  >
    {title}
  </Tag>
  {subtitle && (
    <p class="mt-3 text-base text-slate-400 max-w-3xl">
      {subtitle}
    </p>
  )}
</div>
