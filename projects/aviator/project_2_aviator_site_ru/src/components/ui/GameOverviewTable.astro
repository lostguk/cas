---
interface Row {
  emoji: string;
  label: string;
  value: string;
}

interface Props {
  rows: Row[];
  caption?: string;
}

const { rows, caption } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-orange-500/15 bg-carbon-800/50">
  {caption && (
    <p class="px-5 py-3 border-b border-white/5 text-sm text-slate-400">{caption}</p>
  )}
  <table class="w-full text-sm text-slate-200">
    <tbody>
      {rows.map((row, i) => (
        <tr class:list={[i % 2 === 0 ? 'bg-carbon-900/40' : '', 'border-b border-white/[0.04] last:border-b-0']}>
          <td class="px-4 sm:px-5 py-3 sm:py-3.5 font-semibold text-white whitespace-nowrap w-1/3 align-top">
            <span class="inline-flex items-center gap-2">
              <span class="text-base sm:text-lg" aria-hidden="true">{row.emoji}</span>
              <span>{row.label}</span>
            </span>
          </td>
          <td class="px-4 sm:px-5 py-3 sm:py-3.5 text-slate-300 align-top">
            <span set:html={row.value} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
