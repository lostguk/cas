---
import CTAButton from './CTAButton.astro'
import ImagePlaceholder from './ImagePlaceholder.astro'
;

interface Props {
  imageNumber: number;
  imageDescription: string;
  headline: string;
  body: string;
  primaryCta?: string;
  lastUsedMinutes?: number;
}

const affiliateLink = '#';

const {
  imageNumber,
  imageDescription,
  headline,
  body,
  primaryCta = 'Играть в Aviator',
  lastUsedMinutes = 6,
} = Astro.props;
---

<section class="my-10 lg:my-14">
  <div class="rounded-2xl bg-gradient-to-br from-orange-500/12 via-carbon-800 to-orange-600/8 border border-orange-500/30 p-5 sm:p-7 lg:p-8 shadow-xl shadow-orange-500/10">
    <div class="grid lg:grid-cols-[1fr_1.4fr] gap-6 lg:gap-8 items-center">
      <ImagePlaceholder description={`${imageNumber}. ${imageDescription}`} aspect="16/9" variant="promo" />

      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-full bg-sky-500/15 text-sky-300 border border-sky-500/30">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
            </svg>
            Проверено
          </span>
          <span class="text-[10px] text-slate-500 uppercase tracking-wider">
            Использовано {lastUsedMinutes} минут назад
          </span>
        </div>

        <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white leading-tight mb-3">
          {headline}
        </h3>

        <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-5">
          {body}
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <CTAButton href={affiliateLink} external size="lg">{primaryCta}</CTAButton>
          <a
            href="/bonus"
            class="text-xs font-bold uppercase tracking-wider text-orange-300 hover:text-orange-200 underline decoration-orange-500/40 underline-offset-4"
          >
            Подробнее об условиях
          </a>
        </div>

        <div class="mt-5 pt-5 border-t border-white/5 flex flex-wrap gap-2.5">
          <a
            href="/skachat"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-carbon-700 border border-white/10 text-xs font-semibold text-white hover:border-orange-500/40 transition-colors"
          >
            <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.523 15.34a4.466 4.466 0 0 1 2.137-3.748 4.616 4.616 0 0 0-3.65-1.953c-1.531-.158-3.026.913-3.81.913-.795 0-2.005-.892-3.305-.866a4.85 4.85 0 0 0-4.078 2.482c-1.752 3.044-.444 7.512 1.244 9.973.844 1.205 1.838 2.561 3.142 2.51 1.262-.052 1.737-.815 3.262-.815 1.518 0 1.962.815 3.295.789 1.36-.026 2.221-1.227 3.052-2.443a10.53 10.53 0 0 0 1.4-2.846 4.318 4.318 0 0 1-2.689-3.996zM15.045 7.94a4.405 4.405 0 0 0 1.005-3.16 4.483 4.483 0 0 0-2.913 1.508 4.187 4.187 0 0 0-1.034 3.04 3.706 3.706 0 0 0 2.942-1.388z" />
            </svg>
            App Store
          </a>
          <a
            href="/skachat"
            class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-carbon-700 border border-white/10 text-xs font-semibold text-white hover:border-orange-500/40 transition-colors"
          >
            <svg class="w-4 h-4 text-sky-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3 20.5V3.5C3 2.91 3.34 2.39 3.84 2.15L13.69 12L3.84 21.85C3.34 21.6 3 21.09 3 20.5M16.81 15.12L6.05 21.34L14.54 12.85L16.81 15.12M20.16 10.81C20.5 11.08 20.75 11.5 20.75 12C20.75 12.5 20.53 12.92 20.18 13.18L17.89 14.5L15.39 12L17.89 9.5L20.16 10.81M6.05 2.66L16.81 8.88L14.54 11.15L6.05 2.66Z" />
            </svg>
            Google Play
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
