---
interface Props {
  description: string;
  aspect?: string;
  class?: string;
  variant?: 'default' | 'promo' | 'mockup';
}
const { description, aspect = '16/10', class: className = '', variant = 'default' } = Astro.props;
const aspectRatio = aspect.includes('/') ? aspect.replace('/', ' / ') : aspect;

const variantClasses = {
  default: 'bg-carbon-800 border border-orange-500/15',
  promo: 'bg-gradient-to-br from-orange-500/15 via-carbon-800 to-orange-600/10 border border-orange-500/30',
  mockup: 'bg-gradient-to-b from-carbon-700 to-carbon-900 border border-sky-500/20',
};
---

<div
  class:list={['rounded-xl flex items-center justify-center w-full overflow-hidden relative', variantClasses[variant], className]}
  style={`aspect-ratio: ${aspectRatio}`}
  role="img"
  aria-label={description}
>
  <div class="absolute inset-0 opacity-30 pointer-events-none">
    <svg class="w-full h-full" viewBox="0 0 400 250" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 220 Q 100 200 200 140 T 400 30" fill="none" stroke="#fb923c" stroke-width="2" stroke-dasharray="4 4" />
      <circle cx="380" cy="40" r="6" fill="#38bdf8" class="animate-aviator-pulse" />
    </svg>
  </div>
  <div class="text-center px-4 relative z-10">
    <svg class="w-10 h-10 mx-auto text-orange-400/50 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M2 22 L11 13 L13 13 L11 17 L17 17 L18 18 L13 19 L11 22 L9 22 L10 18 L6 18 L4 22 Z" />
      <circle cx="17" cy="14" r="1" fill="currentColor" />
    </svg>
    <p class="text-xs text-slate-400 max-w-60 leading-snug">{description}</p>
  </div>
</div>
