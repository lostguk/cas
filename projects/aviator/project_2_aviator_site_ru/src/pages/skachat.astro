---
import ArticleMeta from '../components/ArticleMeta.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import FAQSection from '../components/sections/FAQSection.astro'
import FinalCTASection from '../components/sections/FinalCTASection.astro'
import Card from '../components/ui/Card.astro'
import CTAButton from '../components/ui/CTAButton.astro'
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro'
import PromoBanner from '../components/ui/PromoBanner.astro'
import StepsList from '../components/ui/StepsList.astro'
import BaseLayout from '../layouts/BaseLayout.astro'

const title = 'Скачать приложение для игры в Aviator на Android и iOS — Mostbet';
const description = 'Подробная инструкция по установке мобильного приложения Mostbet с Aviator: APK для Android, TestFlight для iOS, требования, размер, пошаговая установка и устранение типовых ошибок.';

const androidSteps = [
  { title: 'Перейдите на официальный сайт Mostbet', body: 'Откройте сайт через мобильный браузер (Chrome, Firefox, Safari). В нижнем меню найдите раздел «Приложение».' },
  { title: 'Скачайте APK', body: 'Нажмите большую красную кнопку «Скачать для Android». Размер файла — около 38 МБ, скачивание займёт 1–2 минуты на стандартном 4G/Wi-Fi.' },
  { title: 'Разрешите неизвестные источники', body: 'Откройте «Настройки» → «Безопасность» → «Установка из неизвестных источников» — разрешите для вашего браузера. На Android 10+ разрешение запросится автоматически при попытке открыть APK.' },
  { title: 'Установите приложение', body: 'Откройте загруженный файл из папки «Загрузки» или прямо из шторки уведомлений. Подтвердите установку — займёт 30–60 секунд.' },
  { title: 'Войдите или зарегистрируйтесь', body: 'После установки откройте приложение, войдите с теми же логином/паролем что на сайте, или зарегистрируйте новый аккаунт прямо в приложении. Aviator вынесен отдельной кнопкой в нижнем меню.' },
];

const iosSteps = [
  { title: 'Зайдите на сайт Mostbet с iPhone', body: 'Через Safari (рекомендуется) или Chrome. В разделе «Приложение» выберите вкладку «iOS».' },
  { title: 'Получите ссылку TestFlight', body: 'Apple не разрешает прямую установку азартных приложений из App Store. Вместо этого Mostbet использует TestFlight — официальный сервис Apple для бета-тестирования приложений.' },
  { title: 'Установите TestFlight', body: 'Если у вас ещё нет приложения TestFlight — установите его из App Store бесплатно. Размер около 30 МБ.' },
  { title: 'Перейдите по ссылке', body: 'Откройте полученную с сайта ссылку — TestFlight автоматически предложит установить Mostbet. Подтвердите.' },
  { title: 'Запустите и войдите', body: 'Приложение появится на главном экране как обычная иконка. Войдите по аккаунту с сайта, либо зарегистрируйтесь — Aviator сразу доступен в разделе «Казино».' },
];

const faqItems = [
  { q: 'Безопасно ли скачивать APK с сайта Mostbet?', a: 'Да. Apk-файл подписан официальным сертификатом Mostbet и проверяется Google Play Protect при установке. Главное — скачивайте только с официального сайта (по нашей партнёрской ссылке) и не используйте APK от сторонних источников и форумов — там часто встраивают трояны.' },
  { q: 'Почему Mostbet нет в Google Play и App Store?', a: 'Это политика обоих маркетплейсов: Google и Apple запрещают приложения с реальными деньгами и азартными играми во многих странах, включая Россию. Поэтому все международные онлайн-казино распространяют свои приложения напрямую (Android) или через TestFlight (iOS).' },
  { q: 'Можно ли играть в Aviator без приложения, через браузер?', a: 'Да. Веб-версия Mostbet работает в любом современном браузере (Chrome, Safari, Firefox) на компьютере и мобильном. Все функции — Aviator, депозит, вывод, поддержка — работают идентично приложению. Преимущество приложения — push-уведомления, биометрия и стабильнее работа на медленном интернете.' },
  { q: 'Каковы системные требования приложения?', a: '<strong>Android:</strong> версия 5.0 (Lollipop) и выше, минимум 50 МБ свободной памяти, ARM или x86 процессор. <strong>iOS:</strong> iOS 13.0+, поддерживаются все iPhone от 8-го поколения и iPad от 6-го. Приложение работает на iPhone SE 2-го поколения и новее без замечаний.' },
];
---

<BaseLayout title={title} description={description} type="article" publishDate="2026-01-28" updateDate="2026-04-21">
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Скачать приложение' }]} />

  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <ArticleMeta publishDate="2026-01-28" updateDate="2026-04-21" readingMinutes={7} />

    <header class="mt-8 mb-10">
      <p class="inline-flex items-center gap-2 mb-4 px-3 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest text-orange-300 bg-orange-500/10 border border-orange-500/30">
        Android · iOS
      </p>
      <h1 class="text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
        Скачать <span class="text-orange-400">Aviator</span> на телефон — приложение Mostbet
      </h1>
      <p class="text-lg text-slate-300 leading-relaxed max-w-3xl">
        Краш-игра <strong>Aviator</strong> доступна в мобильном приложении <strong>Mostbet</strong> для Android и iOS. Подробная инструкция по установке, требованиям, типовым ошибкам — и почему приложение лучше веб-версии для игры на ходу.
      </p>
    </header>

    <section class="mb-12">
      <ImagePlaceholder description="1. Мокап двух смартфонов рядом: iPhone и Samsung с открытым приложением Mostbet, активная игра Aviator на обоих экранах" aspect="16/9" />
    </section>

    <section class="mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight mb-5">Зачем нужно приложение, если есть сайт</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <Card>
          <div class="text-3xl mb-3" aria-hidden="true">🚀</div>
          <h3 class="font-bold text-white text-base mb-2">Быстрая загрузка</h3>
          <p class="text-sm text-slate-300 leading-relaxed">Один клик по иконке — игра уже на экране. Без ввода адреса и логина каждый раз.</p>
        </Card>
        <Card>
          <div class="text-3xl mb-3" aria-hidden="true">🔔</div>
          <h3 class="font-bold text-white text-base mb-2">Push-уведомления</h3>
          <p class="text-sm text-slate-300 leading-relaxed">Уведомления о выводе, бонусах, акциях по Aviator — прямо на экран блокировки.</p>
        </Card>
        <Card>
          <div class="text-3xl mb-3" aria-hidden="true">🔐</div>
          <h3 class="font-bold text-white text-base mb-2">Face ID / Touch ID</h3>
          <p class="text-sm text-slate-300 leading-relaxed">Вход за секунду без ввода пароля — особенно удобно для частых сессий.</p>
        </Card>
        <Card>
          <div class="text-3xl mb-3" aria-hidden="true">📡</div>
          <h3 class="font-bold text-white text-base mb-2">Стабильность</h3>
          <p class="text-sm text-slate-300 leading-relaxed">Работает на медленном 3G и в роуминге, где веб-версия часто разрывает соединение.</p>
        </Card>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight mb-5">Установка на Android — пошагово</h2>
      <p class="text-slate-300 leading-relaxed mb-6">
        Apk-файл размером 38 МБ распространяется напрямую с сайта Mostbet. Установка занимает 2–3 минуты.
      </p>
      <StepsList steps={androidSteps} />
      <div class="mt-6">
        <CTAButton href="#" external size="lg">Перейти на Mostbet и скачать APK</CTAButton>
      </div>
    </section>

    <PromoBanner
      imageNumber={2}
      imageDescription="Промо-баннер: смартфон Android с открытым Aviator на экране блокировки, иконка приложения с подсветкой"
      headline="Скачайте приложение и заберите бонус 125% сразу"
      body="После установки приложения зарегистрируйтесь и пополните счёт за 7 минут — приветственный бонус 125% работает идентично в приложении и на сайте."
      primaryCta="Скачать и забрать бонус"
      lastUsedMinutes={5}
    />

    <section class="mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight mb-5">Установка на iOS через TestFlight</h2>
      <p class="text-slate-300 leading-relaxed mb-6">
        Apple Store не пускает приложения с реальными ставками, поэтому iOS-приложение распространяется через официальный сервис тестирования <strong>TestFlight</strong>.
      </p>
      <StepsList steps={iosSteps} />
    </section>

    <section class="mb-12">
      <h2 class="text-3xl font-bold text-white tracking-tight mb-5">Системные требования</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <Card>
          <h3 class="font-bold text-white text-lg mb-3">Android</h3>
          <ul class="space-y-2 text-sm text-slate-300">
            <li><strong>Версия:</strong> Android 5.0 (Lollipop) и выше</li>
            <li><strong>Размер APK:</strong> 38 МБ</li>
            <li><strong>Свободная память:</strong> от 50 МБ</li>
            <li><strong>Оперативная память:</strong> от 1 ГБ</li>
            <li><strong>Процессор:</strong> ARMv7+ или x86</li>
            <li><strong>Интернет:</strong> 3G и быстрее (стабильно с Wi-Fi)</li>
          </ul>
        </Card>
        <Card>
          <h3 class="font-bold text-white text-lg mb-3">iOS</h3>
          <ul class="space-y-2 text-sm text-slate-300">
            <li><strong>Версия:</strong> iOS 13.0 и выше</li>
            <li><strong>Размер:</strong> около 45 МБ</li>
            <li><strong>Свободная память:</strong> от 100 МБ</li>
            <li><strong>Устройства:</strong> iPhone 8+ и iPad 6+</li>
            <li><strong>TestFlight:</strong> обязательно установить</li>
            <li><strong>Apple ID:</strong> любой регион (можно RU)</li>
          </ul>
        </Card>
      </div>
    </section>

    <section class="mb-12 prose-aviator text-slate-300 leading-relaxed">
      <h2 class="text-3xl font-bold text-white tracking-tight mb-4">Типовые ошибки при установке</h2>
      <p class="mb-3"><strong>«Приложение не установлено»</strong> на Android — обычно из-за нехватки памяти. Освободите 100+ МБ и повторите.</p>
      <p class="mb-3"><strong>«Файл повреждён»</strong> — повторно скачайте APK с официального сайта. Часто помогает смена сети с Wi-Fi на 4G и обратно.</p>
      <p class="mb-3"><strong>«Эта учётная запись разработчика не была проверена»</strong> на iOS — зайдите в «Настройки» → «Основные» → «Управление устройством» → найдите профиль Mostbet и нажмите «Доверять».</p>
      <p><strong>TestFlight «Maximum Testers Reached»</strong> — лимит пользователей в TestFlight ограничен (10 000 на сборку). Подождите 1–2 дня — администрация Mostbet регулярно ротирует слоты или выпускает обновлённую сборку.</p>
    </section>

    <FAQSection items={faqItems} title="Вопросы про приложение Aviator" />
  </article>

  <FinalCTASection
    title='Установите приложение и <span class="text-orange-400">играйте откуда угодно</span>'
    body="Aviator в кармане — на работе, в дороге, в очереди. Бонус 125% работает в приложении так же, как и на сайте."
    rating="4.9/5"
    cta="Скачать Mostbet с Aviator"
  />
</BaseLayout>
