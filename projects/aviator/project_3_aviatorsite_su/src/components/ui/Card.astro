---
interface Props {
  class?: string;
  highlight?: boolean;
}
const { class: className = '', highlight = false } = Astro.props;
---

<div
  class:list={[
    'rounded-2xl p-6 lg:p-8 transition-all duration-300',
    highlight
      ? 'bg-gradient-to-br from-amber-500/10 via-navy-800 to-amber-600/5 border border-amber-500/30'
      : 'bg-navy-800/60 border border-white/[0.06] hover:border-amber-500/25',
    className,
  ]}
>
  <slot />
</div>
