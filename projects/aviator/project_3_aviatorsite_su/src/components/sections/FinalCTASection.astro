---
import CTAButton from '../ui/CTAButton.astro'
interface Props {
  title: string;
  body: string;
  rating?: string;
  cta?: string;
}

const affiliateLink = '#';
const {
  title,
  body,
  rating = '4.9/5',
  cta = 'Играть в Aviator на 1xBet',
} = Astro.props;
---

<section class="py-14 lg:py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-amber-500/20 via-navy-800 to-amber-600/15 border border-amber-500/35 p-8 sm:p-12 lg:p-14 text-center shadow-2xl shadow-amber-500/15">
      <div class="absolute -top-20 -right-20 w-64 h-64 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-20 -left-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative">
        <div class="inline-flex items-center gap-2 mb-5 px-4 py-2 rounded-full bg-navy-900/60 border border-amber-500/30">
          <div class="flex">
            {[1, 2, 3, 4, 5].map(() => (
              <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              </svg>
            ))}
          </div>
          <span class="text-sm font-bold text-white">{rating}</span>
          <span class="text-xs text-slate-400">— рейтинг Aviator</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-4 tracking-tight" set:html={title} />

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8 leading-relaxed" set:html={body} />

        <div class="flex flex-wrap items-center justify-center gap-3">
          <CTAButton href={affiliateLink} external size="lg">{cta}</CTAButton>
          <CTAButton href="/strategii" variant="secondary" size="lg">Изучить стратегии</CTAButton>
        </div>

        <p class="mt-6 text-xs text-slate-500">
          18+. Играйте ответственно. Aviator — игра с высокой волатильностью, не ставьте больше, чем готовы потерять.
        </p>
      </div>
    </div>
  </div>
</section>
