---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const siteUrl = 'https://aviatorsite.su';
const currentPageUrl = Astro.url.href;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href ? new URL(item.href, siteUrl).href : currentPageUrl,
  })),
};
---

<nav aria-label="Хлебные крошки" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <svg class="w-4 h-4 text-amber-500/40 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m9 18 6-6-6-6" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="text-slate-400 hover:text-amber-400 transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-white font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
