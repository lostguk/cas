---
interface Props {
  publishDate: string;
  updateDate?: string;
  readingMinutes?: number;
}

const { publishDate, updateDate, readingMinutes } = Astro.props;

const formatDate = (iso: string) => {
  const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
  const d = new Date(iso);
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
};
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-500 border border-amber-500/10 bg-navy-800/40 rounded-lg px-4 py-3">
  <span class="inline-flex items-center gap-1.5">
    <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" />
      <path d="M16 2v4M8 2v4M3 10h18" />
    </svg>
    <span>Опубликовано: <strong class="text-slate-300">{formatDate(publishDate)}</strong></span>
  </span>
  {updateDate && (
    <span class="inline-flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5" />
      </svg>
      <span>Обновлено: <strong class="text-slate-300">{formatDate(updateDate)}</strong></span>
    </span>
  )}
  {readingMinutes && (
    <span class="inline-flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 6v6l4 2" />
      </svg>
      <span>Чтение: <strong class="text-slate-300">{readingMinutes} мин</strong></span>
    </span>
  )}
  <span class="inline-flex items-center gap-1.5 ml-auto">
    <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z" />
    </svg>
    <span class="text-slate-300">Проверено редакцией</span>
  </span>
</div>
