---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = '#';
const title = 'Big Bass Bonanza слот: RTP 96.71%, максимум ×2 100 | 1xBet';
const description =
  'Обзор слота Big Bass Bonanza на 1xBet: RTP 96.71%, макс. выигрыш ×2 100. Pragmatic Play. Играй в рубль.';
const canonical = 'https://1xbetsite.su/big-bass-bonanza';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'Game',
      name: 'Big Bass Bonanza',
      gameLocation: { '@type': 'VirtualLocation', url: canonical },
    },
    reviewRating: { '@type': 'Rating', ratingValue: '4', bestRating: '5' },
    author: { '@type': 'Organization', name: '1xbetsite.su' },
    reviewBody: description,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  type="article"
>
  <Breadcrumbs
    items={[
      { label: 'Главная', href: '/' },
      { label: 'Слоты', href: '/igrovye-avtomaty' },
      { label: 'Big Bass Bonanza' },
    ]}
  />
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-sm font-semibold text-cta-500 mb-2">Pragmatic Play · RTP 96.71%</p>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Big Bass Bonanza</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Рыбалка со множителями. Ловишь рыбака — он собирает деньги с экрана. Максимум ×2 100.
        </p>
        <CTAButton href={affiliateLink} size="lg" external class="mt-8">Попробовать в демо</CTAButton>
      </div>

      <ImagePlaceholder description="Слот Big Bass Bonanza: рыбалка и множители" aspect="16/9" class="mb-10" />

      <div class="grid sm:grid-cols-3 gap-4 mb-10 text-center">
        <Card class="py-4">
          <div class="text-xs text-gray-500 uppercase">RTP</div>
          <div class="text-xl font-bold text-gray-900">96.71%</div>
        </Card>
        <Card class="py-4">
          <div class="text-xs text-gray-500 uppercase">Макс.</div>
          <div class="text-xl font-bold text-gray-900">×2 100</div>
        </Card>
        <Card class="py-4">
          <div class="text-xs text-gray-500 uppercase">Провайдер</div>
          <div class="text-xl font-bold text-gray-900">Pragmatic</div>
        </Card>
      </div>

      <div class="space-y-6 text-gray-700 mb-10">
        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Обзор</h2>
          <p>
            Big Bass Bonanza — один из самых популярных слотов Pragmatic Play. Сетка 5×3, 10 линий. Тема рыбалки с яркой графикой. Средне-высокая волатильность, бонус ловится чаще чем в Dead or Alive 2.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Как играть</h2>
          <p>
            3+ скаттера запускают фриспины. Рыбак собирает денежные символы на экране. Дополнительные рыбаки увеличивают множитель до ×10. Можно продлить бонус.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Стоит ли играть</h2>
          <p>
            Отличный баланс между частотой бонусов и потенциалом. Меньше стресса чем в <a href="/dead-or-alive-2" class="text-cta-500 hover:text-cta-600 underline">Dead or Alive 2</a>, но и макс. выигрыш скромнее. Для тех кто любит стабильную динамику.
          </p>
        </div>
      </div>

      <div class="rounded-xl bg-gray-50 p-4 text-sm text-gray-500 mb-8">
        18+. Играйте ответственно. <a href="/privetstvennye-bonusy" class="text-cta-500 hover:text-cta-600">Бонусы</a> помогут начать с меньшим риском.
      </div>

      <div class="text-center">
        <CTAButton href={affiliateLink} size="lg" external>Играть на 1xBet</CTAButton>
      </div>

      <div class="mt-8 text-sm text-gray-500 text-center">
        <a href="/igrovye-avtomaty" class="text-cta-500 hover:text-cta-600">Все слоты</a> · <a href="/dead-or-alive-2" class="text-cta-500 hover:text-cta-600">Dead or Alive 2</a> · <a href="/book-of-dead" class="text-cta-500 hover:text-cta-600">Book of Dead</a>
      </div>
    </div>
  </section>
</BaseLayout>
