---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';

const affiliateLink = '#';
const title = 'Личный кабинет 1xBet: вход, вывод, верификация РУ';
const description =
  '1xBet личный кабинет — как войти, пополнить счёт и вывести деньги в рубль на Сбербанк Gold.';
const canonical = 'https://1xbetsite.su/moj-profil';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  inLanguage: 'ru',
};

const loginSteps = [
  { n: '01', title: 'Откройте сайт или приложение', text: 'Используйте актуальный адрес или зеркало.' },
  { n: '02', title: 'Введите логин и пароль', text: 'Или войдите через соцсеть / Telegram.' },
  { n: '03', title: 'Двухфакторная защита', text: 'Если включена — введите код из Google Authenticator.' },
];

const features = [
  { title: 'История ставок', text: 'Все ставки, выигрыши и проигрыши в одном месте.' },
  { title: 'Вывод средств', text: 'Сбербанк, Тинькофф, USDT. От 100 ₽.' },
  { title: 'Бонусы', text: 'Активные бонусы, прогресс отыгрыша, промокоды.' },
  { title: 'Верификация', text: 'Загрузите СНИЛС/ИНН для подтверждения личности.' },
  { title: 'Настройки', text: 'Смена пароля, лимиты, самоисключение.' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  type="article"
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Профиль' }]} />
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Личный кабинет 1xBet</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Вход, настройки, вывод средств на Сбербанк. Всё в одном месте.
        </p>
        <CTAButton href={affiliateLink} size="lg" external class="mt-8">Войти в кабинет</CTAButton>
      </div>

      <h2 class="text-2xl font-semibold text-gray-900 mb-6">Как войти</h2>
      <div class="space-y-4 mb-14">
        {
          loginSteps.map((s) => (
            <Card>
              <div class="flex gap-4">
                <span class="text-2xl font-extrabold text-cta-500 shrink-0">{s.n}</span>
                <div>
                  <h3 class="font-semibold text-gray-900 mb-1">{s.title}</h3>
                  <p class="text-sm text-gray-600">{s.text}</p>
                </div>
              </div>
            </Card>
          ))
        }
      </div>

      <h2 class="text-2xl font-semibold text-gray-900 mb-6 text-center">Возможности кабинета</h2>
      <div class="grid sm:grid-cols-2 gap-4 mb-14">
        {
          features.map((f) => (
            <Card>
              <h3 class="font-semibold text-gray-900 mb-1">{f.title}</h3>
              <p class="text-sm text-gray-600">{f.text}</p>
            </Card>
          ))
        }
      </div>

      <h2 class="text-2xl font-semibold text-gray-900 mb-4">Вывод средств</h2>
      <p class="text-gray-600 mb-8">
        Сбербанк, Тинькофф, Альфа-Банк — вывод от 1 до 24 часов. USDT — 15–30 минут. Минимум 100 ₽. Перед первым выводом пройдите верификацию.
      </p>

      <div class="text-center p-8 rounded-2xl bg-gray-50 shadow-xl">
        <h2 class="text-xl font-semibold text-gray-900 mb-3">Нет аккаунта?</h2>
        <p class="text-gray-600 mb-6">
          <a href="/otkryt-schet" class="text-cta-500 hover:text-cta-600 underline">Зарегистрируйтесь</a> за 2 минуты и получите <a href="/privetstvennye-bonusy" class="text-cta-500 hover:text-cta-600 underline">бонус</a>.
        </p>
        <CTAButton href={affiliateLink} size="lg" external>Создать аккаунт</CTAButton>
      </div>

      <div class="mt-8 text-sm text-gray-500 text-center">
        <a href="/ustanovka" class="text-cta-500 hover:text-cta-600">Скачать приложение</a> · <a href="/about" class="text-cta-500 hover:text-cta-600">О проекте</a> · <a href="/dead-or-alive-2" class="text-cta-500 hover:text-cta-600">Dead or Alive 2</a>
      </div>
    </div>
  </section>
</BaseLayout>
