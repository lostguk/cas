---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = '#';
const title = 'Играть Dead or Alive 2 на 1xBet Россия — обзор и RTP';
const description =
  'Dead or Alive 2 на 1xBet: RTP 96.82%, бонусные раунды, волатильность. Честный обзор от жителя Россия 2026.';
const canonical = 'https://1xbetsite.su/dead-or-alive-2';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'Game',
      name: 'Dead or Alive 2',
      gameLocation: { '@type': 'VirtualLocation', url: canonical },
    },
    reviewRating: { '@type': 'Rating', ratingValue: '4', bestRating: '5' },
    author: { '@type': 'Organization', name: '1xbetsite.su' },
    reviewBody: description,
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={schema}
  type="article"
>
  <Breadcrumbs
    items={[
      { label: 'Главная', href: '/' },
      { label: 'Слоты', href: '/igrovye-avtomaty' },
      { label: 'Dead or Alive 2' },
    ]}
  />
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-sm font-semibold text-cta-500 mb-2">NetEnt · RTP 96.82%</p>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 mb-4">Dead or Alive 2</h1>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto">
          Тема Дикого Запада, три варианта бонусных раундов, максимальный выигрыш ×111 111. Высокая волатильность.
        </p>
        <CTAButton href={affiliateLink} size="lg" external class="mt-8">Открыть слот</CTAButton>
      </div>

      <ImagePlaceholder description="Слот Dead or Alive 2: ковбои, револьверы и Дикий Запад" aspect="16/9" class="mb-10" />

      <div class="grid sm:grid-cols-3 gap-4 mb-10 text-center">
        <Card class="py-4">
          <div class="text-xs text-gray-500 uppercase">RTP</div>
          <div class="text-xl font-bold text-gray-900">96.82%</div>
        </Card>
        <Card class="py-4">
          <div class="text-xs text-gray-500 uppercase">Макс.</div>
          <div class="text-xl font-bold text-gray-900">×111 111</div>
        </Card>
        <Card class="py-4">
          <div class="text-xs text-gray-500 uppercase">Провайдер</div>
          <div class="text-xl font-bold text-gray-900">NetEnt</div>
        </Card>
      </div>

      <div class="space-y-6 text-gray-700 mb-10">
        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Обзор</h2>
          <p>
            Dead or Alive 2 — продолжение легендарного слота от NetEnt. Сетка 5×3, 9 линий выплат. Три режима фриспинов с разными уровнями риска и потенциала. Высокая волатильность: бонус приходит редко, но бьёт мощно.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Как играть</h2>
          <p>
            Собирайте 3+ скаттера для запуска бонуса. Выбирайте режим: Train Heist (средний риск), Saloon (низкий) или High Noon (максимум). В High Noon — sticky wilds с множителями.
          </p>
        </div>

        <div>
          <h2 class="text-xl font-semibold text-gray-900 mb-3">Стоит ли играть</h2>
          <p>
            Если любите высокую дисперсию и не боитесь серий пустых спинов — да. Для осторожных — лучше <a href="/big-bass-bonanza" class="text-cta-500 hover:text-cta-600 underline">Big Bass Bonanza</a> или <a href="/book-of-dead" class="text-cta-500 hover:text-cta-600 underline">Book of Dead</a>.
          </p>
        </div>
      </div>

      <div class="rounded-xl bg-gray-50 p-4 text-sm text-gray-500 mb-8">
        18+. Играйте ответственно. Установите лимиты в <a href="/moj-profil" class="text-cta-500 hover:text-cta-600">личном кабинете</a>.
      </div>

      <div class="text-center">
        <CTAButton href={affiliateLink} size="lg" external>Играть на 1xBet</CTAButton>
      </div>

      <div class="mt-8 text-sm text-gray-500 text-center">
        <a href="/igrovye-avtomaty" class="text-cta-500 hover:text-cta-600">Все слоты</a> · <a href="/big-bass-bonanza" class="text-cta-500 hover:text-cta-600">Big Bass Bonanza</a> · <a href="/book-of-dead" class="text-cta-500 hover:text-cta-600">Book of Dead</a>
      </div>
    </div>
  </section>
</BaseLayout>
