---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'rounded-xl p-6 lg:p-8 bg-white shadow-xl',
    hover && 'hover:shadow-2xl hover:border-cta-500/20 transition-all duration-200',
    className,
  ]}
>
  <slot />
</div>
