---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import CTAButton from '../ui/CTAButton.astro';

const items = [
  {
    title: 'Линия и коэффициенты',
    plus: '50+ видов спорта, маржа 3–5%',
    minus: 'На РПЛ роспись беднее чем на АПЛ',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/></svg>',
  },
  {
    title: 'Оплата в рублях',
    plus: 'Сбербанк, Тинькофф, СБП — без конвертации',
    minus: 'Некоторые карты отклоняют платежи',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>',
  },
  {
    title: 'Мобильное приложение',
    plus: 'APK ~40 МБ, стабильная работа',
    minus: 'Нет в Google Play, обновлять вручную',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 18h4"/></svg>',
  },
  {
    title: 'Казино и слоты',
    plus: '10 000+ игр, топ-провайдеры',
    minus: 'Вейджер ×35 на казино — жёстко',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h2M14 9h2M9 15h6"/></svg>',
  },
  {
    title: 'Бонусы',
    plus: 'До 32 500 ₽ + 150 фриспинов',
    minus: 'Условия отыгрыша непростые',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="7"/></svg>',
  },
  {
    title: 'Поддержка',
    plus: 'Чат 24/7 на русском',
    minus: 'Шаблонные ответы, нужно настаивать',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg>',
  },
];
---

<section class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Плюсы и минусы — без прикрас</SectionHeading>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        items.map((item) => (
          <Card>
            <div class="w-12 h-12 rounded-xl bg-cta-500/10 text-cta-500 flex items-center justify-center mb-4" set:html={item.icon} />
            <h3 class="text-lg font-semibold text-gray-900 mb-3">{item.title}</h3>
            <p class="text-sm text-green-600 mb-1">+ {item.plus}</p>
            <p class="text-sm text-gray-500">− {item.minus}</p>
          </Card>
        ))
      }
    </div>
    <div class="text-center mt-10">
      <CTAButton href="#" size="lg" external>Начать играть</CTAButton>
    </div>
  </div>
</section>
