---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import CTAButton from '../ui/CTAButton.astro';

const cards = [
  {
    title: 'Футбол и РПЛ',
    text: 'Зенит, Спартак, ЦСКА — до 200 рынков на матч. Маржа 3–5% на топ-игры.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>',
  },
  {
    title: 'Хоккей и КХЛ',
    text: 'Полная линия на КХЛ, live-ставки с кэшаутом. Задержка трансляции 10–20 сек.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 18l4-6 4 3 4-8 4 5v4H4Z"/></svg>',
  },
  {
    title: 'Бокс и MMA',
    text: 'UFC, Bellator, бокс — ставки на раунд, метод победы, тоталы.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h8l-1 8 10-12h-7l0-8z"/></svg>',
  },
  {
    title: 'Киберспорт',
    text: 'Dota 2, CS2, Valorant — live-линия, коэффициенты обновляются в реальном времени.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
  },
];
---

<section class="py-16 lg:py-24 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Ставки на любой вид спорта</SectionHeading>
    <div class="grid sm:grid-cols-2 gap-6">
      {
        cards.map((c) => (
          <Card>
            <div class="w-12 h-12 rounded-xl bg-cta-500/10 text-cta-500 flex items-center justify-center mb-4" set:html={c.icon} />
            <h3 class="text-lg font-semibold text-gray-900 mb-2">{c.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{c.text}</p>
          </Card>
        ))
      }
    </div>
    <div class="text-center mt-10">
      <CTAButton href="#" size="lg" external>Сделать ставку</CTAButton>
    </div>
  </div>
</section>
