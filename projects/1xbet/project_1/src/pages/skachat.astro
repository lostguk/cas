---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955869m_97c_';

const publishDate = '2026-01-18';
const updateDate = '2026-03-22';

const howToSchema = {
  '@type': 'HowTo',
  name: 'Скачать приложение 1xBet на Android и iOS',
  description: 'Безопасная загрузка APK и альтернативы для iPhone.',
  step: [
    { '@type': 'HowToStep', name: 'Шаг 1', text: 'Открыть официальный раздел загрузки на сайте.' },
    { '@type': 'HowToStep', name: 'Шаг 2', text: 'Скачать APK для Android или следовать инструкции для iOS.' },
    { '@type': 'HowToStep', name: 'Шаг 3', text: 'Разрешить установку из источников и завершить установку.' },
  ],
};
---

<BaseLayout
  title="Скачать 1xBet Казахстан — APK для Android бесплатно"
  description="Как скачать 1xBet в Казахстане: APK для Android, инструкция для iPhone. Рабочая ссылка 2026."
  type="article"
  schema={howToSchema}
  publishDate={publishDate}
  updateDate={updateDate}
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Скачать' }]} />
  <ArticleMeta publishDate={publishDate} updateDate={updateDate} />
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-4">Скачать клиент: Android через APK, iOS со своими нюансами</h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Мы предлагаем не искать «взломанные версии» — это путь к потере аккаунта и нервов.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <CTAButton href={affiliateLink} size="lg" external>Страница загрузки</CTAButton>
          <CTAButton href="/zerkalo" variant="secondary" size="lg">Если сайт не открывается</CTAButton>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-8 mb-12 items-start">
        <ImagePlaceholder description="Мокап смартфона с интерфейсом ставок 1xBet" aspect="3/4" />
        <div class="space-y-5 text-slate-300 leading-relaxed">
          <h2 class="text-xl font-bold text-white">Android</h2>
          <p>
            Разрешить неизвестные источники, скачать файл, установить, обновить когда просит. Верефикация антивирусом иногда пугает зря — смотрите издателя и путь установки.
          </p>
          <p>
            Приложение которое вчера работало сегодня может попросить апдейт после блокировок зеркала — нормальная жизнь цикла, не конец света.
          </p>
          <h2 class="text-xl font-bold text-white pt-2">iPhone</h2>
          <p>
            Схемы меняются, мы не рисуем вечный скриншот: идите в официальные инструкции внутри кабинета. Если что-то «не как в гайде 2023» — значит процесс обновили, это бывает.
          </p>
        </div>
      </div>
      <div class="mt-16 text-center p-8 rounded-2xl bg-gradient-to-br from-accent-500/10 via-base-800 to-secondary-500/5 border border-accent-500/10">
        <h2 class="text-2xl font-bold text-white mb-3">Обновления и кеш</h2>
        <p class="text-slate-300 mb-6 leading-relaxed">
          Подтормаживть интерфейс может кеш, очистили — стало лучше; если нет, проверяйте сеть и версию APK.
        </p>
        <CTAButton href={affiliateLink} size="lg" external>Скачать официально</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
