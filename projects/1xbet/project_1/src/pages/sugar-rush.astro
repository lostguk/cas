---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955869m_97c_';

const publishDate = '2026-02-14';
const updateDate = '2026-03-29';

const reviewSchema = {
  '@type': 'Review',
  itemReviewed: {
    '@type': 'VideoGame',
    name: 'Sugar Rush',
    gamePlatform: 'Online',
    author: { '@type': 'Organization', name: 'Pragmatic Play' },
  },
  reviewBody: 'Обзор слота Sugar Rush на 1xBet для KZ: волатильность, бонусы, RTP.',
  author: { '@type': 'Organization', name: '1xbet-obzor.kz' },
  datePublished: publishDate,
};
---

<BaseLayout
  title="Играть Sugar Rush на 1xBet Казахстан — обзор и RTP"
  description="Sugar Rush на 1xBet: RTP 96.50%, бонусные раунды, волатильность. Честный обзор от казахстанца 2026."
  type="article"
  schema={reviewSchema}
  publishDate={publishDate}
  updateDate={updateDate}
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Казино', href: '/casino' }, { label: 'Sugar Rush' }]} />
  <ArticleMeta publishDate={publishDate} updateDate={updateDate} />
  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white leading-tight mb-4">Sugar Rush: сладко на экране, остро по банкроллу</h1>
        <p class="text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
          Pragmatic Play, RTP около 96.50%, потенциал до ×5000 — цифры из спецификации, не из нашей фантазии.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
          <CTAButton href={affiliateLink} size="lg" external>Играть</CTAButton>
          <CTAButton href="/sweet-bonanza" variant="secondary" size="lg">Sweet Bonanza</CTAButton>
        </div>
      </div>
      <div class="mb-12">
        <ImagePlaceholder description="Слот Sugar Rush: конфеты и яркие цвета, тема сладостей" />
      </div>
      <div class="space-y-6 text-slate-300 leading-relaxed">
        <h2 class="text-2xl font-bold text-white">Механика</h2>
        <p>
          Кластеры и множители на сетке цепляют визуально, серии могут сыпать подряд или молчать долго — высокая волатильность не для сессии «на кофе».
        </p>
        <p>
          Купить бонус дорого, иногда окупается, иногда нет; мы предлагаем тренироваться в демо если доступно, а то сразу лезть в тенге как минное поле.
        </p>
        <h2 class="text-2xl font-bold text-white">RTP и реальность</h2>
        <p>
          RTP не гарантирует сессию в плюс, это долгая математика. Коротко: за вечер можно и в ноль, и в хороший плюс — оба исхода нормальны статистически.
        </p>
      </div>
      <div class="mt-16 text-center p-8 rounded-2xl bg-gradient-to-br from-accent-500/10 via-base-800 to-secondary-500/5 border border-accent-500/10">
        <h2 class="text-2xl font-bold text-white mb-3">Не гонитесь за «догоном»</h2>
        <p class="text-slate-300 mb-6 leading-relaxed">
          Проиграли лимит — вышли, отдохнули; погоня за отыгрышем в слоте редко заканчивается сказкой.
        </p>
        <CTAButton href={affiliateLink} size="lg" external>Открыть слот</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
