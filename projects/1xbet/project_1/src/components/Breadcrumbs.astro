---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const siteUrl = 'https://1xbet-obzor.kz';

const listItems = items.map((item, i) => ({
  ...item,
  position: i + 1,
  href: item.href ? new URL(item.href, siteUrl).href : undefined,
}));

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: listItems.map((item) => ({
    '@type': 'ListItem',
    position: item.position,
    name: item.label,
    ...(item.href ? { item: item.href } : {}),
  })),
};
---

<nav aria-label="Навигация" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-4">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <svg class="w-4 h-4 text-slate-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="text-accent-400/90 hover:text-accent-300 transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-slate-300">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
