---
const affiliateLink = 'https://refpa94475.com/L?tag=d_3955869m_97c_';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/registraciya', label: 'Регистрация' },
  { href: '/skachat', label: 'Скачать' },
  { href: '/casino', label: 'Казино' },
  { href: '/zerkalo', label: 'Зеркало' },
  { href: '/bonus', label: 'Бонус' },
  { href: '/about', label: 'О проекте' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-base-950/90 backdrop-blur-xl border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[4.5rem]">
      <a href="/" class="flex items-center gap-2 shrink-0" aria-label="На главную">
        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg bg-base-800 border border-accent-500/30 text-lg font-extrabold text-accent-400">1</span>
        <span class="hidden sm:block text-white font-bold tracking-tight">1xbet-obzor<span class="text-accent-400">.kz</span></span>
      </a>
      <nav class="hidden lg:flex items-center gap-1" aria-label="Основное меню">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-accent-400 bg-accent-500/10'
                : 'text-slate-300 hover:text-white hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>
      <div class="flex items-center gap-3">
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-sm font-semibold bg-gradient-to-r from-accent-500 to-accent-600 text-base-950 shadow-lg shadow-accent-500/20 hover:from-accent-400 hover:to-accent-500 transition-all"
        >
          На сайт
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden p-2 rounded-lg text-slate-300 hover:bg-white/5 border border-white/10"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Открыть меню"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
    <div id="mobile-menu" class="hidden lg:hidden border-t border-white/5 py-4 pb-6">
      <nav class="flex flex-col gap-1" aria-label="Мобильное меню">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-3 rounded-lg text-sm font-medium',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'text-accent-400 bg-accent-500/10'
                : 'text-slate-300 hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-flex items-center justify-center px-5 py-3 rounded-xl text-sm font-semibold bg-gradient-to-r from-accent-500 to-accent-600 text-base-950"
        >
          Перейти на платформу
        </a>
      </nav>
    </div>
  </div>
</header>
<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
