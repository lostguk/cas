---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 lg:p-8',
    hover && 'hover:bg-white/[0.05] hover:border-white/10 transition-all duration-300',
    className,
  ]}
>
  <slot />
</div>
