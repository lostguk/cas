---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955869m_97c_';
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-3xl overflow-hidden border border-accent-500/15 bg-gradient-to-br from-accent-500/10 via-base-800 to-secondary-500/5 px-6 py-14 sm:px-12 text-center">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-accent-500/10 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
      <div class="relative max-w-2xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3">Готовы проверить сами?</h2>
        <p class="text-slate-300 mb-8 leading-relaxed">
          Мы предлагаем начать с малого депозита, почитать правила бонуса и не гнаться за «железобетонными» прогнозами из чатов.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <CTAButton href={affiliateLink} size="lg" external>Перейти на 1xBet</CTAButton>
          <CTAButton href="/bonus" variant="outline" size="lg">Сначала про бонусы</CTAButton>
        </div>
      </div>
    </div>
  </div>
</section>
