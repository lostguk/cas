---
import CTAButton from '../ui/CTAButton.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955869m_97c_';
---

<section class="relative overflow-hidden py-16 sm:py-20 lg:py-28">
  <div class="absolute inset-0 bg-gradient-to-br from-base-800 via-base-950 to-base-900" aria-hidden="true"></div>
  <div
    class="absolute top-1/4 right-0 w-[min(80vw,520px)] h-[min(80vw,520px)] rounded-full bg-accent-500/10 blur-[100px] pointer-events-none"
    aria-hidden="true"
  >
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-500/10 border border-accent-500/20 text-accent-300 text-sm font-medium mb-6">
          Казахстан · KZT · обзор 2026
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white leading-[1.1] mb-6">
          1xBet в Казахстане: спорт, казино и бонусы без лишнего шума
        </h1>
        <p class="text-lg text-slate-300 max-w-xl mb-8 leading-relaxed">
          Мы предлагаем собрать в одном месте то, что реально спрашивают в чатах: как пополнить в тенге, где взять зеркало и не словить фейк, и почему коэфициенты на КПЛ то взлетают то падают за минуту до старта.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <CTAButton href={affiliateLink} size="lg" external>Открыть платформу</CTAButton>
          <CTAButton href="/registraciya" variant="secondary" size="lg">Как зарегистрироваться</CTAButton>
        </div>
        <div class="grid grid-cols-3 gap-4 max-w-md">
          <div>
            <div class="text-2xl font-bold text-accent-400">KZT</div>
            <div class="text-xs text-slate-400 mt-1">Счёт в тенге</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-accent-400">24/7</div>
            <div class="text-xs text-slate-400 mt-1">Линия и live</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-accent-400">APK</div>
            <div class="text-xs text-slate-400 mt-1">Вне маркетов</div>
          </div>
        </div>
      </div>
      <div class="relative">
        <ImagePlaceholder description="Обзор платформы: стадион, неон и линия ставок на тёмном фоне" class="shadow-2xl shadow-black/40" />
      </div>
    </div>
  </div>
</section>
