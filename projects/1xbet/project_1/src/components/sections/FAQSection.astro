---
import SectionHeading from '../ui/SectionHeading.astro';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center mb-12">
      <SectionHeading>
        FAQ: вопросы из практики
        <p slot="subtitle" class="mt-4 text-slate-400">Ответы переписаны под наш тон, не копипаст из других обзоров.</p>
      </SectionHeading>
    </div>
    <div class="max-w-3xl mx-auto space-y-3">
      {items.map((item) => (
        <details class="group rounded-xl border border-white/[0.06] bg-white/[0.02] overflow-hidden">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left text-white font-medium">
            <span>{item.question}</span>
            <svg class="w-5 h-5 text-accent-400 shrink-0 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <div class="px-5 pb-4 text-slate-400 text-sm leading-relaxed border-t border-white/[0.04] pt-3">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
