---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/ui/CTAButton.astro';
---

<BaseLayout title="404 — Страница не найдена" description="Запрашиваемая страница не найдена." noindex={true}>
  <section class="py-24 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-8xl sm:text-9xl font-black font-mono text-cta-500 mb-4">404</p>
      <h1 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tighter mb-4">СТРАНИЦА НЕ НАЙДЕНА</h1>
      <p class="text-white/60 mb-8 max-w-md mx-auto">
        Запрашиваемая страница не существует или была перемещена. Воспользуйтесь навигацией или вернитесь на главную.
      </p>
      <CTAButton href="/" variant="secondary" size="lg">ВЕРНУТЬСЯ НА ГЛАВНУЮ</CTAButton>
    </div>
  </section>
</BaseLayout>
