---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import OverviewSection from '../components/sections/OverviewSection.astro';
import AdvantagesSection from '../components/sections/AdvantagesSection.astro';
import PaymentsSection from '../components/sections/PaymentsSection.astro';
import SportsSection from '../components/sections/SportsSection.astro';
import SlotsSection from '../components/sections/SlotsSection.astro';
import BonusSection from '../components/sections/BonusSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import CTASection from '../components/sections/CTASection.astro';

const title = '1xBet Россия — ставки на спорт и казино РУ 2026';
const description = 'Обзор 1xBet для Россия: ставки на КПЛ, казино, бонус до 32 500 ₽. Пополнение через Сбербанк в рубль.';
const canonical = 'https://1xbets.su/';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '1xBet Россия Обзор',
  url: canonical,
  description,
  inLanguage: 'ru',
  publisher: {
    '@type': 'Organization',
    name: '1xbets.su',
    url: canonical,
  },
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={schema}>
  <HeroSection />
  <OverviewSection />
  <BonusSection />
  <AdvantagesSection />
  <SportsSection />
  <PaymentsSection />
  <SlotsSection />
  <FAQSection />
  <CTASection />
</BaseLayout>
