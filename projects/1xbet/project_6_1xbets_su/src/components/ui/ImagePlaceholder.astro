---
interface Props {
  description: string;
  aspect?: string;
  class?: string;
}

const { description, aspect = '16/10', class: className = '' } = Astro.props;
const aspectCss = aspect.includes('/') ? aspect.replace('/', ' / ') : aspect;
---

<div
  class:list={['bg-surface-500 border-2 border-white/20 flex items-center justify-center w-full', className]}
  style={`aspect-ratio: ${aspectCss}`}
>
  <div class="text-center px-4">
    <svg
      class="w-10 h-10 mx-auto text-white/20 mb-2"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
    >
      <rect x="3" y="3" width="18" height="18"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
    </svg>
    <p class="text-xs text-white/30 max-w-52 font-mono">{description}</p>
  </div>
</div>
