---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const sports = [
  {
    title: 'ФУТБОЛ / РПЛ',
    desc: 'По данным обзоров, на матчи РПЛ (Зенит, Спартак, ЦСКА) доступно до 150 рынков. Маржа около 4-5%.',
    icon: '⚽',
  },
  {
    title: 'ХОККЕЙ / КХЛ',
    desc: 'Согласно отзывам, КХЛ — хорошо представлена в линии. Есть live-ставки и тоталы по периодам.',
    icon: '🏒',
  },
  {
    title: 'БОКС И MMA',
    desc: 'UFC и боксёрские поединки с широкой росписью, по данным из обзоров. Исходы, раунды, методы победы.',
    icon: '🥊',
  },
  {
    title: 'КИБЕРСПОРТ',
    desc: 'CS2, Dota 2, League of Legends — согласно отзывам, линия обновляется быстро. Есть live.',
    icon: '🎮',
  },
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>
      ИНФОРМАЦИЯ О СТАВКАХ НА СПОРТ
      <p slot="subtitle">По данным из открытых источников. 1 000+ live-событий ежедневно, согласно обзорам</p>
    </SectionHeading>

    <div class="grid md:grid-cols-2 gap-4 lg:gap-6">
      {
        sports.map((s) => (
          <Card>
            <div class="flex items-start gap-4">
              <span class="text-3xl" aria-hidden="true">{s.icon}</span>
              <div>
                <p class="text-sm font-mono font-bold text-white uppercase tracking-wider mb-2">{s.title}</p>
                <p class="text-sm text-white/60">{s.desc}</p>
              </div>
            </div>
          </Card>
        ))
      }
    </div>

    <div class="border-l-2 border-info-400 pl-4 py-2 text-sm text-white/50 mt-8">
      <p>💡 Данные о коэффициентах и росписи взяты из публичных обзоров. Актуальную линию уточняйте на официальном сайте оператора.</p>
    </div>
  </div>
</section>
