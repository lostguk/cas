---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const methods = [
  { method: 'Сбербанк / Тинькофф / Альфа-Банк', hint: 'Карты и переводы российских банков' },
  { method: 'СБП (Система быстрых платежей)', hint: 'Мгновенные переводы между банками РФ' },
  { method: 'Криптовалюта (USDT)', hint: 'TRC20, без комиссии платформы, 15-30 мин по данным обзоров' },
];

const rows = [
  ['Сбербанк', 'Мгновенно', '1-24 часа', '100 ₽'],
  ['Тинькофф', '5-15 мин', '1-24 часа', '100 ₽'],
  ['СБП', 'Мгновенно', '1-3 часа', '100 ₽'],
  ['USDT (TRC20)', '15-30 мин', '15-30 мин', '~500 ₽'],
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>
      ИНФОРМАЦИЯ О ПЛАТЕЖАХ
      <p slot="subtitle">Согласно отзывам пользователей из России</p>
    </SectionHeading>

    <div class="grid md:grid-cols-3 gap-4 lg:gap-6 mb-8">
      {
        methods.map((m) => (
          <Card>
            <p class="text-sm font-mono font-bold text-white uppercase tracking-wider mb-2">{m.method}</p>
            <p class="text-sm text-white/50">{m.hint}</p>
          </Card>
        ))
      }
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left border-2 border-white/10">
        <thead>
          <tr class="bg-surface-400 border-b-2 border-white/10">
            <th class="px-4 py-3 font-mono text-xs uppercase tracking-wider text-white/60">Метод</th>
            <th class="px-4 py-3 font-mono text-xs uppercase tracking-wider text-white/60">Пополнение</th>
            <th class="px-4 py-3 font-mono text-xs uppercase tracking-wider text-white/60">Вывод</th>
            <th class="px-4 py-3 font-mono text-xs uppercase tracking-wider text-white/60">Минимум</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-white/5 hover:bg-cta-500/5 transition-colors duration-100">
                <td class="px-4 py-3 font-mono text-white/80">{row[0]}</td>
                <td class="px-4 py-3 text-white/60">{row[1]}</td>
                <td class="px-4 py-3 text-white/60">{row[2]}</td>
                <td class="px-4 py-3 text-cta-400 font-mono">{row[3]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="border-l-2 border-info-400 pl-4 py-2 text-sm text-white/50 mt-8">
      <p>⚠️ Сроки и лимиты указаны по данным из открытых источников и могут отличаться. Мы не проводим финансовые операции. Актуальные условия уточняйте у оператора.</p>
    </div>
  </div>
</section>
