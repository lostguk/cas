---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const bonuses = [
  {
    type: 'СПОРТИВНЫЙ БОНУС',
    value: '100% до 32 500 ₽',
    condition: 'Вейджер ×5 на экспрессы с кэфом от 1.40, 30 дней на отыгрыш',
  },
  {
    type: 'КАЗИНО-БОНУС',
    value: '150 фриспинов',
    condition: 'Вейджер ×35 на казино, конкретные слоты от провайдера',
  },
  {
    type: 'ФРИБЕТ',
    value: 'Бесплатная ставка',
    condition: 'При выполнении условий первого депозита, по данным из обзоров',
  },
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>
      ОБЗОР БОНУСНОЙ ПРОГРАММЫ
      <p slot="subtitle">По данным из открытых источников</p>
    </SectionHeading>

    <div class="grid md:grid-cols-3 gap-4 lg:gap-6">
      {
        bonuses.map((b) => (
          <Card>
            <p class="text-xs font-mono text-cta-400 uppercase tracking-wider mb-3">{b.type}</p>
            <p class="text-2xl lg:text-3xl font-black text-white uppercase tracking-tight mb-4">{b.value}</p>
            <p class="text-sm text-white/50">{b.condition}</p>
          </Card>
        ))
      }
    </div>

    <div class="mt-6 text-center">
      <a href="/akcii" class="text-sm font-mono text-cta-400 border-b border-cta-500/40 hover:border-cta-500 transition-colors duration-100 uppercase">Подробнее о бонусах →</a>
    </div>

    <div class="border-l-2 border-info-400 pl-4 py-2 text-sm text-white/50 mt-8">
      <p>💡 Согласно отзывам, условия отыгрыша бонусов могут быть сложными. Рекомендуется внимательно ознакомиться с правилами на официальном сайте перед активацией любых предложений.</p>
    </div>
  </div>
</section>
