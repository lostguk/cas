---
import CTAButton from './ui/CTAButton.astro';

const affiliateLink = '#';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/sozdat-akkaunt', label: 'Регистрация' },
  { href: '/mobile-app', label: 'Приложение' },
  { href: '/onlajn-kazino', label: 'Казино' },
  { href: '/dostup', label: 'Доступ' },
  { href: '/akcii', label: 'Акции' },
  { href: '/about', label: 'О сайте' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface-400/95 backdrop-blur-sm border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <span class="w-8 h-8 bg-gradient-to-br from-cta-500 to-cta-700 block" aria-hidden="true"></span>
        <span class="font-mono font-bold text-white text-lg tracking-tight uppercase">1x<span class="text-cta-400">Bet</span></span>
      </a>

      <div class="flex items-center gap-3">
        <CTAButton href={affiliateLink} size="sm" external class="hidden sm:inline-flex">ПЕРЕЙТИ НА САЙТ</CTAButton>
        <button
          type="button"
          id="menu-toggle"
          class="p-2 border-2 border-white/20 text-white hover:bg-cta-500 hover:text-black hover:border-cta-500 transition-colors duration-100"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Открыть меню"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="square"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden border-t-2 border-white/10 py-4">
      <nav class="flex flex-col gap-1" aria-label="Меню навигации">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2.5 text-sm font-mono uppercase border-l-2 transition-colors duration-100',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-cta-400 border-cta-500 bg-cta-500/10'
                  : 'text-white/70 border-transparent hover:text-white hover:border-white/40',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <CTAButton href={affiliateLink} size="md" external class="mt-2 w-full">ПЕРЕЙТИ НА ПЛАТФОРМУ</CTAButton>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const open = !!(menu && !menu.classList.contains('hidden'));
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
