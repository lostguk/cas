---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  schema?: object;
  publishDate?: string;
  updateDate?: string;
}

const siteUrl = 'https://1xbet-stavki.kz';
const siteName = '1xbet-stavki.kz';

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = true,
  type = 'website',
  schema: extraSchema,
  publishDate,
  updateDate,
} = Astro.props;

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Арман Жумабаев',
  jobTitle: 'Автор обзоров казино и ставок',
  url: `${siteUrl}/about`,
  description:
    'Арман Жумабаев, 28 лет, Актобе. Пишу про ставки и казино с личной точки зрения, без корпоративной подачи.',
  nationality: { '@type': 'Country', name: 'Kazakhstan' },
};

const publisherSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: siteName,
  url: siteUrl,
};

let merged: object[] = [authorSchema, publisherSchema];

if (publishDate) {
  merged.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: publishDate,
    dateModified: updateDate ?? publishDate,
    author: { '@type': 'Person', name: 'Арман Жумабаев', url: `${siteUrl}/about` },
    publisher: { '@type': 'Organization', name: siteName, url: siteUrl },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical ?? Astro.url.href },
  });
}

if (extraSchema) {
  merged = merged.concat(Array.isArray(extraSchema) ? extraSchema : [extraSchema]);
}

const finalSchema = merged.length === 1 ? merged[0] : merged;
---

<!doctype html>
<html lang="ru">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      type={type}
      schema={finalSchema}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-black text-white font-sans">
    <Header />
    <main class="flex-1 pt-20 lg:pt-24">
      <slot />
    </main>
    <Footer />
  </body>
</html>
