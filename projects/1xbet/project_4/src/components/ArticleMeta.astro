---
interface Props {
  publishDate: string;
  updateDate: string;
}

const { publishDate, updateDate } = Astro.props;

const months = [
  'января',
  'февраля',
  'марта',
  'апреля',
  'мая',
  'июня',
  'июля',
  'августа',
  'сентября',
  'октября',
  'ноября',
  'декабря',
];

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
};
---

<div class="flex flex-wrap items-center gap-3 text-sm text-zinc-500 font-mono border-b-2 border-white/10 pb-6 mb-8">
  <span
    class="w-10 h-10 border-2 border-cta-500/40 flex items-center justify-center text-cta-400 font-bold text-xs shrink-0"
    aria-hidden="true"
  >
    АЖ
  </span>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <a href="/about" class="text-cta-400 hover:text-cta-300 uppercase tracking-wide">Арман Жумабаев</a>
    <span class="text-zinc-600">|</span>
    <time datetime={publishDate}>опубликовано {formatDate(publishDate)}</time>
    <span class="text-zinc-600">|</span>
    <time datetime={updateDate}>обновлено {formatDate(updateDate)}</time>
  </div>
</div>
