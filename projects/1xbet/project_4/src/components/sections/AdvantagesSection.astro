---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const items = [
  {
    title: 'Линия и кэфы',
    plus: 'Много видов спорта, маржа терпимая 3-5% на футбол.',
    minus: 'На КПЛ роспись беднее чем на АПЛ, это факт а не обида.',
  },
  {
    title: 'Тенге и банки',
    plus: 'Kaspi, Halyk, Jusan — без конвертации в доллары.',
    minus: 'Иногда Kaspi режет платёж, перезалил на следующий день — зашло.',
  },
  {
    title: 'Апк',
    plus: 'Весит около сорока мегов, ставлю с телефона в дороге.',
    minus: 'В Google Play нет, обновлять вручную, лень но привыкаешь.',
  },
  {
    title: 'Каззино',
    plus: 'Куча провайдеров, Pragmatic, NetEnt, Play n GO — залипнуть легко.',
    minus: 'Вейджер на казино ×35, я бы сказал жесть если ты новичок.',
  },
  {
    title: 'Бонусы',
    plus: 'Цифры красивые на баннере до 220к и фриспины.',
    minus: 'Отыгрыш долгий, я брал и пару раз слил пока дотянул условия.',
  },
  {
    title: 'Поддержка',
    plus: 'Чат круглосуточно, на русском отвечают.',
    minus: 'Шаблоны шлют, надо писать «соедините с оператором» и тогда живее.',
  },
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Честная оценка плюсы и минусы</SectionHeading>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {items.map((item) => (
        <Card>
          <h3 class="font-mono text-sm uppercase text-cta-400 mb-4 border-b-2 border-white/10 pb-2">{item.title}</h3>
          <p class="text-sm text-zinc-300 mb-3">
            <span class="text-cta-500 font-mono text-xs uppercase">+ </span>
            {item.plus}
          </p>
          <p class="text-sm text-zinc-500">
            <span class="text-zinc-600 font-mono text-xs uppercase">− </span>
            {item.minus}
          </p>
        </Card>
      ))}
    </div>
  </div>
</section>
