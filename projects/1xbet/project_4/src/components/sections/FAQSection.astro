---
import SectionHeading from '../ui/SectionHeading.astro';

const faqItems = [
  {
    q: 'Нужен ли ИИН для создания аккаунта?',
    a: 'Для регистрации часто хватает телефона и почты, но верифкация потом всё равно попросит документы и ИИН если выводишь нормальные суммы.',
  },
  {
    q: 'Можно ли пополнить через USDT?',
    a: 'Да, TRC20 у меня проходил за 20 минут в среднем, комиссия сети отдельно — не путай с комиссией конторы.',
  },
  {
    q: 'Работает ли приложение без интернета?',
    a: 'Нет, это не офлайн-игра, без сети ты даже баланс не увидишь, логично же.',
  },
  {
    q: 'Какой VPN лучше для Казахстана?',
    a: 'Я не рекламирую бренды, бери платный с нормальными отзывами и kill-switch, бесплатные часто режут скорость в лайве.',
  },
  {
    q: 'Как активировать фриспины?',
    a: 'Обычно после депозита заходишь в акции или в конкретный слот, там кнопка «активировать» — если не видишь, пинай поддержку в чате.',
  },
  {
    q: 'Есть ли ставки на киберспорт?',
    a: 'Есть, от Dota до Valorant, кэфы на топ-турниры норм, на тир-3 матчи маржа выше — я такое реже трогаю.',
  },
  {
    q: 'Можно ли купить бонусную игру в слоте?',
    a: 'В части слотов Pragmatic и других есть buy bonus, списывают сразу кусок баланса — я пару раз купил и слил, ну то есть не везёт всегда.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Частые вопросы</SectionHeading>
    <div class="max-w-3xl mx-auto space-y-3">
      {faqItems.map((item) => (
        <details class="group border-2 border-white/15 bg-surface-950 open:border-cta-500/40">
          <summary class="flex cursor-pointer items-center justify-between gap-4 p-4 font-mono text-sm uppercase text-white list-none">
            <span>{item.q}</span>
            <svg
              class="w-5 h-5 text-cta-500 shrink-0 transition-transform group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </summary>
          <div class="px-4 pb-4 text-sm text-zinc-400 leading-relaxed border-t-2 border-white/10 pt-4">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
