---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import CTAButton from '../ui/CTAButton.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';

const cards = [
  {
    type: 'Спорт',
    value: '100% до 220 000 ₸',
    condition: 'Вейджер ×5 на спорт / ×35 на казино, 30 дней — читай мелкий шрифт.',
  },
  {
    type: 'Казино',
    value: '150 фриспинов',
    condition: 'Слоты ограничены списком, не жди что выберешь любой автомат.',
  },
  {
    type: 'Фрибет',
    value: 'Бесплатная ставка',
    condition: 'Подвязано к первому депозиту и акциям, «просто так» редко.',
  },
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Бонусы — что дают на старте</SectionHeading>
    <div class="grid lg:grid-cols-5 gap-8 items-start">
      <div class="lg:col-span-2">
        <ImagePlaceholder
          description="Промо-блок: лаймовые акценты, цифры бонуса и условия мелким шрифтом"
          aspect="4/5"
          class="max-w-md"
        />
      </div>
      <div class="lg:col-span-3 grid gap-4">
        {cards.map((c) => (
          <Card>
            <p class="font-mono text-xs uppercase text-cta-500 mb-2">{c.type}</p>
            <p class="text-xl font-black uppercase text-white mb-3">{c.value}</p>
            <p class="text-sm text-zinc-400 leading-relaxed">{c.condition}</p>
          </Card>
        ))}
        <p class="text-sm text-zinc-500 font-mono">
          Бонусс не зря с двумя «с» иногда пишу — так у меня в черновике висело, ладно шучу, опечатка была.
          Короче отыгрыш жёсткий, если ты только ради слотов — готовься к ×35 на казино.
        </p>
        <div>
          <CTAButton href="/privetstvennye-bonusy" variant="outline" size="md">Все условия бонусов</CTAButton>
        </div>
      </div>
    </div>
  </div>
</section>
