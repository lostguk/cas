---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';
---

<section class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-2 border-cta-500/50 bg-surface-950 p-10 lg:p-14 text-center">
      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-4">
        Попробуй 1xBet сам
      </h2>
      <p class="text-zinc-400 max-w-xl mx-auto mb-8 font-mono text-sm leading-relaxed">
        Если дочитал до сюда — заходи по кнопке, проверяй бонусы на официальной странице, я мог тупануть в цифрах.
      </p>
      <CTAButton href={affiliateLink} size="lg" external>Не откладывайте</CTAButton>
