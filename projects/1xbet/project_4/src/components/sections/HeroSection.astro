---
import CTAButton from '../ui/CTAButton.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';
---

<section class="relative border-b-2 border-white/10 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div>
        <p
          class="inline-block font-mono text-xs uppercase tracking-widest border-2 border-cta-500 text-cta-400 px-3 py-1 mb-6"
        >
          1 000+ live · личный обзор
        </p>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black uppercase tracking-tighter text-white leading-[1.05] mb-6">
          1xBet Казахстан — ставки + казино для игроков из KZ
        </h1>
        <p class="text-lg text-zinc-400 mb-8 max-w-xl leading-relaxed">
          Я сам с Актобе, кручу слоты и иногда лезу в лайв на футбол. Тут мой взгляд на площадку, без канцелярита.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mb-10">
          <CTAButton href={affiliateLink} size="lg" external>Забрать бонус на старте</CTAButton>
          <CTAButton href="/nachalo-raboty" variant="secondary" size="lg">Ставить на КПЛ</CTAButton>
        </div>
        <div class="grid grid-cols-3 gap-4 border-2 border-white/15 p-4">
          <div>
            <p class="font-mono text-xl sm:text-2xl font-bold text-cta-500">50+</p>
            <p class="text-xs font-mono uppercase text-zinc-500 mt-1">видов спорта</p>
          </div>
          <div>
            <p class="font-mono text-xl sm:text-2xl font-bold text-cta-500">1 000 ₸</p>
            <p class="text-xs font-mono uppercase text-zinc-500 mt-1">мин. депозит</p>
          </div>
          <div>
            <p class="font-mono text-xl sm:text-2xl font-bold text-cta-500">100%</p>
            <p class="text-xs font-mono uppercase text-zinc-500 mt-1">на первый деп</p>
          </div>
        </div>
      </div>
      <div>
        <ImagePlaceholder description="Стадион ночью: зелёное поле и софиты" aspect="16/10" />
      </div>
    </div>
  </div>
</section>
