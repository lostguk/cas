---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const methods = [
  {
    title: 'Kaspi / Halyk / Jusan',
    desc: 'Банковские карты казахстанских банков — мгновенное пополнение, вывод от пары часов до суток.',
  },
  {
    title: 'Криптовалюта USDT',
    desc: 'Сеть TRC20, комиссия минимальная. Зачисление за 15–30 минут, вывод такой же быстрый.',
  },
  {
    title: 'Электронные кошельки',
    desc: 'Skrill, Neteller и другие. Работают стабильно, но для казахстанцев менее привычный вариант.',
  },
];

const tableRows = [
  { method: 'Kaspi Gold', deposit: 'мгновенно', withdrawal: '1–24 ч', min: '1 000 ₸' },
  { method: 'Halyk', deposit: '5–15 мин', withdrawal: '1–3 дня', min: '1 000 ₸' },
  { method: 'USDT TRC20', deposit: '15–30 мин', withdrawal: '15–30 мин', min: '~3 000 ₸' },
];
---

<section id="payments" class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading class="mb-12">Как закинуть и вывести деньги</SectionHeading>

    <div class="grid md:grid-cols-3 gap-6">
      {methods.map((m) => (
        <Card class="border-2 border-white">
          <h3 class="font-mono text-lg font-bold text-brand-400 uppercase tracking-wider mb-3">{m.title}</h3>
          <p class="text-slate-300 text-sm leading-relaxed">{m.desc}</p>
        </Card>
      ))}
    </div>

    <div class="mt-12 overflow-x-auto">
      <table class="w-full border-2 border-white text-sm">
        <thead>
          <tr>
            <th class="border-2 border-white px-4 py-3 text-left font-mono text-xs uppercase tracking-wider text-brand-400 bg-bg-900">Метод</th>
            <th class="border-2 border-white px-4 py-3 text-left font-mono text-xs uppercase tracking-wider text-brand-400 bg-bg-900">Пополнение</th>
            <th class="border-2 border-white px-4 py-3 text-left font-mono text-xs uppercase tracking-wider text-brand-400 bg-bg-900">Вывод</th>
            <th class="border-2 border-white px-4 py-3 text-left font-mono text-xs uppercase tracking-wider text-brand-400 bg-bg-900">Минимум</th>
          </tr>
        </thead>
        <tbody>
          {tableRows.map((r) => (
            <tr>
              <td class="border-2 border-white px-4 py-3 font-medium text-white">{r.method}</td>
              <td class="border-2 border-white px-4 py-3 text-slate-300">{r.deposit}</td>
              <td class="border-2 border-white px-4 py-3 text-slate-300">{r.withdrawal}</td>
              <td class="border-2 border-white px-4 py-3 text-slate-300 font-mono">{r.min}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-10 max-w-3xl text-slate-300 leading-relaxed">
      <p>
        Тут три рабочих варианта, которые я сам использую. Kaspi Gold — самый удобный способ для казахстанцев, закинул тенге — и через секунды уже на балансе конторы. С выводом тоже нормально: последний раз скинул 15 000 ₸ в пятницу вечером, пришли в субботу до обеда. Крипта USDT через сеть TRC20 — для тех кто шарит, комиссия копеечная и по скорости вообще без вопросов. Электронные кошельки тоже работают, но лично мне хватает Kaspi на все случаи. Halyk иногда тупит — было что ждал вывод почти три дня, но это скорее исключение.
      </p>
    </div>
  </div>
</section>
