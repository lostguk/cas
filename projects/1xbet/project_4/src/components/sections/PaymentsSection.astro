---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const methods = [
  { method: 'Kaspi / Halyk / Jusan', hint: 'Карты и переводы по KZ, самый понятный путь.' },
  { method: 'USDT TRC20', hint: 'Крипта без лишней комиссии на стороне конторы, жди 15-30 мин.' },
  { method: 'Кошельки', hint: 'QIWI и прочее ещё живо но я реже, дольше иногда.' },
];

const rows = [
  ['Kaspi Gold', 'Мгновенно', '1-24 часа', '1 000 ₸'],
  ['Halyk Homebank', '5-15 мин', '1-3 дня', '1 000 ₸'],
  ['USDT (TRC20)', '15-30 мин', '15-30 мин', '~3 000 ₸'],
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Платежи методы и сроки</SectionHeading>
    <div class="grid lg:grid-cols-3 gap-6 mb-12">
      {methods.map((m) => (
        <Card>
          <h3 class="font-mono text-sm uppercase text-white mb-2">{m.method}</h3>
          <p class="text-sm text-zinc-400">{m.hint}</p>
        </Card>
      ))}
    </div>
    <div class="grid lg:grid-cols-2 gap-8 items-start">
      <ImagePlaceholder
        description="Платёжные логотипы: карты Kaspi, иконки банков KZ, строка USDT"
        aspect="16/10"
      />
      <div class="overflow-x-auto border-2 border-white/20">
        <table class="w-full text-sm font-mono">
          <thead>
            <tr class="border-b-2 border-white/20 text-left text-cta-500 uppercase text-xs">
              <th class="p-3">Метод</th>
              <th class="p-3">Пополнение</th>
              <th class="p-3">Вывод</th>
              <th class="p-3">Минимум</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr class="border-b border-white/10 text-zinc-300 hover:bg-white/[0.03]">
                {row.map((cell) => (
                  <td class="p-3">{cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-8 text-sm text-zinc-500 max-w-2xl leading-relaxed">
      Выводил на Kaspi где-то за полдня, другой раз сутки — зависит от антифрода и загрузки.
      Тенеге на счёте держу отдельно от «живых» денег чтобы не тупить.
    </p>
  </div>
</section>
