---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import CTAButton from '../ui/CTAButton.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const slots = [
  {
    slug: '/book-of-dead',
    name: 'Book of Dead',
    provider: "Play'n GO",
    rtp: '96.21%',
    maxWin: '×5 000',
    desc: 'Классика Египта, книга разбрасывает символы — я в минус уходил и в плюс, волатильность злая но интересно.',
    cta: 'Крутить с фриспинами',
    placeholder: 'Слот Book of Dead: египетская тема, фараоны и пирамиды',
  },
  {
    slug: '/fruit-party',
    name: 'Fruit Party',
    provider: 'Pragmatic Play',
    rtp: '96.47%',
    maxWin: '×5 000',
    desc: 'Фрукты и каскады, визуально ярко, иногда подтормаживть на старом телефоне но терпимо.',
    cta: 'Играть с бонусом',
    placeholder: 'Слот Fruit Party: фруктовая сетка и каскадные множители',
  },
  {
    slug: '/starlight-princess',
    name: 'Starlight Princess',
    provider: 'Pragmatic Play',
    rtp: '96.50%',
    maxWin: '×5 000',
    desc: 'Аниме-стиль, множители падают как снег, я люблю когда шумно на экране.',
    cta: 'Испытать удачу',
    placeholder: 'Слот Starlight Princess: аниме-принцесса и множители',
  },
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10 bg-surface-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Топ слотов что крутить</SectionHeading>
    <div class="grid md:grid-cols-3 gap-6">
      {slots.map((s) => (
        <Card>
          <ImagePlaceholder description={s.placeholder} aspect="16/10" class="mb-4" />
          <p class="font-mono text-xs text-info-400 uppercase mb-1">{s.provider}</p>
          <h3 class="text-lg font-black uppercase text-white mb-2">{s.name}</h3>
          <p class="text-sm text-zinc-400 mb-4 leading-relaxed">{s.desc}</p>
          <p class="font-mono text-xs text-zinc-500 mb-4">
            RTP {s.rtp} · макс {s.maxWin}
          </p>
          <CTAButton href={s.slug} variant="outline" size="sm">
            {s.cta}
          </CTAButton>
        </Card>
      ))}
    </div>
    <p class="text-center mt-8 text-sm text-zinc-500 font-mono">
      Все три проверял на реале и на демо, в демо всегда везёт — это ловушка психологии.
    </p>
  </div>
</section>
