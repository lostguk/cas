---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const cards = [
  {
    title: 'Футбол и КПЛ',
    body: 'Роспись на топ-чемпионаты толще чем на наши матчи, маржа где-то 4-5%, в лайве кэфы прыгают — следи за глазами.',
  },
  {
    title: 'Теннис',
    body: 'Большой теннис люблю за скорость сетов, в лайве можно поймать косяк линии если смотришь трансляцию, не всегда но бывает.',
  },
  {
    title: 'Киберспорт',
    body: 'Dota, CS — кто в теме тот понимает, я иногда залетаю на мейджоры, кэфы скачут от одного хедшота.',
  },
  {
    title: 'Баскетбол',
    body: 'NBA четверти летают быстрее чем я успеваю жрать пельмени, тоталы и форы норм, маржа средняя.',
  },
];
---

<section class="py-16 lg:py-24 border-b-2 border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Виды спорта — куда я ставлю</SectionHeading>
    <p class="max-w-3xl mx-auto text-center text-zinc-400 mb-10 font-mono text-sm leading-relaxed">
      Линия широкая, кэфы не всегда топ но и не позор, в лайве зависаю чаще чем в приквеле сериала.
    </p>
    <div class="grid lg:grid-cols-2 gap-8 mb-10">
      <ImagePlaceholder description="Стадион ночью: зелёное поле и софиты" aspect="16/10" />
      <div class="grid sm:grid-cols-2 gap-4">
        {cards.map((c) => (
          <Card>
            <svg
              class="w-10 h-10 text-cta-500 mb-3 border-2 border-white/20 p-2"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 3v18M3 12h18" />
            </svg>
            <h3 class="font-mono text-sm uppercase font-bold text-white mb-2">{c.title}</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">{c.body}</p>
          </Card>
        ))}
      </div>
    </div>
  </div>
</section>
