---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const siteUrl = 'https://1xbet-stavki.kz';
const currentPageUrl = Astro.url.href;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href ? new URL(item.href, siteUrl).href : currentPageUrl,
  })),
};
---

<nav aria-label="Навигация по разделам" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
  <ol class="flex flex-wrap items-center gap-2 text-xs font-mono uppercase text-zinc-500">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && (
          <svg class="w-3 h-3 text-cta-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="m9 18 6-6-6-6" />
          </svg>
        )}
        {item.href ? (
          <a href={item.href} class="text-zinc-400 hover:text-cta-400 border-b border-transparent hover:border-cta-500">
            {item.label}
          </a>
        ) : (
          <span class="text-white">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
