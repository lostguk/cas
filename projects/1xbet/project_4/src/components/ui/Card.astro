---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'border-2 border-white/15 bg-surface-950 p-6 lg:p-8',
    hover && 'hover:border-cta-500/40 transition-colors duration-100',
    className,
  ]}
>
  <slot />
</div>
