---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'px-5 py-2 text-xs',
  md: 'px-8 py-3 text-sm',
  lg: 'px-10 py-4 text-base',
};

const variantClasses = {
  primary: 'bg-brand-500 text-black border-2 border-brand-500 hover:bg-black hover:text-brand-400',
  secondary: 'bg-transparent text-white border-2 border-white hover:bg-white hover:text-black',
  outline: 'bg-transparent text-brand-400 border-2 border-brand-500 hover:bg-brand-500 hover:text-black',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center font-mono font-bold uppercase tracking-wider transition-colors duration-100',
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
