---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Об авторе — Арман Жумабаев',
  url: 'https://1xbet-stavki.kz/about',
};
---

<BaseLayout
  title="Обзор 1xBet Казахстан — кто автор и зачем этот сайт"
  description="Об авторе обзора 1xBet KZ: кто я, зачем этот сайт, как тестирую. Прозрачно о партнёрских ссылках."
  schema={aboutSchema}
  publishDate="2026-01-10"
  updateDate="2026-04-03"
  type="article"
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Об авторе' }]} />
  <section class="py-10 lg:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <ArticleMeta publishDate="2026-01-10" updateDate="2026-04-03" />
    <div class="text-center mb-10 border-b-2 border-white/10 pb-10">
      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tighter text-white mb-4">
        Об авторе — кто стоит за обзором 1xBet
      </h1>
      <p class="text-zinc-400 font-mono text-sm max-w-2xl mx-auto">
        Коротко и по делу, без выдуманных наград и фото с псевдо-офиса.
      </p>
    </div>

    <div class="mb-10 max-w-md mx-auto">
      <ImagePlaceholder
        description="Портрет автора: стилизованный силуэт, Актобе, неформальный стиль"
        aspect="1/1"
      />
    </div>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Кто я</h2>
    <p class="text-zinc-300 leading-relaxed mb-6">
      Арман Жумабаев, 28, Актобе, в ставках и слотах ковыряюсь с двадцатого года если не путаю даты.
      Работаю не в букмекерской конторе, я обычный чел который любит адреналин и иногда выигрывает иногда подтормаживть кошелёк.
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Зачем этот сайт</h2>
    <p class="text-zinc-300 leading-relaxed mb-6">
      Писал заметки для себя, потом решил выложить публично — мол если кому сэкономлю время на косяках, то гуд.
      Тон разговорный, мне так проще чем «уважаемый пользователь».
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Как тестирую</h2>
    <p class="text-zinc-300 leading-relaxed mb-6">
      Реальные депозиты, реальные выводы, не сижу только на демо и не переписываю чужие обзоры слово в слово.
      Могу ошибиться в цифре — человек я, не бот, если видишь косяк напиши куда-нибудь где смогу прочитать.
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Про честность</h2>
    <p class="text-zinc-300 leading-relaxed mb-6">
      Ссылки на 1xBet партнёрские, если зарегистрируешься я могу получить копейку, на текст это влияет меньше чем на моё желание не выглядеть идиотом перед друзьями.
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Предупреждение</h2>
    <p class="text-zinc-300 leading-relaxed mb-10">
      21+, играй ответственно, одолжил у друга на «отыграю» — путь в никуда, я такое видел.
    </p>

    <p class="text-sm font-mono text-zinc-500 mb-10">
      <a href="/starlight-princess" class="text-cta-400 border-b border-cta-500">Starlight Princess</a>
      ·
      <a href="/fruit-party" class="text-cta-400 border-b border-cta-500">Fruit Party</a>
      ·
      <a href="/nachalo-raboty" class="text-cta-400 border-b border-cta-500">Старт</a>
    </p>

    <div class="border-2 border-white/20 p-8 text-center">
      <CTAButton href={affiliateLink} size="lg" external>Перейти на 1xBet</CTAButton>
    </div>
  </section>
</BaseLayout>
