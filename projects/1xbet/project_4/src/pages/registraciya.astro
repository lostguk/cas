---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';
import { Image } from 'astro:assets';
import registerImg from '../assets/images/register-visual.png';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как зарегистрироваться на 1xBet в Казахстане',
  description: 'Пошаговая инструкция по регистрации аккаунта на букмекерской платформе с бонусом на первый депозит.',
  totalTime: 'PT2M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'KZT',
    value: '0',
  },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'В один клик',
      text: 'Выберите страну и валюту, нажмите «Зарегистрироваться». Логин и пароль генерируются автоматически.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'По номеру телефона',
      text: 'Введите казахстанский номер, получите SMS-код и подтвердите аккаунт.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'По электронной почте',
      text: 'Заполните форму с email, паролем и личными данными. Подтвердите адрес через письмо.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Через соцсети',
      text: 'Авторизуйтесь через Telegram, Google или другие сервисы — данные подтянутся автоматически.',
    },
  ],
};
---

<BaseLayout
  title="Регистрация 1xBet: 4 способа + бонус на первый депозит"
  description="Регистрация 1xBet за 2 минуты — пошагово. Аккаунт в тенге, бонус на старте, верификация через ИИН."
  schema={schema}
  publishDate="2026-01-15"
  updateDate="2026-03-20"
>
  <Breadcrumbs items={[
    { label: 'Главная', href: '/' },
    { label: 'Регистрация' },
  ]} />

  <ArticleMeta publishDate="2026-01-15" updateDate="2026-03-20" />

  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tighter leading-none text-white mb-8">
        Как зарегистрироваться на 1xBet в&nbsp;Казахстане
      </h1>

      <div class="border-2 border-brand-500 overflow-hidden mb-10">
        <Image
          src={registerImg}
          alt="Процесс регистрации на платформе в Казахстане"
          class="w-full"
          widths={[400, 640, 1024]}
          sizes="(max-width: 1024px) 100vw, 896px"
        />
      </div>

      <p class="text-zinc-300 text-lg leading-relaxed mb-8">
        Привет, это Арман из Актобе. Я зарегался на 1xBet ещё в 2020-м — тогда потратил минут десять, потому что тупо не знал, какой способ выбрать. Сейчас платформа даёт четыре варианта, и каждый занимает от силы пару минут. Рассказываю по порядку, чтобы ты не повторял мои ошибки и сразу забрал бонус на старте.
      </p>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        4 способа создать аккаунт
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <Card class="border-2 border-brand-500/40">
          <span class="inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold mb-3">
            1
          </span>
          <h3 class="font-mono text-white text-lg font-bold uppercase tracking-tight mb-2">В один клик</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Самый быстрый путь. Выбираешь страну — Казахстан, валюту — тенге, жмёшь кнопку. Система сама генерирует логин и пароль. Я рекомендую сразу сохранить данные в заметках телефона, потому что потерять их проще простого.
          </p>
        </Card>

        <Card class="border-2 border-brand-500/40">
          <span class="inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold mb-3">
            2
          </span>
          <h3 class="font-mono text-white text-lg font-bold uppercase tracking-tight mb-2">По номеру телефона</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Вводишь казахстанский номер, получаешь SMS-код и подтверждаешь. Удобно — потом через этот же номер можно восстановить доступ. Лично у меня код пришёл секунд за пять, никаких задержек.
          </p>
        </Card>

        <Card class="border-2 border-brand-500/40">
          <span class="inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold mb-3">
            3
          </span>
          <h3 class="font-mono text-white text-lg font-bold uppercase tracking-tight mb-2">По электронной почте</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Тут заполняешь полную форму — email, пароль, имя, фамилия, дата рождения. Дольше всего, зато сразу привязываешь почту и не придётся делать это позже при верификации. Письмо с подтверждением приходит на ящик.
          </p>
        </Card>

        <Card class="border-2 border-brand-500/40">
          <span class="inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold mb-3">
            4
          </span>
          <h3 class="font-mono text-white text-lg font-bold uppercase tracking-tight mb-2">Через соцсети</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Telegram, Google, Apple ID — выбираешь сервис, даёшь разрешение, и аккаунт готов. Данные подтягиваются автоматически. Мой друг из Караганды заходит именно так — говорит, меньше всего мороки.
          </p>
        </Card>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Бонус при регистрации
      </h2>

      <div class="border-l-4 border-brand-500 pl-6 mb-10">
        <p class="text-zinc-300 leading-relaxed mb-4">
          Сразу после создания аккаунта букмекер предлагает приветственный пакет — до 220 000 тенге на первое пополнение. Механика простая: сколько закинешь, столько и получишь сверху. Максимальный потолок — те самые 220 тысяч. Подробнее про условия и отыгрыш я расписал на <a href="/bonus" class="text-brand-400 hover:text-brand-300 border-b border-brand-500/50">странице бонусов</a>.
        </p>
        <p class="text-zinc-400 text-sm">
          Если регистрируешься через промокод, бонус может быть увеличен. Но я обычно захожу по прямой ссылке — так надёжнее, проверено на личном опыте.
        </p>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Верификация через ИИН
      </h2>

      <p class="text-zinc-300 leading-relaxed mb-4">
        После регистрации платформа попросит пройти верификацию. Понадобится фото удостоверения личности и ИИН. Процесс занимает от нескольких часов до суток — у меня подтвердили за четыре часа в будний день. Без верификации вывод средств заблокирован, поэтому лучше не откладывать.
      </p>

      <p class="text-zinc-300 leading-relaxed mb-10">
        Если столкнёшься с блокировкой доступа — загляни в <a href="/zerkalo" class="text-brand-400 hover:text-brand-300 border-b border-brand-500/50">раздел про зеркала</a>, там я собрал рабочие способы обхода. А мобильное приложение можно <a href="/skachat" class="text-brand-400 hover:text-brand-300 border-b border-brand-500/50">скачать здесь</a> — оно работает стабильнее, чем сайт через браузер.
      </p>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Плюсы и минусы — честно
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
        <div class="border-2 border-brand-500 p-6">
          <p class="font-mono text-brand-400 text-sm uppercase tracking-wider mb-4">Плюсы</p>
          <ul class="space-y-2 text-zinc-300 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-brand-400 mt-0.5">+</span>
              <span>Четыре способа — выбирай удобный</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-400 mt-0.5">+</span>
              <span>Аккаунт сразу в тенге</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-400 mt-0.5">+</span>
              <span>Бонус активируется автоматически</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-brand-400 mt-0.5">+</span>
              <span>Регистрация за две минуты</span>
            </li>
          </ul>
        </div>

        <div class="border-2 border-bg-700 p-6">
          <p class="font-mono text-zinc-500 text-sm uppercase tracking-wider mb-4">Минусы</p>
          <ul class="space-y-2 text-zinc-400 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-zinc-600 mt-0.5">−</span>
              <span>Верификация обязательна для вывода</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-zinc-600 mt-0.5">−</span>
              <span>При регистрации «в один клик» легко потерять данные</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-zinc-600 mt-0.5">−</span>
              <span>Без VPN или приложения сайт иногда недоступен</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="border-2 border-brand-500 bg-bg-900 p-8 text-center">
        <p class="font-mono text-brand-400 text-sm uppercase tracking-wider mb-3">Готов начать?</p>
        <p class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight mb-6">
          Забери приветственный пакет до 220 000 ₸
        </p>
        <CTAButton href={affiliateLink} variant="primary" size="lg" external>
          Забрать бонус на старте
        </CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
