---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import { Image } from 'astro:assets';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';
import appImg from '../assets/images/app-phone.png';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как скачать и установить приложение 1xBet на Android',
  description: 'Пошаговая инструкция по установке APK-файла букмекера на Android-устройство за 1 минуту.',
  totalTime: 'PT1M',
  supply: [],
  tool: [
    { '@type': 'HowToTool', name: 'Смартфон на Android 6.0 или выше' },
  ],
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Открой сайт букмекера',
      text: 'Перейди на официальный сайт или рабочее зеркало через мобильный браузер.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Скачай APK-файл',
      text: 'Найди раздел «Мобильное приложение» и нажми кнопку загрузки для Android. Файл весит около 40 МБ.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Разреши установку из неизвестных источников',
      text: 'В настройках Android перейди в раздел безопасности и включи установку из неизвестных источников для браузера.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Установи и запусти',
      text: 'Открой скачанный APK-файл, нажми «Установить» и дождись завершения. Через 30 секунд приложение готово.',
    },
  ],
};
---

<BaseLayout
  title="Приложение 1xBet: APK 40 МБ + установка за 1 минуту"
  description="1xBet приложение для Android и iOS — скачать бесплатно. APK 40 МБ, ставки и казино с телефона."
  type="article"
  schema={howToSchema}
  publishDate="2026-01-22"
  updateDate="2026-03-18"
>
  <Breadcrumbs items={[
    { label: 'Главная', href: '/' },
    { label: 'Скачать' },
  ]} />

  <article class="pb-16 lg:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white uppercase tracking-tighter leading-none mb-6">
        Скачать 1xBet — APK для Android и iPhone
      </h1>
    </div>

    <ArticleMeta publishDate="2026-01-22" updateDate="2026-03-18" />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-8 items-center mb-12">
        <div class="space-y-4 text-zinc-300 text-base sm:text-lg leading-relaxed">
          <p>
            Приложение 1xBet для смартфона — реально самый удобный способ делать ставки и крутить слоты с телефона. Весит APK-файл около 40 мегабайт, ставится за минуту, работает стабильно даже на бюджетных устройствах. Ниже — пошаговая инструкция для Android, отдельный блок для iPhone и мой личный отзыв после полугода использования.
          </p>
          <p>
            В Google Play приложение отсутствует — политика магазина запрещает букмекерский софт в большинстве регионов, и Казахстан не исключение. Поэтому APK качается напрямую с официального сайта конторы. Это абсолютно безопасно: файл подписан разработчиком, данные шифруются так же, как в браузерной версии.
          </p>
        </div>
        <div class="border-2 border-white p-4">
          <Image
            src={appImg}
            alt="Мобильное приложение букмекера на телефоне — интерфейс ставок"
            width={600}
            height={800}
            class="w-full h-auto"
            loading="eager"
            format="webp"
            quality={80}
          />
        </div>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tighter mb-8">
        Установка APK на Android — 4 шага
      </h2>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        <div class="border-2 border-brand-500 p-6">
          <span class="font-mono text-4xl font-bold text-brand-400/20 leading-none">01</span>
          <h3 class="text-base font-bold text-white uppercase tracking-tight mt-2 mb-2">Открой сайт</h3>
          <p class="text-sm text-zinc-400">
            Заходишь на официальный ресурс или <a href="/zerkalo" class="text-brand-400 underline hover:text-brand-300">рабочее зеркало</a> через Chrome или любой мобильный браузер.
          </p>
        </div>
        <div class="border-2 border-brand-500 p-6">
          <span class="font-mono text-4xl font-bold text-brand-400/20 leading-none">02</span>
          <h3 class="text-base font-bold text-white uppercase tracking-tight mt-2 mb-2">Скачай APK</h3>
          <p class="text-sm text-zinc-400">
            Найди раздел «Мобильное приложение» и нажми кнопку загрузки Android. Файл весит ~40 МБ — даже на 4G качается за секунды.
          </p>
        </div>
        <div class="border-2 border-brand-500 p-6">
          <span class="font-mono text-4xl font-bold text-brand-400/20 leading-none">03</span>
          <h3 class="text-base font-bold text-white uppercase tracking-tight mt-2 mb-2">Разреши установку</h3>
          <p class="text-sm text-zinc-400">
            Android покажет предупреждение — нажми «Настройки» и включи «Из неизвестных источников» для браузера. Стандартная процедура.
          </p>
        </div>
        <div class="border-2 border-brand-500 p-6">
          <span class="font-mono text-4xl font-bold text-brand-400/20 leading-none">04</span>
          <h3 class="text-base font-bold text-white uppercase tracking-tight mt-2 mb-2">Установи и войди</h3>
          <p class="text-sm text-zinc-400">
            Открой скачанный файл, нажми «Установить». Через 30 секунд приложение на рабочем столе. <a href="/registraciya" class="text-brand-400 underline hover:text-brand-300">Заходи или регистрируйся</a>.
          </p>
        </div>
      </div>

      <div class="space-y-6 text-zinc-300 text-base sm:text-lg leading-relaxed">
        <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tighter pt-6">
          Установка на iPhone и iPad
        </h2>

        <p>
          На iOS ситуация чуть сложнее — в App Store приложения букмекера нет по тем же причинам, что и в Google Play. Но платформа предлагает PWA-версию: открываешь сайт в Safari, нажимаешь «Поделиться» → «На экран Домой», и получаешь иконку, которая работает как нативное приложение. Полный функционал: ставки, казино, лайвы, push-уведомления. Обновляется автоматически.
        </p>

        <p>
          Если нужна именно нативная версия — периодически контора выкладывает IPA-файл для установки через TestFlight. Ссылку можно найти в разделе помощи на официальном ресурсе или запросить у техподдержки в чате. Процесс занимает две минуты и не требует джейлбрейка.
        </p>

        <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tighter pt-6">
          Системные требования
        </h2>
      </div>

      <div class="overflow-x-auto my-8">
        <table class="w-full text-sm border-2 border-white">
          <thead>
            <tr class="bg-bg-800">
              <th class="text-left font-mono uppercase tracking-wider text-brand-400 px-6 py-3 border-b-2 border-white">Параметр</th>
              <th class="text-left font-mono uppercase tracking-wider text-brand-400 px-6 py-3 border-b-2 border-white">Android</th>
              <th class="text-left font-mono uppercase tracking-wider text-brand-400 px-6 py-3 border-b-2 border-white">iOS</th>
            </tr>
          </thead>
          <tbody class="text-zinc-300">
            <tr class="border-b border-bg-700">
              <td class="px-6 py-3 font-medium text-white">Версия ОС</td>
              <td class="px-6 py-3">6.0+</td>
              <td class="px-6 py-3">14.0+</td>
            </tr>
            <tr class="border-b border-bg-700">
              <td class="px-6 py-3 font-medium text-white">Размер файла</td>
              <td class="px-6 py-3">~40 МБ</td>
              <td class="px-6 py-3">PWA / ~80 МБ</td>
            </tr>
            <tr class="border-b border-bg-700">
              <td class="px-6 py-3 font-medium text-white">Оперативная память</td>
              <td class="px-6 py-3">2 ГБ+</td>
              <td class="px-6 py-3">2 ГБ+</td>
            </tr>
            <tr class="border-b border-bg-700">
              <td class="px-6 py-3 font-medium text-white">Свободное место</td>
              <td class="px-6 py-3">100 МБ</td>
              <td class="px-6 py-3">150 МБ</td>
            </tr>
            <tr>
              <td class="px-6 py-3 font-medium text-white">Интернет</td>
              <td class="px-6 py-3">3G / Wi-Fi</td>
              <td class="px-6 py-3">3G / Wi-Fi</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="space-y-6 text-zinc-300 text-base sm:text-lg leading-relaxed">
        <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tighter pt-6">
          Обзор приложения — личный опыт
        </h2>

        <p>
          Пользуюсь приложением с конца 2024-го на Samsung Galaxy A54. За это время оно ни разу не вылетало на ставках, даже в лайве на популярных матчах КПЛ и Лиги Чемпионов. Интерфейс адаптирован под мобильный экран: линия читается нормально, коэффициенты обновляются в реальном времени, нет ощущения урезанной версии. Это полноценная площадка в кармане.
        </p>

        <p>
          По скорости — страницы грузятся заметно быстрее, чем через браузер. Батарею приложение расходует умеренно: час активных ставок в лайве забирает процентов 8-10, что для букмекерского софта нормально. Push-уведомления о результатах приходят моментально — ни один исход не пропустишь, даже если телефон в кармане.
        </p>

        <p>
          Раздел <a href="/casino" class="text-brand-400 underline hover:text-brand-300">казино</a> в приложении работает без ограничений: слоты, рулетка, лайв-дилеры — всё доступно. Pragmatic Play, Evolution, NetEnt и другие провайдеры загружаются корректно. Единственный минус — обновлять APK нужно вручную, автообновления через магазин нет. Зато новая версия выходит раз в месяц, и загрузить её занимает пару минут.
        </p>

        <div class="border-2 border-brand-500/30 bg-bg-950 p-6 mt-8">
          <p class="font-mono text-xs uppercase tracking-wider text-brand-400 mb-3">Совет</p>
          <p class="text-sm text-zinc-400">
            После установки сразу включи биометрическую авторизацию в настройках — вход по отпечатку пальца в разы быстрее пароля. И подпишись на push-уведомления, чтобы не пропускать результаты и промоакции.
          </p>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row items-center gap-4 mt-12 pt-8 border-t-2 border-bg-800">
        <CTAButton href={affiliateLink} variant="primary" size="lg" external>
          Скачать приложение бесплатно
        </CTAButton>
        <CTAButton href="/zerkalo" variant="outline" size="lg">
          Открыть через зеркало
        </CTAButton>
      </div>
    </div>
  </article>
</BaseLayout>
