---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';
import { Image } from 'astro:assets';
import bonusImg from '../assets/images/bonus-chest.png';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Бонусы 1xBet — приветственный пакет и акции',
  description: 'Бонусная программа 1xBet: до 220 000 ₸ на первый депозит. Условия, сроки, как не потерять бонус.',
  author: {
    '@type': 'Person',
    name: 'Арман Жумабаев',
  },
  datePublished: '2026-01-18',
  dateModified: '2026-03-25',
  inLanguage: 'ru',
};
---

<BaseLayout
  title="Какие бонусы даёт 1xBet? Полный гайд для KZ 2026"
  description="Бонусная программа 1xBet: до 220 000 ₸ на первый депозит. Условия, сроки, как не потерять бонус."
  schema={schema}
  publishDate="2026-01-18"
  updateDate="2026-03-25"
>
  <Breadcrumbs items={[
    { label: 'Главная', href: '/' },
    { label: 'Бонусы' },
  ]} />

  <ArticleMeta publishDate="2026-01-18" updateDate="2026-03-25" />

  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase tracking-tighter leading-none text-white mb-8">
        Бонусы 1xBet — приветственный пакет и&nbsp;акции
      </h1>

      <div class="border-2 border-brand-500 overflow-hidden mb-10">
        <Image
          src={bonusImg}
          alt="Бонусный сундук с приветственным пакетом"
          class="w-full"
          widths={[400, 640, 1024]}
          sizes="(max-width: 1024px) 100vw, 896px"
        />
      </div>

      <p class="text-zinc-300 text-lg leading-relaxed mb-4">
        Салам, это снова Арман. Бонусная система — первое, о чём спрашивают все, кто только приходит на платформу. Я разобрал каждое предложение по косточкам: что реально можно забрать, а где мелкий шрифт съедает всю выгоду. Без воды, только цифры и личный опыт за шесть лет.
      </p>

      <p class="text-zinc-300 leading-relaxed mb-10">
        Если у тебя ещё нет аккаунта — <a href="/registraciya" class="text-brand-400 hover:text-brand-300 border-b border-brand-500/50">зарегистрируйся за две минуты</a>, иначе бонус не активировать. Регистрация бесплатная, а приветственный пакет начисляется автоматически на первое пополнение.
      </p>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Приветственный бонус — до 220 000 ₸
      </h2>

      <div class="border-2 border-brand-500 bg-bg-900 p-6 sm:p-8 mb-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="text-center">
            <p class="font-mono text-brand-400 text-xs uppercase tracking-wider mb-2">Размер</p>
            <p class="text-3xl font-black text-white">100%</p>
            <p class="text-zinc-500 text-sm mt-1">от суммы депозита</p>
          </div>
          <div class="text-center">
            <p class="font-mono text-brand-400 text-xs uppercase tracking-wider mb-2">Потолок</p>
            <p class="text-3xl font-black text-white">220 000 ₸</p>
            <p class="text-zinc-500 text-sm mt-1">максимальный бонус</p>
          </div>
          <div class="text-center">
            <p class="font-mono text-brand-400 text-xs uppercase tracking-wider mb-2">Вейджер</p>
            <p class="text-3xl font-black text-white">×5</p>
            <p class="text-zinc-500 text-sm mt-1">на экспрессы</p>
          </div>
        </div>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Как получить бонус — пошагово
      </h2>

      <div class="space-y-4 mb-10">
        <div class="flex gap-4 items-start">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold">
            1
          </span>
          <div>
            <p class="text-white font-bold mb-1">Создай аккаунт</p>
            <p class="text-zinc-400 text-sm leading-relaxed">Выбери любой из четырёх способов регистрации. Главное — укажи валюту «тенге» и поставь галочку на участие в бонусной программе. Без этой галочки ничего не начислится.</p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold">
            2
          </span>
          <div>
            <p class="text-white font-bold mb-1">Пополни счёт</p>
            <p class="text-zinc-400 text-sm leading-relaxed">Минимальный депозит для активации — 500 тенге. Я обычно закидываю через Kaspi — моментально и без комиссий. Сумма бонуса равна сумме пополнения, но не больше 220 000 ₸.</p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold">
            3
          </span>
          <div>
            <p class="text-white font-bold mb-1">Отыграй вейджер</p>
            <p class="text-zinc-400 text-sm leading-relaxed">Сумму бонуса нужно поставить пять раз на экспрессы. Каждый экспресс — минимум три события, каждое с коэффициентом от 1.40. У тебя 30 дней на отыгрыш.</p>
          </div>
        </div>

        <div class="flex gap-4 items-start">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-10 h-10 border-2 border-brand-500 font-mono text-brand-400 text-lg font-bold">
            4
          </span>
          <div>
            <p class="text-white font-bold mb-1">Выведи выигрыш</p>
            <p class="text-zinc-400 text-sm leading-relaxed">После отыгрыша средства переходят на основной баланс — вывод без ограничений. Пройди верификацию заранее, чтобы не ждать при выводе.</p>
          </div>
        </div>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Казино-бонус — 150 фриспинов
      </h2>

      <Card class="border-2 border-brand-500/40 mb-10">
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <div class="flex-1">
            <p class="font-mono text-brand-400 text-sm uppercase tracking-wider mb-2">Бонус на слоты</p>
            <p class="text-xl font-black text-white mb-2">150 бесплатных вращений</p>
            <p class="text-zinc-400 text-sm leading-relaxed">
              Фриспины начисляются порциями после активации спортивного приветственного пакета. Вейджер — ×35, отыгрыш только на слотах. Срок действия — 24 часа с момента начисления каждой порции.
            </p>
          </div>
          <div class="flex-shrink-0 border-2 border-bg-700 px-6 py-4 text-center">
            <p class="font-mono text-zinc-500 text-xs uppercase tracking-wider">Вейджер</p>
            <p class="text-3xl font-black text-pop-400">×35</p>
          </div>
        </div>
      </Card>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Вейджер — разбираемся честно
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <div class="border-2 border-brand-500 p-6">
          <p class="font-mono text-brand-400 text-sm uppercase tracking-wider mb-3">Спортивный ×5</p>
          <p class="text-zinc-300 text-sm leading-relaxed mb-3">
            Реалистичный вейджер. Я отыгрывал два раза — оба раза уложился за полторы-две недели. Ставишь экспрессы на футбол и теннис, выбираешь фаворитов с коэффициентом 1.40–1.60 — математика работает.
          </p>
          <p class="font-mono text-brand-300 text-xs uppercase">Мой вердикт: реально</p>
        </div>

        <div class="border-2 border-bg-700 p-6">
          <p class="font-mono text-zinc-500 text-sm uppercase tracking-wider mb-3">Казино ×35</p>
          <p class="text-zinc-400 text-sm leading-relaxed mb-3">
            Тут всё значительно жёстче. Прокрутить выигрыш тридцать пять раз на слотах — задача со звёздочкой. Из двух попыток у меня сработала одна. Не рассчитывай на гарантированный профит — воспринимай как бесплатные вращения ради фана.
          </p>
          <p class="font-mono text-zinc-600 text-xs uppercase">Мой вердикт: сложно</p>
        </div>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Стоит ли брать бонус — моё мнение
      </h2>

      <div class="border-l-4 border-pop-500 pl-6 mb-10">
        <p class="text-zinc-300 leading-relaxed mb-4">
          Спортивный бонус — однозначно да. Вейджер ×5 при грамотных экспрессах отбивается почти всегда. Я бы рекомендовал не гнаться за максимумом: вместо 220 тысяч закинь комфортную для себя сумму. Если потеряешь — не жалко, если отыграешь — приятный плюс.
        </p>
        <p class="text-zinc-300 leading-relaxed mb-4">
          Казино-бонус — по настроению. Фриспины приятны, но вейджер ×35 превращает их в лотерею. Если играешь в слоты и без бонуса — активируй, лишним не будет. Но строить стратегию вокруг отыгрыша казино-вейджера я бы не стал.
        </p>
        <p class="text-zinc-400 text-sm">
          Подробнее про игровые автоматы и live-столы — на <a href="/casino" class="text-brand-400 hover:text-brand-300 border-b border-brand-500/50">странице казино</a>.
        </p>
      </div>

      <h2 class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-white mb-6">
        Другие акции
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
        <Card class="border-2 border-bg-700">
          <p class="font-mono text-pop-400 text-xs uppercase tracking-wider mb-2">Еженедельно</p>
          <p class="text-lg font-black text-white mb-2">Экспресс дня</p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Букмекер каждый день выделяет экспресс с повышенным коэффициентом. Собираешь ставку из предложенных событий — получаешь бонус к выигрышу до 10%. Я пользуюсь регулярно, когда совпадают мои прогнозы.
          </p>
        </Card>

        <Card class="border-2 border-bg-700">
          <p class="font-mono text-pop-400 text-xs uppercase tracking-wider mb-2">Постоянно</p>
          <p class="text-lg font-black text-white mb-2">Кэшбэк в казино</p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Возврат части проигранных средств раз в неделю. Процент зависит от уровня в программе лояльности. У меня сейчас серебряный статус — возвращают около 5%. Мелочь, но за месяц набегает ощутимая сумма.
          </p>
        </Card>

        <Card class="border-2 border-bg-700">
          <p class="font-mono text-pop-400 text-xs uppercase tracking-wider mb-2">Сезонные</p>
          <p class="text-lg font-black text-white mb-2">Турниры и розыгрыши</p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Под крупные события — ЧМ, Лига Чемпионов, КПЛ — запускаются промо-акции с призовыми фондами. Участие обычно бесплатное: ставишь на матчи турнира и набираешь очки в таблице лидеров.
          </p>
        </Card>

        <Card class="border-2 border-bg-700">
          <p class="font-mono text-pop-400 text-xs uppercase tracking-wider mb-2">Для всех</p>
          <p class="text-lg font-black text-white mb-2">День рождения</p>
          <p class="text-zinc-400 text-sm leading-relaxed">
            Площадка дарит фрибет на день рождения — размер зависит от активности аккаунта. Мне в прошлом году прилетело на 5 000 тенге. Условия мягкие — поставил на любой матч и забрал. Мобильное приложение можно <a href="/skachat" class="text-brand-400 hover:text-brand-300 border-b border-brand-500/50">скачать тут</a>.
          </p>
        </Card>
      </div>

      <div class="border-2 border-brand-500 bg-bg-900 p-8 text-center">
        <p class="font-mono text-brand-400 text-sm uppercase tracking-wider mb-3">Не упусти</p>
        <p class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight mb-6">
          Забери до 220 000 ₸ + 150 фриспинов
        </p>
        <CTAButton href={affiliateLink} variant="primary" size="lg" external>
          Активировать бонус
        </CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
