---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955871m_99c_';

const slotSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Review',
    itemReviewed: {
      '@type': 'SoftwareApplication',
      name: 'Book of Dead',
      applicationCategory: 'GameApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'KZT' },
    },
    reviewRating: { '@type': 'Rating', ratingValue: '4.5', bestRating: '5' },
    author: { '@type': 'Person', name: 'Арман Жумабаев' },
    reviewBody: 'Классический слот Play n GO с высокой волатильностью и бонусной книгой.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Book of Dead',
    applicationCategory: 'GameApplication',
    description: 'Слот с египетской тематикой, фриспины с расширяющимся символом.',
  },
];
---

<BaseLayout
  title="Играть Book of Dead на 1xBet Казахстан — обзор и RTP"
  description="Book of Dead на 1xBet: RTP 96.21%, бонусные раунды, волатильность. Честный обзор от казахстанца 2026."
  schema={slotSchemas}
  publishDate="2026-02-01"
  updateDate="2026-04-03"
  type="article"
>
  <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Book of Dead' }]} />
  <section class="py-10 lg:py-14 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
    <ArticleMeta publishDate="2026-02-01" updateDate="2026-04-03" />
    <div class="text-center mb-10 border-b-2 border-white/10 pb-10">
      <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tighter text-white mb-4">
        Book of Dead — обзор слота от Play'n GO
      </h1>
      <p class="text-zinc-400 font-mono text-sm">RTP 96.21% · макс ×5 000 · волатильность высокая</p>
      <div class="mt-8">
        <CTAButton href={affiliateLink} size="lg" external>Играть на 1xBet</CTAButton>
      </div>
    </div>

    <ImagePlaceholder
      description="Слот Book of Dead: египетская тема, фараоны и пирамиды"
      aspect="16/10"
      class="mb-10"
    />

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Обзор Book of Dead</h2>
    <p class="text-zinc-300 leading-relaxed mb-4">
      Египет, Рич Уайлд, книга разбрасывает символы в бонусе — механика старая как мир но затягивает.
    </p>
    <p class="text-zinc-400 text-sm mb-10">
      RTP заявлен 96.21%, на практике сессии либо жёстко сосут либо дарят x500, середины мало.
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Как играть</h2>
    <p class="text-zinc-300 leading-relaxed mb-4">
      Три скаттера запускают фриспины, перед стартом выбирается расширяющийся символ, линии читаются классически.
    </p>
    <p class="text-zinc-300 leading-relaxed mb-10">
      Ставку крути осторожно, гамма скачет — я с тенге по 200 крутил и за вечер и в плюс и в жёсткий минус уходил.
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Мой опыт</h2>
    <p class="text-zinc-300 leading-relaxed mb-4">
      Однажды поймал полный экран фараонов, офигел честно, другой раз 200 спинов без бонуса — хотел кинуть мышку.
    </p>
    <p class="text-zinc-400 text-sm mb-10">
      На букмекерской площадке крутил и с бонуса и со своих, отыгрыш с фриспинов долгий если лезть в мелкий шрифт.
    </p>

    <h2 class="text-xl font-black uppercase text-white border-l-4 border-cta-500 pl-4 mb-4">Стоит ли играть</h2>
    <p class="text-zinc-300 leading-relaxed mb-10">
      Если любишь классику и готов к качелям — да, если нужен chill на низкой волатильности — иди в другие слоты.
    </p>

    <p class="text-sm font-mono text-zinc-500 mb-10">
      <a href="/igrovye-avtomaty" class="text-cta-400 border-b border-cta-500">Все автоматы</a>
      ·
      <a href="/fruit-party" class="text-cta-400 border-b border-cta-500">Fruit Party</a>
      ·
      <a href="/starlight-princess" class="text-cta-400 border-b border-cta-500">Starlight Princess</a>
    </p>

    <div class="border-2 border-cta-500 p-8 text-center">
      <CTAButton href={affiliateLink} size="lg" external>Крутить Book of Dead</CTAButton>
    </div>
  </section>
</BaseLayout>
