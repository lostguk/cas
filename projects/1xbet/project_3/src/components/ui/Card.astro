---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'rounded-2xl p-6 lg:p-8 bg-white border border-gray-200 shadow-sm',
    hover && 'hover:border-brand-500/30 hover:shadow-md transition-all duration-300',
    className,
  ]}
>
  <slot />
</div>
