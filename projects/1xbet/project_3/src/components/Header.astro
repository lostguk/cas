---
import CTAButton from './ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955872m_100c_';
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/otkryt-schet', label: 'Открыть счёт' },
  { href: '/ustanovka', label: 'Установка' },
  { href: '/slots-i-igry', label: 'Слоты' },
  { href: '/podarki', label: 'Подарки' },
  { href: '/moj-profil', label: 'Профиль' },
  { href: '/about', label: 'О сайте' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      <a href="/" class="flex items-center gap-1.5 shrink-0">
        <span class="text-xl" aria-hidden="true">⚡</span>
        <span class="font-extrabold text-gray-900 text-lg tracking-tight"
          >1x<span class="text-brand-600">Bet</span></span
        >
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Основное меню">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-brand-700 bg-brand-500/10'
                  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <CTAButton href={affiliateLink} size="sm" external class="hidden sm:inline-flex">На сайт</CTAButton>
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden p-2 rounded-lg text-gray-700 hover:bg-gray-100"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Открыть меню"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 py-4">
      <nav class="flex flex-col gap-1" aria-label="Мобильное меню">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2.5 rounded-lg text-sm font-medium',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-brand-700 bg-brand-500/10'
                  : 'text-gray-700 hover:bg-gray-50',
              ]}
            >
              {link.label}
            </a>
          ))
        }
        <CTAButton href={affiliateLink} size="md" external class="mt-2 w-full">Перейти на платформу</CTAButton>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const open = !!(menu && !menu.classList.contains('hidden'));
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
