---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const cards = [
  {
    title: 'Футбол и КПЛ',
    text: 'Роспись широкая, маржа плавает по лигам. Для КПЛ иногда меньше рынков чем на топ-5, но базовые исходы есть.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>',
  },
  {
    title: 'Хоккей и «Барыс»',
    text: 'Сезонные пики активности, live подтормаживает на слабом интернете. Кэшаут есть не на всех рынках.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 18l4-6 4 3 4-8 4 5v4H4Z"/></svg>',
  },
  {
    title: 'Live-ставки',
    text: 'Графика событий удобная, но задержка трансляции бывает 10–30 сек. Не ставьте вслепую на счёт без проверки таймера.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h8l-1 8 10-12h-7l0-8z"/></svg>',
  },
  {
    title: 'Киберспорт',
    text: 'Dota и CS популярны, коэффициенты резкие на патчах. Плюс — много мелких турниров; минус — ликвидность ниже чем на футболе.',
    icon: '<svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
  },
];
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center mb-12">
      <div>
        <SectionHeading align="left">Спортивная линия под KZ-аудиторию.</SectionHeading>
        <p class="text-gray-600 leading-relaxed">
          Я сравниваю не «кто круче букмекер», а насколько удобно ставить из Казахстана: язык, методы, скорость расчёта. Если матч отменён — смотрите правила возврата в оферте, там всё жёстко по пунктам.
        </p>
      </div>
      <img
        src="/images/stadium-night.png"
        alt="Ночной стадион с подсветкой"
        width="800"
        height="450"
        class="rounded-xl shadow-sm w-full"
        loading="lazy"
      />
    </div>
    <div class="grid sm:grid-cols-2 gap-6">
      {
        cards.map((c) => (
          <Card>
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center mb-4" set:html={c.icon} />
            <h3 class="text-lg font-bold text-gray-900 mb-2">{c.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{c.text}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
