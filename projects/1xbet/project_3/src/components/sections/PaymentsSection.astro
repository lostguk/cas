---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';

const methods = [
  {
    title: 'Банковские карты',
    text: 'Частый способ для KZ, банк может держать платёж на проверке. Срок зачисления — от минут до пары часов, смотрите статус в выписке.',
  },
  {
    title: 'Электронные кошельки',
    text: 'Удобно для небольших сумм; лимиты и комиссии разные. Перед переводом сверяйте лимит кассы — он меняется чаще чем описания на форумах.',
  },
  {
    title: 'Крипто и альтернативы',
    text: 'USDT встречается, курс и сеть важны. Ошибка в сети = потеря средств, это не шутка; дважды проверяйте адрес.',
  },
];

const rows = [
  { method: 'Карта / банк', in: 'обычно мгновенно — до неск. часов', out: 'от часов до 1–3 дней', min: 'зависит от метода' },
  { method: 'Кошелёк', in: 'быстро', out: 'часто в тот же день', min: 'см. кассу' },
  { method: 'Крипто', in: 'после сети', out: 'после модерации', min: 'по правилам оператора' },
];
---

<section class="py-16 lg:py-20 bg-bg-50/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Пополнение и вывод: что учесть в тенге.</SectionHeading>
    <p class="text-center text-gray-600 max-w-3xl mx-auto mb-12 -mt-4">
      Таблица — ориентир, не догма: банк, статус аккаунта и сумма влияют сильнее любого обзора.
    </p>
    <div class="grid md:grid-cols-3 gap-6 mb-12">
      {
        methods.map((m) => (
          <Card>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{m.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{m.text}</p>
          </Card>
        ))
      }
    </div>
    <div class="grid lg:grid-cols-2 gap-10 items-start">
      <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full text-sm text-left">
          <thead class="bg-gray-50 text-gray-700 font-semibold border-b border-gray-200">
            <tr>
              <th class="px-4 py-3">Метод</th>
              <th class="px-4 py-3">Ввод</th>
              <th class="px-4 py-3">Вывод</th>
              <th class="px-4 py-3">Минимум</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {
              rows.map((r) => (
                <tr class="hover:bg-bg-50/80">
                  <td class="px-4 py-3 text-gray-800 font-medium">{r.method}</td>
                  <td class="px-4 py-3 text-gray-600">{r.in}</td>
                  <td class="px-4 py-3 text-gray-600">{r.out}</td>
                  <td class="px-4 py-3 text-gray-600">{r.min}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <ImagePlaceholder
        description="Экран кассы: список способов пополнения и вывода с лимитами в тенге"
        aspect="4/3"
      />
    </div>
  </div>
</section>
