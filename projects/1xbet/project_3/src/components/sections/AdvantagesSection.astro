---
import SectionHeading from '../ui/SectionHeading.astro';
import Card from '../ui/Card.astro';

const items = [
  {
    title: 'Линия и live',
    body: 'Много рынков на футбол и КПЛ, но иногда коэффициент «плывёт» за секунды до приёма. Плюс — фильтры удобные, минус — нужно внимание к купону.',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="7"/></svg>',
  },
  {
    title: 'Казино и слоты',
    body: 'Каталог большой, провайдеры знакомые. Минус — бонусные раунды съедают баланс быстрее чем кажется, если не держать лимит.',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="5" width="16" height="14" rx="2"/><path d="M8 9h2M14 9h2M9 15h6"/></svg>',
  },
  {
    title: 'Платежи KZ',
    body: 'Пополнение через привычные методы встречается часто, сроки зависят от банка. Комиссию смотрите в кассе — там честнее, чем в чатах.',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/></svg>',
  },
  {
    title: 'Приложение',
    body: 'APK ставится вручную на Android; на iOS чаще веб-версия. Плюс — быстрый доступ, минус — обновления не из магазина.',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="7" y="3" width="10" height="18" rx="2"/><path d="M10 18h4"/></svg>',
  },
  {
    title: 'Верификация',
    body: 'KYC запрашивают не всегда сразу, но перед крупным выводом — почти наверняка. Минус — если документы «плавают», сроки тянутся.',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 11a4 4 0 1 0-4-4 4 4 0 0 0 4 4Z"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>',
  },
  {
    title: 'Поддержка',
    body: 'Чат отвечает круглосуточно, но шаблоны раздражают. Плюс — есть история обращений; минус — сложные кейсы иногда эскалируются долго.',
    icon: '<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg>',
  },
];
---

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Плюсы и минусы без розовых очков.</SectionHeading>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        items.map((item) => (
          <Card>
            <div class="w-12 h-12 rounded-xl bg-brand-500/10 text-brand-600 flex items-center justify-center mb-4" set:html={item.icon} />
            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
