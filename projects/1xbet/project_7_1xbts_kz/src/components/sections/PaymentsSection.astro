---
import Card from '../ui/Card.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const methods = [
  {
    method: 'Kaspi / Halyk / Jusan',
    hint: 'Банковские карты и мобильные переводы. Kaspi Gold — наиболее быстрый вариант: пополнение моментальное, вывод — от 1 до 24 часов.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',
  },
  {
    method: 'Криптовалюта (USDT)',
    hint: 'Сеть TRC20, без комиссии со стороны платформы. Среднее время зачисления — 15–30 минут в обе стороны.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><circle cx="12" cy="12" r="10"/><path d="M12 6v12M8 8.5C8 7.12 9.79 6 12 6s4 1.12 4 2.5S14.21 11 12 11 8 12.12 8 13.5 9.79 16 12 16s4-1.12 4-2.5"/></svg>',
  },
  {
    method: 'Электронные кошельки',
    hint: 'QIWI, WebMoney — работают, но по скорости уступают банковским переводам. Комиссия зависит от направления.',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-6 h-6"><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/><path d="M9 12h6m-3-3v6"/></svg>',
  },
];

const tableRows = [
  ['Kaspi Gold', 'Мгновенно', '1–24 часа', '1 000 ₸'],
  ['Halyk Homebank', '5–15 мин', '1–3 дня', '1 000 ₸'],
  ['USDT (TRC20)', '15–30 мин', '15–30 мин', '~3 000 ₸'],
];
---

<section class="py-20 lg:py-28 bg-obsidian-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>Тенге без конвертации — как платить</SectionHeading>

    <div class="grid md:grid-cols-3 gap-6 mb-12">
      {methods.map((m) => (
        <Card>
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center text-amber-400 mb-4">
            <Fragment set:html={m.icon} />
          </div>
          <h3 class="font-heading font-bold text-white mb-2">{m.method}</h3>
          <p class="text-sm text-gray-400">{m.hint}</p>
        </Card>
      ))}
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-amber-500/20 text-left">
            <th class="py-3 px-4 text-amber-400 font-heading font-semibold">Метод</th>
            <th class="py-3 px-4 text-amber-400 font-heading font-semibold">Пополнение</th>
            <th class="py-3 px-4 text-amber-400 font-heading font-semibold">Вывод</th>
            <th class="py-3 px-4 text-amber-400 font-heading font-semibold">Минимум</th>
          </tr>
        </thead>
        <tbody>
          {tableRows.map((row) => (
            <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
              <td class="py-3 px-4 text-white">{row[0]}</td>
              <td class="py-3 px-4 text-gray-400">{row[1]}</td>
              <td class="py-3 px-4 text-gray-400">{row[2]}</td>
              <td class="py-3 px-4 text-gray-400">{row[3]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
