---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = '#';
const stats = [
  { value: '50+', label: 'видов спорта' },
  { value: '1 000 ₸', label: 'мин. депозит' },
  { value: '100%', label: 'на первый депозит' },
];
---

<section class="relative overflow-hidden py-16 sm:py-20 lg:py-28">
  <div class="absolute inset-0 bg-gradient-to-b from-obsidian-800 via-black to-obsidian-900"></div>
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--color-amber-500)_0%,_transparent_60%)] opacity-[0.08]"></div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-sm font-medium mb-6">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      Обновлено 2026
    </div>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-heading font-bold text-white leading-[1.1] mb-6">
      1xBet Казахстан — ставки<br class="hidden sm:block" /> и казино для игроков из KZ
    </h1>
    <p class="text-lg sm:text-xl text-gray-400 italic max-w-2xl mx-auto mb-8 font-heading">Информационный обзор 1xBet для Казахстана. 50+ видов спорта, 10 000+ игр в казино, счёт в тенге без конвертации.</p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <CTAButton href={affiliateLink} size="lg" external>Начать с приветственным пакетом</CTAButton>
      <CTAButton href="/rabochij-sajt" variant="secondary" size="lg">Получить фрибет</CTAButton>
    </div>
    <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto mt-14">
      {stats.map((s) => (
        <div class="text-center">
          <div class="text-2xl sm:text-3xl font-heading font-bold text-amber-400">{s.value}</div>
          <div class="text-xs sm:text-sm text-gray-500 mt-1">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
