---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = '#';
---

<section class="py-20 lg:py-28">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-gradient-to-br from-amber-500/10 via-obsidian-800 to-olive-500/5 border border-amber-500/15 p-10 lg:p-16 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--color-amber-500)_0%,_transparent_60%)] opacity-[0.05]"></div>
      <div class="relative">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-heading font-bold text-amber-400 mb-4">Время действовать</h2>
        <p class="text-gray-400 italic font-heading max-w-lg mx-auto mb-8">Актуальные условия и бонусы 1xBet для казахстанских пользователей доступны на официальном ресурсе.</p>
        <CTAButton href={affiliateLink} size="lg" external>Не откладывайте</CTAButton>
      </div>
    </div>
  </div>
</section>
