---
const affiliateLink = '#';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Главная' },
  { href: '/vhod', label: 'Вход' },
  { href: '/ustanovka', label: 'Приложение' },
  { href: '/onlajn-kazino', label: 'Казино' },
  { href: '/akcii', label: 'Акции' },
  { href: '/about', label: 'О портале' },
];

const isActive = (href: string) =>
  currentPath === href || (href !== '/' && currentPath.startsWith(href));
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/90 backdrop-blur-xl border-b border-amber-500/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center text-black font-heading font-bold text-sm shadow-lg shadow-amber-500/20">1x</div>
        <span class="font-heading text-lg text-white tracking-wide hidden sm:block">Bet <span class="text-amber-400">KZ</span></span>
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Основная навигация">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-medium transition-all duration-300',
              isActive(link.href)
                ? 'text-amber-400 bg-amber-500/10'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-3">
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 text-black font-bold text-sm px-5 py-2.5 rounded-xl border border-amber-400/50 shadow-lg shadow-amber-500/30 hover:shadow-amber-500/50 transition-all duration-300"
        >
          Перейти на сайт
        </a>
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden p-2 text-gray-400 hover:text-white"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-amber-500/10 py-4">
      <div class="flex flex-col gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3 rounded-xl text-sm font-medium',
              isActive(link.href)
                ? 'text-amber-400 bg-amber-500/10'
                : 'text-gray-300 hover:bg-white/5',
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          href={affiliateLink}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 text-center bg-gradient-to-r from-amber-400 via-amber-500 to-amber-600 text-black font-bold text-sm px-5 py-3 rounded-xl"
        >
          Перейти на сайт
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    const open = menu && !menu.classList.contains('hidden');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
