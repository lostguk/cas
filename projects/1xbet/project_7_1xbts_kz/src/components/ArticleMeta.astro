---
interface Props {
  publishDate: string;
  updateDate: string;
}

const { publishDate, updateDate } = Astro.props;

const months = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
];

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
};
---

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center gap-3 text-sm text-gray-500 border-b border-amber-500/10 pb-5 mb-8">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <span class="text-amber-400/70 font-heading italic">Редакция 1xbts.kz</span>
    <span class="text-gray-700">·</span>
    <time datetime={publishDate}>{formatDate(publishDate)}</time>
    <span class="text-gray-700">·</span>
    <time datetime={updateDate}>обн. {formatDate(updateDate)}</time>
  </div>
</div>
