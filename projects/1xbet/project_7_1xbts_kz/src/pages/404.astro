---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/ui/CTAButton.astro';
---

<BaseLayout
  title="Страница не найдена"
  description="Запрошенная страница не существует."
  noindex={true}
>
  <section class="py-20 lg:py-32 text-center">
    <div class="max-w-2xl mx-auto px-4">
      <div class="text-8xl font-heading font-bold text-amber-500/20 mb-6">404</div>
      <h1 class="text-3xl font-heading font-bold text-white mb-4">Страница не найдена</h1>
      <p class="text-gray-400 mb-8">Возможно, адрес был изменён или страница удалена.</p>
      <CTAButton href="/" variant="secondary">На главную</CTAButton>
    </div>
  </section>
</BaseLayout>
