---
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955870m_98c_';
---

<section class="py-20 lg:py-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-3xl border border-primary-500/20 bg-gradient-to-br from-primary-500/10 via-dark-800 to-highlight-100/5 px-6 py-14 lg:px-16 lg:py-16 text-center"
    >
      <div
        class="absolute inset-0 opacity-30 pointer-events-none"
        style="background: radial-gradient(circle at 30% 20%, rgba(239,68,68,0.25), transparent 50%);"
        aria-hidden="true"
      ></div>
      <div class="relative">
        <h2 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-white mb-4">
          На линию — сейчас.
        </h2>
        <p class="text-slate-300 max-w-xl mx-auto mb-8">
          Купон, казино или оба: один переход на официальную сторону.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <CTAButton href={affiliateLink} size="lg" external>Перейти</CTAButton>
          <CTAButton href="/dostup" variant="secondary" size="lg">Нет доступа?</CTAButton>
        </div>
      </div>
    </div>
  </div>
</section>
