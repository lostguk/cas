---
import SectionHeading from '../ui/SectionHeading.astro';
import CTAButton from '../ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955870m_98c_';

const faq = [
  {
    q: 'Можно ли зарегистрироваться без паспорта?',
    a: 'Часто хватает телефона и базовых данных, но оператор может запросить документ позже по KYC. Итог зависит от правил конкретного счёта и суммы операций.',
  },
  {
    q: 'Есть ли комиссия при пополнении через Kaspi?',
    a: 'Платформа обычно не берёт сверху за метод, но банк или посредник могут иметь свою строку в чеке. Сверяй комиссию в кассе перед подтверждением платежа.',
  },
  {
    q: 'Как обновить APK на Android?',
    a: 'Скачай свежий файл с официальной страницы, разреши установку из неизвестных источников на время установки и запусти апдейт поверх старой версии.',
  },
  {
    q: 'Как зайти на сайт без VPN?',
    a: 'Попробуй актуальное зеркало из проверенного источника, смени DNS или открой мобильную версию через приложение. Фишинговые копии встречаются, будь внимателен к адресу.',
  },
  {
    q: 'Нужен ли промокод для бонуса?',
    a: 'Иногда поле промокода опционально: бонус цепляется к первому депозиту автоматически. Если код есть — введи при регистрации или в кассе, как написано в условиях акции.',
  },
  {
    q: 'Можно ли ставить на матчи «Барыса»?',
    a: 'Рынки на КХЛ и «Барыс» обычно есть в хоккейной линии; глубина росписи плавает от матча к матчу. Проверь список событий в live и прематче непосредственно перед ставкой.',
  },
  {
    q: 'Можно ли играть в казино в тенге?',
    a: 'При валюте счёта KZT слоты и столы крутятся в тенге, без ручной конвертации в профиле. Лимиты ставок всё равно смотри в каждой игре отдельно.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<section class="py-20 lg:py-28 bg-dark-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading>
      Вопросы — ответы.
      <p slot="subtitle" class="text-slate-400">Сжато, по делу, без «воды».</p>
    </SectionHeading>
    <div class="max-w-3xl mx-auto space-y-3 mb-10">
      {
        faq.map((item) => (
          <details class="group rounded-lg border border-white/[0.06] bg-dark-800/80 border-l-4 border-primary-500">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-left font-bold text-white uppercase text-sm tracking-wide">
              <span>{item.q}</span>
              <svg
                class="w-5 h-5 text-primary-500 shrink-0 transition-transform group-open:rotate-180"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <div class="px-5 pb-4 text-slate-400 text-sm leading-relaxed border-t border-white/5 pt-3">
              {item.a}
            </div>
          </details>
        ))
      }
    </div>
    <div class="flex justify-center">
      <CTAButton href={affiliateLink} size="lg" external>Уточнить в поддержке</CTAButton>
    </div>
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
