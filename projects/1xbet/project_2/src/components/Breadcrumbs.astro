---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const siteUrl = 'https://1xstavka-kz.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: item.href ? `${siteUrl}${item.href}` : undefined,
  })),
};
---

<nav aria-label="Навигация" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-400">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <svg class="w-4 h-4 text-primary-500/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="m9 18 6-6-6-6" />
            </svg>
          )}
          {item.href ? (
            <a href={item.href} class="hover:text-primary-400 transition-colors">
              {item.label}
            </a>
          ) : (
            <span class="text-highlight-100">{item.label}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
