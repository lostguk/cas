---
import CTAButton from './ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955870m_98c_';
const currentYear = new Date().getFullYear();

const sections = [
  {
    title: 'Разделы',
    links: [
      { href: '/sozdat-akkaunt', label: 'Создать аккаунт' },
      { href: '/prilozhenie', label: 'Приложение' },
      { href: '/onlajn-kazino', label: 'Онлайн-казино' },
      { href: '/dostup', label: 'Доступ' },
    ],
  },
  {
    title: 'Ещё',
    links: [
      { href: '/akcii', label: 'Акции' },
      { href: '/lichnyy-kabinet', label: 'Личный кабинет' },
      { href: '/about', label: 'О проекте' },
      { href: '/gates-of-olympus', label: 'Слоты' },
    ],
  },
];
---

<footer class="bg-dark-900 border-t border-white/5 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      <div class="col-span-2 md:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 mb-4">
          <span
            class="w-10 h-10 rounded-lg bg-dark-800 border border-primary-500/40 flex items-center justify-center text-primary-500 font-extrabold text-lg"
            >1x</span
          >
          <span class="font-extrabold uppercase text-white">Ставка KZ</span>
        </a>
        <p class="text-slate-400 text-sm max-w-md leading-relaxed mb-4">
          Информация о ставках и казино для пользователей из Казахстана. 18+.
        </p>
        <CTAButton href={affiliateLink} size="sm" external>На официальный сайт</CTAButton>
      </div>
      {
        sections.map((s) => (
          <div>
            <h3 class="text-white font-bold uppercase tracking-wide text-sm mb-4">{s.title}</h3>
            <ul class="space-y-2">
              {s.links.map((l) => (
                <li>
                  <a href={l.href} class="text-slate-400 hover:text-primary-400 text-sm transition-colors">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="mt-10 text-xs text-slate-500 leading-relaxed max-w-4xl">
      Азартные игры могут вызывать зависимость. Играйте ответственно. Сайт не проводит игры на деньги и не
      принимает платежи.
    </p>
    <p class="mt-6 text-sm text-slate-600">© {currentYear} 1xstavka-kz.com</p>
  </div>
</footer>
