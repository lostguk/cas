---
interface Props {
  publishDate: string;
  updateDate: string;
}

const { publishDate, updateDate } = Astro.props;

const months = [
  'января',
  'февраля',
  'марта',
  'апреля',
  'мая',
  'июня',
  'июля',
  'августа',
  'сентября',
  'октября',
  'ноября',
  'декабря',
];

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
}
---

<div
  class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center gap-3 text-sm text-slate-400 mt-4"
>
  <span
    class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-primary-500/20 text-primary-400 font-bold text-xs"
    aria-hidden="true"
    >Р</span
  >
  <span>
    <a href="/about" class="text-highlight-100 hover:text-primary-400 transition-colors">Редакция</a>
  </span>
  <span class="text-slate-600" aria-hidden="true">|</span>
  <time datetime={publishDate}>Опубликовано: {formatDate(publishDate)}</time>
  <span class="text-slate-600" aria-hidden="true">|</span>
  <time datetime={updateDate}>Обновлено: {formatDate(updateDate)}</time>
</div>
