---
import CTAButton from './ui/CTAButton.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955870m_98c_';
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/sozdat-akkaunt', label: 'Аккаунт' },
  { href: '/prilozhenie', label: 'Приложение' },
  { href: '/onlajn-kazino', label: 'Казино' },
  { href: '/dostup', label: 'Доступ' },
  { href: '/akcii', label: 'Акции' },
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-dark-950/90 backdrop-blur-xl border-b border-white/5"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-[4.5rem]">
      <a href="/" class="flex items-center gap-2 group" aria-label="На главную">
        <span
          class="w-10 h-10 rounded-lg bg-dark-800 border border-primary-500/40 flex items-center justify-center text-primary-500 font-extrabold text-lg group-hover:scale-105 transition-transform"
          >1x</span
        >
        <span class="font-extrabold uppercase tracking-tight text-white text-sm sm:text-base"
          >Ставка <span class="text-primary-500">KZ</span></span
        >
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Основное меню">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'px-3 py-2 rounded-lg text-sm font-semibold uppercase tracking-wide transition-colors duration-200',
                currentPath === link.href ||
                (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-primary-400 bg-primary-500/10'
                  : 'text-slate-300 hover:text-white hover:bg-white/5',
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        <CTAButton href={affiliateLink} size="sm" external class="hidden sm:inline-flex">
          Играть
        </CTAButton>
        <button
          type="button"
          id="menu-toggle"
          class="lg:hidden p-2 rounded-lg text-white bg-dark-800 border border-white/10"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Открыть меню"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden border-t border-white/5 py-4 pb-6">
      <nav class="flex flex-col gap-1" aria-label="Мобильное меню">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="px-3 py-3 rounded-lg text-sm font-semibold uppercase text-slate-200 hover:bg-white/5"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href="/lichnyy-kabinet"
          class="px-3 py-3 rounded-lg text-sm font-semibold uppercase text-slate-200 hover:bg-white/5"
        >
          Кабинет
        </a>
        <a
          href="/about"
          class="px-3 py-3 rounded-lg text-sm font-semibold uppercase text-slate-200 hover:bg-white/5"
        >
          О проекте
        </a>
        <CTAButton href={affiliateLink} size="md" external class="mt-2 w-full">
          Играть сейчас
        </CTAButton>
      </nav>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
