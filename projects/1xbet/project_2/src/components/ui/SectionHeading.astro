---
interface Props {
  tag?: 'h2' | 'h3';
  align?: 'left' | 'center';
  class?: string;
}

const { tag: Tag = 'h2', align = 'center', class: className = '' } = Astro.props;
---

<div class:list={['mb-10', align === 'center' && 'text-center', className]}>
  <Tag
    class:list={[
      'text-3xl sm:text-4xl lg:text-5xl font-extrabold uppercase tracking-tight text-white leading-tight',
    ]}
  >
    <slot />
  </Tag>
  <div class:list={['mt-3 text-slate-400 text-sm sm:text-base max-w-2xl', align === 'center' && 'mx-auto']}>
    <slot name="subtitle" />
  </div>
</div>
