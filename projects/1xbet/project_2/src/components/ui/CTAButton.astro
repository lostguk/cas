---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  class: className = '',
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-bold uppercase tracking-wider rounded-lg transition-transform duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-dark-950';

const variants = {
  primary:
    'bg-primary-500 text-white hover:scale-105 shadow-lg shadow-primary-500/25 hover:shadow-xl',
  secondary:
    'border-2 border-primary-500 text-primary-400 bg-transparent hover:scale-[1.02]',
  outline: 'border-2 border-highlight-400/40 text-highlight-100 hover:border-primary-500/60',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};

const rel = external ? 'noopener noreferrer' : undefined;
const target = external ? '_blank' : undefined;
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  target={target}
  rel={rel}
>
  <slot />
</a>
