---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';
import ImagePlaceholder from '../components/ui/ImagePlaceholder.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955870m_98c_';
const publishDate = '2026-03-20';
const updateDate = '2026-04-01';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: {
    '@type': 'VideoGame',
    name: 'Gates of Olympus',
    gamePlatform: 'Online casino',
  },
  reviewRating: { '@type': 'Rating', ratingValue: '4.5', bestRating: '5' },
  author: { '@type': 'Person', name: 'Редакция 1xСтавка KZ' },
  reviewBody: 'Слот с каскадами и множителями от Зевса; высокая волатильность.',
};
---

<BaseLayout
  title="Gates of Olympus — обзор слота"
  description="Pragmatic Play: каскады, множители, RTP ориентир. Играть на официальном сайте в тенге."
  schema={schema}
  type="article"
  publishDate={publishDate}
  updateDate={updateDate}
  noindex={true}
>
  <Breadcrumbs
    items={[
      { label: 'Главная', href: '/' },
      { label: 'Онлайн-казино', href: '/onlajn-kazino' },
      { label: 'Gates of Olympus' },
    ]}
  />
  <ArticleMeta publishDate={publishDate} updateDate={updateDate} />

  <section class="py-12 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black uppercase text-white mb-3">
          Gates of Olympus.
        </h1>
        <p class="text-primary-400 font-bold text-sm uppercase tracking-widest">Pragmatic Play</p>
        <div class="mt-6 flex justify-center gap-4 flex-wrap">
          <CTAButton href={affiliateLink} size="lg" external>Играть</CTAButton>
          <CTAButton href="/onlajn-kazino" variant="secondary" size="lg">Все слоты</CTAButton>
        </div>
      </div>

      <ImagePlaceholder
        description="Слот Gates of Olympus: Зевс, молнии, древнегреческая тема"
        class="mb-10"
      />

      <div class="grid sm:grid-cols-3 gap-4 mb-10">
        <Card class="!p-4">
          <p class="text-xs text-slate-500 uppercase">RTP ориентир</p>
          <p class="text-xl font-black text-white">~96.5%</p>
        </Card>
        <Card class="!p-4">
          <p class="text-xs text-slate-500 uppercase">Волатильность</p>
          <p class="text-xl font-black text-white">Высокая</p>
        </Card>
        <Card class="!p-4">
          <p class="text-xs text-slate-500 uppercase">Сетка</p>
          <p class="text-xl font-black text-white">6×5</p>
        </Card>
      </div>

      <div class="space-y-5 text-slate-300 text-sm">
        <h2 class="text-xl font-bold text-white uppercase">Механика.</h2>
        <p>
          Выигрышные символы исчезают, новые падают сверху; множители от Зевса складываются и могут задать крупный занос в одном спине.
        </p>
        <h2 class="text-xl font-bold text-white uppercase">Бонуска.</h2>
        <p>
          Фриспины с накоплением множителей — основной потенциал; покупка бонуса есть не везде и зависит от юрисдикции оператора.
        </p>
        <h2 class="text-xl font-bold text-white uppercase">Стратегия.</h2>
        <p>
          Банкролл держи с запасом на просадки; автоспин с лимитом помогает не улететь в ноль за серию пустых каскадов.
        </p>
      </div>

      <div class="mt-12 flex justify-center">
        <CTAButton href={affiliateLink} size="lg" external>Крутить слот</CTAButton>
      </div>
    </div>
  </section>
</BaseLayout>
