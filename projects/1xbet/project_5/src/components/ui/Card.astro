---
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className = '', hover = true } = Astro.props;
---

<div
  class:list={[
    'bg-white border border-gray-200 rounded-xl shadow-sm p-6',
    hover && 'hover:shadow-md hover:border-main-200 transition-all duration-200',
    className,
  ]}
>
  <slot />
</div>
