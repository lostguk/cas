---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, class: className = '' } = Astro.props;

const sizeClasses = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-2.5 text-sm',
  lg: 'px-8 py-3.5 text-base',
};

const variantClasses = {
  primary: 'bg-main-500 text-white hover:bg-main-600',
  secondary: 'bg-gray-100 text-gray-700 hover:bg-gray-200',
  outline: 'border-2 border-main-500 text-main-500 hover:bg-main-500 hover:text-white',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center font-semibold rounded-lg transition-colors duration-200',
    sizeClasses[size],
    variantClasses[variant],
    className,
  ]}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
