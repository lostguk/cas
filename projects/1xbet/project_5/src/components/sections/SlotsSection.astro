---
import SectionHeading from '../ui/SectionHeading.astro';
import CTAButton from '../ui/CTAButton.astro';

const slots = [
  {
    name: 'Sweet Bonanza',
    provider: 'Pragmatic Play',
    rtp: '96.48%',
    maxWin: '\u00d721 175',
    link: '/sweet-bonanza',
    cta: 'Играть с бонусом',
    accent: 'from-main-400 to-main-600',
    text: 'Фруктовая тематика с каскадными выигрышами и множителями до \u00d7100 в бонусном раунде. Волатильность высокая — можно долго сидеть без выигрыша, а потом словить крупный занос. Но не факт.',
  },
  {
    name: 'The Dog House',
    provider: 'Pragmatic Play',
    rtp: '96.51%',
    maxWin: '\u00d76 750',
    link: '/the-dog-house',
    cta: 'Крутить с фриспинами',
    accent: 'from-alt-400 to-alt-500',
    text: 'Слот про собак с липкими вайлдами и множителями во фриспинах. Максимальный выигрыш скромнее, чем у Sweet Bonanza, но частота бонусов субъективно выше. Хотя статистика у всех своя.',
  },
  {
    name: 'Sugar Rush 1000',
    provider: 'Pragmatic Play',
    rtp: '96.53%',
    maxWin: '\u00d725 000',
    link: '/sugar-rush-1000',
    cta: 'Запустить слот бесплатно',
    accent: 'from-main-300 to-main-500',
    text: 'Конфетная сетка с нарастающими множителями — каждый повторный выигрыш увеличивает коэффициент ячейки. Потенциал огромный, но волатильность зашкаливает. Для терпеливых, не для всех.',
  },
];
---

<section id="slots" class="py-16 lg:py-24 bg-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading class="mb-12">
      Слоты — субъективный топ
    </SectionHeading>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {slots.map((slot) => (
        <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden hover:shadow-md hover:border-main-200 transition-all duration-200">
          <div class="h-40 bg-main-100 flex flex-col items-center justify-center gap-2 relative">
            <svg class="w-10 h-10 text-main-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 0 1 0 .656l-5.603 3.113a.375.375 0 0 1-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112Z" />
            </svg>
            <span class="text-sm font-semibold text-main-600">{slot.name}</span>
          </div>

          <div class="p-6">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-lg font-semibold text-gray-900">{slot.name}</h3>
            </div>

            <div class="flex gap-4 text-xs text-gray-500 mb-4">
              <span>{slot.provider}</span>
              <span>RTP {slot.rtp}</span>
              <span>Макс. {slot.maxWin}</span>
            </div>

            <p class="text-sm text-gray-600 leading-relaxed mb-5">{slot.text}</p>

            <CTAButton href={slot.link} variant="primary" size="sm" class="w-full text-center">
              {slot.cta}
            </CTAButton>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
