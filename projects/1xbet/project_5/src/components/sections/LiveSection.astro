---
import { Image } from 'astro:assets';
import liveImg from '../../assets/images/p5-live-dashboard.png';
import SectionHeading from '../ui/SectionHeading.astro';

const features = [
  {
    title: '1 000+ live-событий ежедневно',
    description: 'Выбор большой, но на практике интересных матчей для ставок — штук 20–30 за вечер. Остальное — экзотика.',
  },
  {
    title: 'Cash Out — досрочная продажа ставки',
    description: 'Удобная функция, но коэффициент кэшаута всегда хуже рыночного. Контора на этом зарабатывает, и это нормально.',
  },
  {
    title: 'Live-казино с дилерами',
    description: 'Aviator, Crazy Time, Lightning Roulette — всё работает. Но задержка стрима 2–3 секунды бывает критичной в быстрых играх.',
  },
  {
    title: 'Трансляции матчей в приложении',
    description: 'Стримы есть, но качество зависит от турнира. На топ-лигах нормально, на мелких — может тормозить или вообще не быть.',
  },
];
---

<section id="live" class="py-16 lg:py-24 bg-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading class="mb-12">
      Live-ставки и live-казино
    </SectionHeading>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <div>
        <p class="text-gray-700 leading-relaxed mb-6">
          Live-раздел у этого букмекера — одна из сильных сторон, хотя и с оговорками. Каждый день больше тысячи событий, но реально ставлю на 3–5 матчей за сессию. Интерфейс иногда подтормаживает, коэффициенты прыгают — приходится быть внимательным. Задержка в пару секунд при размещении пари тоже случается, особенно на популярных событиях.
        </p>

        <div class="space-y-4">
          {features.map((feature) => (
            <div class="flex items-start gap-3">
              <span class="shrink-0 mt-1 w-2 h-2 rounded-full bg-main-500"></span>
              <div>
                <h3 class="text-sm font-semibold text-gray-900">{feature.title}</h3>
                <p class="text-sm text-gray-600 leading-relaxed mt-0.5">{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div>
        <Image
          src={liveImg}
          alt="Live-ставки и казино с дилерами"
          class="w-full rounded-xl shadow-sm border border-gray-200"
          widths={[480, 720]}
          sizes="(min-width: 1024px) 50vw, 100vw"
        />
        <p class="text-xs text-gray-400 mt-3 text-center">
          Скриншот live-раздела. Интерфейс может меняться — платформа регулярно обновляется.
        </p>
      </div>
    </div>
  </div>
</section>
