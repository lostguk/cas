---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955872m_100c_';
const publishDate = '2026-02-05';
const updateDate = '2026-03-22';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как зарегистрироваться на 1xBet в Казахстане',
  description: 'Пошаговая инструкция по регистрации аккаунта на букмекерской платформе с бонусом на первый депозит.',
  totalTime: 'PT2M',
  estimatedCost: {
    '@type': 'MonetaryAmount',
    currency: 'KZT',
    value: '0',
  },
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'В один клик',
      text: 'Выберите страну Казахстан и валюту KZT, нажмите кнопку регистрации. Логин и пароль генерируются автоматически — сохраните их сразу.',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'По номеру телефона',
      text: 'Введите казахстанский номер, получите SMS-код и подтвердите аккаунт. Привязанный номер позволит восстановить доступ.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'По электронной почте',
      text: 'Заполните форму — email, пароль, личные данные. Подтвердите адрес через письмо на указанный ящик.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Через соцсети',
      text: 'Авторизуйтесь через Telegram, Google или Apple ID. Данные подтянутся автоматически.',
    },
  ],
};
---

<BaseLayout
  title="Регистрация 1xBet: 4 способа + бонус на первый депозит"
  description="Регистрация 1xBet за 2 минуты — пошагово. Аккаунт в тенге, бонус на старте, верификация через ИИН."
  schema={schema}
  publishDate={publishDate}
  updateDate={updateDate}
>
  <Breadcrumbs items={[
    { label: 'Главная', href: '/' },
    { label: 'Регистрация' },
  ]} />

  <article class="pb-16 lg:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-gray-900 leading-tight mb-6">
        Создать аккаунт на 1xBet — пошаговая инструкция
      </h1>
    </div>

    <ArticleMeta publishDate={publishDate} updateDate={updateDate} />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-gray-600 text-lg leading-relaxed mb-4">
        Регистрация на этой площадке занимает от силы пару минут — проверял на себе. Доступны четыре способа, и каждый подойдёт для разных ситуаций. Расскажу по порядку, чтобы не пришлось разбираться методом тыка. Но сразу предупрежу: какой бы способ ни выбрали, без верификации вывести деньги не получится.
      </p>

      <p class="text-gray-600 leading-relaxed mb-10">
        Заходить рекомендую через <a href="/prilozhenie" class="text-main-500 hover:text-main-600">мобильное приложение</a> — оно стабильнее работает в Казахстане, чем браузерная версия. Если сайт заблокирован оператором, приложение всё равно подключается без проблем.
      </p>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">4 способа создать аккаунт</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-12">
        <Card>
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-main-100 text-main-600 text-sm font-semibold mb-4">1</span>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">В один клик</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Самый быстрый путь. Выбираете страну — Казахстан, валюту — тенге, жмёте кнопку. Система генерирует логин и пароль автоматически. Главный минус — эти данные легко потерять, если сразу не сохраните. Мне однажды пришлось восстанавливать доступ через поддержку — потратил полтора часа.
          </p>
        </Card>

        <Card>
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-main-100 text-main-600 text-sm font-semibold mb-4">2</span>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">По номеру телефона</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Вводите казахстанский номер, получаете SMS-код и подтверждаете. Удобно тем, что потом через этот же номер можно восстановить доступ. SMS у меня приходили за пять–десять секунд. Но имейте в виду: если смените номер, привязать новый — тот ещё квест.
          </p>
        </Card>

        <Card>
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-main-100 text-main-600 text-sm font-semibold mb-4">3</span>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">По электронной почте</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Тут заполняете полную форму — email, пароль, имя, дата рождения. Дольше всего из четырёх вариантов, зато почта сразу привязана и при верификации меньше головной боли. Письмо с подтверждением обычно приходит в течение минуты.
          </p>
        </Card>

        <Card>
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-main-100 text-main-600 text-sm font-semibold mb-4">4</span>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Через соцсети</h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Telegram, Google, Apple ID — выбираете сервис, даёте разрешение, и аккаунт создаётся за секунды. Данные подтягиваются автоматически. Мой приятель из Караганды всегда заходит так — говорит, меньше всего возни. Но я не уверен, что это безопасно при взломе соцсети.
          </p>
        </Card>
      </div>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Бонус при регистрации</h2>

      <div class="bg-main-100 border border-main-200 rounded-xl p-6 mb-12">
        <p class="text-gray-700 leading-relaxed mb-3">
          После создания аккаунта букмекер предлагает приветственный пакет — до 220 000 тенге на первое пополнение плюс 150 фриспинов. Механика простая: сколько закинете, столько получите сверху, но не больше потолка. Звучит заманчиво, однако условия отыгрыша не радужные.
        </p>
        <p class="text-sm text-gray-500">
          Подробный разбор вейджера и подводных камней — на <a href="/akcii" class="text-main-500 hover:text-main-600">странице акций</a>. Рекомендую прочитать до того, как пополнять счёт.
        </p>
      </div>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Верификация через ИИН</h2>

      <p class="text-gray-600 leading-relaxed mb-4">
        После регистрации платформа попросит пройти верификацию — без неё вывод средств заблокирован. Понадобится фото удостоверения личности, ИИН и селфи. У меня подтверждение заняло около шести часов в будний день, но знакомые жаловались, что ждали до двух суток. Процесс не самый приятный, и отложить его — значит усложнить себе жизнь позже.
      </p>

      <p class="text-gray-600 leading-relaxed mb-12">
        Один неприятный нюанс: если данные в аккаунте не совпадут с документами, верификацию не пройдёте. Заполняйте настоящие имя и фамилию с первого шага — исправить потом бывает проблематично.
      </p>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Честное мнение</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-12">
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
          <p class="text-sm font-semibold text-alt-500 uppercase tracking-wider mb-4">Плюсы</p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Четыре варианта — выбирай удобный</span></li>
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Аккаунт сразу в тенге, без конвертации</span></li>
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Бонус активируется автоматически</span></li>
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Создание занимает не больше двух минут</span></li>
          </ul>
        </div>

        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
          <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Минусы</p>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>Верификация обязательна для любого вывода</span></li>
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>Данные «в один клик» легко потерять</span></li>
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>Без VPN сайт иногда недоступен в KZ</span></li>
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>Поддержка при проблемах с регистрацией отвечает медленно</span></li>
          </ul>
        </div>
      </div>

      <p class="text-gray-600 leading-relaxed mb-10">
        После регистрации загляните в <a href="/onlajn-kazino" class="text-main-500 hover:text-main-600">раздел казино</a> — там есть демо-режим, чтобы потестировать слоты без реальных денег. Ну а если привыкли ставить с телефона — <a href="/prilozhenie" class="text-main-500 hover:text-main-600">скачайте приложение</a>, оно работает надёжнее браузера.
      </p>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 text-center">
        <p class="text-xl sm:text-2xl font-semibold text-gray-900 mb-4">Забрать приветственный пакет до 220 000 ₸</p>
        <p class="text-sm text-gray-500 mb-6">Попробовать можно, но не забудьте прочитать условия бонуса.</p>
        <CTAButton href={affiliateLink} variant="primary" size="lg" external>
          Создать аккаунт
        </CTAButton>
      </div>
    </div>
  </article>
</BaseLayout>
