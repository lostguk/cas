---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleMeta from '../components/ArticleMeta.astro';
import CTAButton from '../components/ui/CTAButton.astro';
import Card from '../components/ui/Card.astro';

const affiliateLink = 'https://refpa94475.com/L?tag=d_3955872m_100c_';
const publishDate = '2026-02-08';
const updateDate = '2026-03-20';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Как скачать приложение 1xBet в Казахстане',
  description: 'Инструкция по скачиванию и установке APK для Android и версии для iOS.',
  totalTime: 'PT5M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Перейти на сайт',
      text: 'Откройте официальный сайт или зеркало через мобильный браузер и найдите раздел «Мобильные приложения».',
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Разрешить установку из неизвестных источников',
      text: 'В настройках Android разрешите установку APK-файлов из браузера.',
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Скачать и установить APK',
      text: 'Нажмите кнопку скачивания, дождитесь загрузки файла (~40 МБ) и запустите установку.',
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Войти или зарегистрироваться',
      text: 'Откройте приложение, введите логин и пароль или создайте новый аккаунт.',
    },
  ],
};
---

<BaseLayout
  title="1xBet Скачать — приложение для Android и iOS | 2026"
  description="Как скачать 1xBet в Казахстане: APK для Android, инструкция для iPhone. Рабочая ссылка 2026."
  schema={schema}
  publishDate={publishDate}
  updateDate={updateDate}
>
  <Breadcrumbs items={[
    { label: 'Главная', href: '/' },
    { label: 'Приложение' },
  ]} />

  <article class="pb-16 lg:pb-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-gray-900 leading-tight mb-6">
        Приложение 1xBet — скачать APK для Android
      </h1>
    </div>

    <ArticleMeta publishDate={publishDate} updateDate={updateDate} />

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="aspect-[16/9] bg-gray-100 border border-gray-200 rounded-xl flex items-center justify-center mb-10">
        <div class="text-center">
          <svg class="w-16 h-16 mx-auto text-main-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="5" y="2" width="14" height="20" rx="2" />
            <line x1="12" y1="18" x2="12" y2="18.01" stroke-width="2" stroke-linecap="round" />
          </svg>
          <p class="text-sm text-gray-400 mt-2">Мобильное приложение</p>
        </div>
      </div>

      <p class="text-gray-600 text-lg leading-relaxed mb-4">
        Приложение — это, пожалуй, самый надёжный способ пользоваться платформой в Казахстане. Браузерная версия периодически блокируется операторами, а APK работает стабильно, обходя большинство ограничений. Скажу честно: скачивание не самое интуитивное — в Google Play его нет, и придётся устанавливать вручную.
      </p>

      <p class="text-gray-600 leading-relaxed mb-10">
        Тестировал на Samsung Galaxy A54 с мобильным 4G от Kcell. Файл весит около сорока мегабайт, устанавливается за минуту. После установки можно <a href="/sozdat-akkaunt" class="text-main-500 hover:text-main-600">создать аккаунт</a> прямо в приложении или войти в существующий.
      </p>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Скачать на Android (APK)</h2>

      <div class="space-y-4 mb-12">
        <div class="flex items-start gap-4 bg-gray-50 border border-gray-200 rounded-xl p-5">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-main-500 text-white text-sm font-semibold shrink-0">1</span>
          <div>
            <p class="font-medium text-gray-900 mb-1">Откройте сайт через мобильный браузер</p>
            <p class="text-sm text-gray-500">Зайдите на главную страницу и найдите раздел «Мобильные приложения» в меню. Если основной домен заблокирован — используйте актуальное зеркало.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 bg-gray-50 border border-gray-200 rounded-xl p-5">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-main-500 text-white text-sm font-semibold shrink-0">2</span>
          <div>
            <p class="font-medium text-gray-900 mb-1">Разрешите установку из неизвестных источников</p>
            <p class="text-sm text-gray-500">Настройки → Безопасность → Разрешить установку из неизвестных источников для вашего браузера. Без этого Android не даст установить APK-файл. Звучит пугающе, но это стандартная процедура.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 bg-gray-50 border border-gray-200 rounded-xl p-5">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-main-500 text-white text-sm font-semibold shrink-0">3</span>
          <div>
            <p class="font-medium text-gray-900 mb-1">Скачайте и установите файл</p>
            <p class="text-sm text-gray-500">Нажмите кнопку скачивания, дождитесь загрузки (~40 МБ) и запустите установку из уведомлений. Весь процесс занимает около минуты.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 bg-gray-50 border border-gray-200 rounded-xl p-5">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-main-500 text-white text-sm font-semibold shrink-0">4</span>
          <div>
            <p class="font-medium text-gray-900 mb-1">Войдите или создайте аккаунт</p>
            <p class="text-sm text-gray-500">Откройте приложение, введите логин и пароль. Если ещё нет аккаунта — регистрация доступна прямо из приложения за пару минут.</p>
          </div>
        </div>
      </div>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Установка на iOS</h2>

      <p class="text-gray-600 leading-relaxed mb-4">
        С iPhone всё проще и сложнее одновременно. Приложение есть в App Store, но найти его напрямую через поиск бывает непросто — казахстанский стор периодически убирает букмекерские программы. Рекомендую переходить по ссылке с сайта: она ведёт прямо на страницу скачивания. Процесс стандартный — нажали «Загрузить», подтвердили Face ID или пароль, готово.
      </p>

      <p class="text-gray-600 leading-relaxed mb-12">
        Если в казахстанском App Store приложения нет — придётся временно сменить регион на другой (например, Узбекистан). Процедура не самая удобная, и я не уверен, что Apple не изменит правила в будущем. Но пока это работает.
      </p>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Плюсы и минусы приложения</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-12">
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
          <p class="text-sm font-semibold text-alt-500 uppercase tracking-wider mb-4">Достоинства</p>
          <ul class="space-y-2 text-sm text-gray-600">
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Обходит блокировки операторов</span></li>
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Лёгкий файл — около 40 МБ</span></li>
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Push-уведомления о результатах ставок</span></li>
            <li class="flex items-start gap-2"><span class="text-alt-500 mt-0.5 font-medium">+</span><span>Быстрый доступ к лайвам и казино</span></li>
          </ul>
        </div>
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm">
          <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Недостатки</p>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>Нет в Google Play — обновлять вручную</span></li>
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>Требует разрешения на установку из неизвестных источников</span></li>
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>На слабых телефонах казино-раздел подтормаживает</span></li>
            <li class="flex items-start gap-2"><span class="text-gray-400 mt-0.5 font-medium">−</span><span>iOS-версия может исчезнуть из App Store</span></li>
          </ul>
        </div>
      </div>

      <h2 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-6">Системные требования</h2>

      <div class="overflow-x-auto mb-12">
        <table class="w-full bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Параметр</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">Android</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-gray-900">iOS</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr>
              <td class="px-6 py-4 text-sm text-gray-800 font-medium">Версия ОС</td>
              <td class="px-6 py-4 text-sm text-gray-600">Android 6.0+</td>
              <td class="px-6 py-4 text-sm text-gray-600">iOS 14.0+</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-800 font-medium">Размер</td>
              <td class="px-6 py-4 text-sm text-gray-600">~40 МБ</td>
              <td class="px-6 py-4 text-sm text-gray-600">~120 МБ</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-800 font-medium">RAM</td>
              <td class="px-6 py-4 text-sm text-gray-600">от 2 ГБ</td>
              <td class="px-6 py-4 text-sm text-gray-600">от 2 ГБ</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-800 font-medium">Источник</td>
              <td class="px-6 py-4 text-sm text-gray-600">APK с сайта</td>
              <td class="px-6 py-4 text-sm text-gray-600">App Store</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-gray-600 leading-relaxed mb-10">
        В целом приложение работает вполне сносно — для ставок и базового казино хватает. Но не ждите от него чудес: интерфейс местами перегружен, а обновления приходят только вручную. Если хотите разобраться с <a href="/lichnyy-kabinet" class="text-main-500 hover:text-main-600">личным кабинетом</a> — рекомендую делать это через десктоп, там всё нагляднее.
      </p>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-8 text-center">
        <p class="text-xl sm:text-2xl font-semibold text-gray-900 mb-4">Скачать и попробовать</p>
        <p class="text-sm text-gray-500 mb-6">Установка бесплатна. Минимальный депозит — 1 000 ₸ через Kaspi.</p>
        <CTAButton href={affiliateLink} variant="primary" size="lg" external>
          Перейти к скачиванию
        </CTAButton>
      </div>
    </div>
  </article>
</BaseLayout>
