---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Страница не найдена — 404"
  description="Запрашиваемая страница не найдена. Вернитесь на главную."
  noindex={true}
>
  <section class="py-24 lg:py-36">
    <div class="max-w-lg mx-auto px-4 sm:px-6 text-center">
      <div class="text-8xl sm:text-9xl font-extrabold text-main-100 select-none mb-2">404</div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-gray-900 mb-4">Страница не найдена</h1>
      <p class="text-gray-500 mb-8 leading-relaxed">
        К сожалению, запрашиваемая страница не существует или была перемещена.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center px-6 py-3 bg-main-500 text-white font-semibold text-sm rounded-lg hover:bg-main-600 transition-colors duration-200"
      >
        Вернуться на главную
      </a>
    </div>
  </section>
</BaseLayout>
