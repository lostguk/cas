---
const affiliateLink = "#"
---

<header class="sticky top-0 z-50 bg-base-950/95 backdrop-blur border-b border-white/10">
  <div class="container mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <svg class="w-10 h-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">
        <rect width="32" height="32" fill="#111318"/>
        <circle cx="16" cy="16" r="14" fill="#f59e0b"/>
        <circle cx="16" cy="16" r="10" fill="#111318"/>
        <text x="16" y="20" font-size="14" font-weight="bold" text-anchor="middle" fill="#f59e0b" font-family="sans-serif">P</text>
      </svg>
      <span class="text-xl font-bold text-white">PinUp Casino</span>
    </div>
    
    <nav class="hidden md:flex gap-8 text-sm font-medium">
      <a href="/" class="text-slate-300 hover:text-primary-400 transition">Главная</a>
      <a href="/registraciya" class="text-slate-300 hover:text-primary-400 transition">Регистрация</a>
      <a href="/bonus" class="text-slate-300 hover:text-primary-400 transition">Бонусы</a>
      <a href="/prilozhenie" class="text-slate-300 hover:text-primary-400 transition">Приложение</a>
    </nav>
    
    <a href={affiliateLink} class="btn-primary text-sm">
      Играть Сейчас
    </a>
  </div>
</header>
